#!/bin/sh /etc/rc.common
# DOANDUY Universal Auto-Mesh Procd Service (Chính 192.168.1.1 <-> Phụ 192.168.1.10)

USE_PROCD=1
START=99
STOP=10

start_service() {
	[ -x /usr/bin/auto_mesh ] || return 0
	procd_open_instance
	procd_set_param command /usr/bin/auto_mesh daemon
	procd_set_param respawn 3600 10 0
	procd_set_param stdout 0
	procd_set_param stderr 0
	procd_close_instance
}
