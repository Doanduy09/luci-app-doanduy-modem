#!/bin/sh /etc/rc.common
# [VERIFIED-GOLDEN: part3-watchdog-init-seq98 | 2026-11-26 | DO NOT MODIFY UNLESS TARGETED]

USE_PROCD=1
START=98
STOP=10

start_service() {
	[ -x /usr/bin/smart_modem_watchdog.sh ] || return 0
	procd_open_instance
	procd_set_param command /usr/bin/smart_modem_watchdog.sh
	procd_set_param respawn 3600 10 0
	procd_set_param stdout 0
	procd_set_param stderr 0
	procd_close_instance
}
# [/VERIFIED-GOLDEN]
