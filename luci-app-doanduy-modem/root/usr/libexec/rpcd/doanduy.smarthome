-- =============================================================================
-- ONLINE PROBONOPD/IRDB CATALOG
-- =============================================================================

local function ensure_irdb_index()
  local raw = read_file(IRDB_CACHE)
  if raw and #raw > 1000 then return raw end
  raw = http_fetch_raw("https://cdn.jsdelivr.net/gh/probonopd/irdb@master/codes/index", 6)
  if #raw > 1000 then
    write_atomic(IRDB_CACHE, raw, "644")
    return raw
  end
  return nil
end

local function is_valid_irdb_path(path)
  if type(path) ~= "string" or path == "" then return false end
  if path:find("%.%.", 1, true) then return false end
  return path:match("^[A-Za-z0-9_. ,/+%-]+%.csv$") ~= nil
end

local function fetch_irdb_csv_buttons(irdb_path)
  if not is_valid_irdb_path(irdb_path) then return nil, "invalid_irdb_path" end
  local url = "https://cdn.jsdelivr.net/gh/probonopd/irdb@master/codes/" .. url_encode(irdb_path)
  local csv = http_fetch_raw(url, 6)
  if csv == "" or not csv:find("functionname", 1, true) then return nil, "empty_or_invalid_csv" end

  local seen_sig = {}
  local all = {}
  for line in csv:gmatch("[^\r\n]+") do
    if not line:match("^functionname,") then
      local fname, proto, dev, sub, fn = line:match("^([^,]+),([^,]+),([%-]?%d+),([%-]?%d+),([%-]?%d+)")
      if fname and proto and ok_ac and ac_ir.supports_generic(proto) then
        local sig = proto .. ":" .. dev .. ":" .. sub .. ":" .. fn
        if not seen_sig[sig] then
          seen_sig[sig] = true
          all[#all + 1] = {
            id = "btn_" .. tostring(#all + 1),
            label = trim(fname),
            proto = trim(proto),
            dev = tonumber(dev),
            sub = tonumber(sub),
            fn = tonumber(fn),
          }
        end
      end
    end
  end
  if #all == 0 then return nil, "no_supported_protocol_buttons" end

  local prio_pats = {"power","standby","vol","mute","channel","ch%+","ch%-","input","source","menu","ok","select","enter","up","down","left","right","back","exit","play","pause","speed","swing","timer"}
  local chosen = {}
  local used = {}
  for _, pat in ipairs(prio_pats) do
    for idx, b in ipairs(all) do
      if not used[idx] and b.label:lower():find(pat) then
        used[idx] = true; chosen[#chosen + 1] = b
        if #chosen >= 24 then break end
      end
    end
    if #chosen >= 24 then break end
  end
  for idx, b in ipairs(all) do
    if #chosen >= 24 then break end
    if not used[idx] then chosen[#chosen + 1] = b end
  end
  for idx, b in ipairs(chosen) do
    local ll = b.label:lower()
    if ll:find("power") and not ll:find("off") then b.id = "power"
    elseif ll:find("vol.*%+") or ll == "vol+" then b.id = "vol_up"
    elseif ll:find("vol.*%-") or ll == "vol-" then b.id = "vol_down"
    elseif ll:find("mute") then b.id = "mute"
    else b.id = "k_" .. tostring(idx) end
  end
  return chosen
end

local function infer_irdb_category(cat_str)
  local c = (cat_str or ""):lower()
  if c:find("tv") or c:find("tele") or c:find("projector") then return "tv" end
  if c:find("fan") then return "fan" end
  if c:find("audio") or c:find("amp") or c:find("receiver") or c:find("sound") or c:find("speaker") or c:find("cd") then return "audio" end
  if c:find("air") or c:find("ac") then return "ac" end
  return "other"
end

-- =============================================================================
-- VOICE HUB SYNC & PUBLIC VIEW SANITIZER (Zero-Leak)
-- =============================================================================

local function sync_primary_cfg(patch)
  local cfg = load_s06_cfg()
  for k, v in pairs(patch) do cfg[k] = v end
  write_atomic(S06_CFG_FILE, cjson.encode(cfg), "600")
  if patch.ac_brand then
    http_get_json(HUB_HTTP .. "/s06/brand?brand=" .. url_encode(patch.ac_brand), 2)
  end
end

local function read_lan_tvs()
  local tvs = {}
  local raw = read_file(HUB_DEV_FILE)
  if raw and raw ~= "" then
    local ok, dec = pcall(cjson.decode, raw)
    if ok and type(dec) == "table" then
      for _, tv in ipairs(dec) do
        tvs[#tvs + 1] = { id = tv.id, name = tv.name, brand = tv.brand, ip = tv.ip }
      end
    end
  end
  return tvs
end

local function build_public_controllers(reg, cfg, lan_hosts, probe_primary)
  local kv = load_key_vault()
  local hub_st = probe_primary and http_get_json(HUB_HTTP .. "/s06/status?probe=1", 2) or nil
  local voice_st = probe_primary and http_get_json(HUB_HTTP .. "/status", 2) or nil
  local now_s = (type(voice_st) == "table" and tonumber(voice_st.now_s)) or os.time()
  if type(voice_st) == "table" and type(voice_st.esp32_clients) == "table" then
    local known_ips, known_macs = {}, {}
    for _, c in ipairs(reg.controllers or {}) do
      if c.ip and c.ip ~= "" then known_ips[c.ip] = true end
      if c.mac and c.mac ~= "" then known_macs[c.mac:lower()] = true end
    end
    local added = false
    for vip, _ in pairs(voice_st.esp32_clients) do
      local he = lan_hosts[vip]
      local vmac = (he and he.mac or ""):lower()
      if not known_ips[vip] and (vmac == "" or not known_macs[vmac]) then
        local suf = (vmac ~= "" and vmac:gsub(":", ""):sub(-6):upper()) or vip:match("%.(%d+)$") or "UDP"
        reg.controllers[#reg.controllers + 1] = {
          id = "esp32_" .. suf:lower(),
          kind = "esp32_voice",
          name = "Mạch Giọng Nói ESP32-C3 (" .. suf .. ")",
          room = "Phòng ngủ",
          ip = vip,
          mac = vmac,
          port = 8995,
        }
        known_ips[vip] = true
        if vmac ~= "" then known_macs[vmac] = true end
        added = true
      end
    end
    if added then save_registry(reg) end
  end
  local out = {}
  for _, c in ipairs(reg.controllers or {}) do
    local ip = c.ip or ""
    local mac = (c.mac or ""):lower()
    local h_entry = (ip ~= "" and lan_hosts[ip]) or nil
    if not h_entry and mac ~= "" then
      for hip, h in pairs(lan_hosts) do
        if (h.mac or ""):lower() == mac then ip = hip; h_entry = h; break end
      end
    elseif h_entry and mac ~= "" and (h_entry.mac or "") ~= "" and h_entry.mac:lower() ~= mac then
      for hip, h in pairs(lan_hosts) do
        if (h.mac or ""):lower() == mac then ip = hip; h_entry = h; break end
      end
    end
    local has_key = (kv[c.id] and #kv[c.id] == 16) or (c.id == "s06_default" and #(cfg.local_key or "") == 16)
    local item = {
      id = c.id,
      kind = c.kind or "tuya_ir",
      name = c.name or c.id,
      room = c.room or "Phòng khách",
      ip = ip,
      mac = mac,
      device_id = c.device_id or "",
      control_type = tonumber(c.control_type) or 1,
      has_key = has_key and true or false,
      online = (h_entry and h_entry.online) and true or false,
      live_ok = (h_entry and h_entry.online) and true or false,
      is_default = c.is_default and true or false,
    }
    if item.kind == "esp32_voice" then
      local vc = (type(voice_st) == "table" and type(voice_st.esp32_clients) == "table" and ip ~= "") and voice_st.esp32_clients[ip] or nil
      local ago = (vc and tonumber(vc.last_seen_s) and tonumber(vc.last_seen_s) > 0) and math.max(0, now_s - tonumber(vc.last_seen_s)) or nil
      local voice_active = (ago ~= nil and ago <= 180)
      item.voice_active = voice_active
      item.online = voice_active or item.online
      item.live_ok = item.online
      item.last_seen_ago_s = ago
      item.pings = vc and tonumber(vc.pings) or 0
      item.packets = vc and tonumber(vc.packets) or 0
      item.last_text = (vc and type(vc.last_text) == "string") and vc.last_text or ""
      if voice_active then
        item.status_label = "Đang hoạt động • Đang nghe"
      elseif item.online then
        item.status_label = "Đang hoạt động • Wi-Fi LAN OK"
      else
        item.status_label = "Ngắt kết nối / Tắt nguồn"
      end
    else
      if c.id == "s06_default" and type(hub_st) == "table" and hub_st.ip then
        item.ip = hub_st.ip
        item.live_ok = hub_st.live_ok and true or false
        item.online = item.live_ok or item.online
        item.ac_brand = hub_st.ac_brand
        if type(hub_st.dps) == "table" then
          local t = tonumber(hub_st.dps["101"] or hub_st.dps["1"])
          local hum = tonumber(hub_st.dps["102"] or hub_st.dps["2"])
          if t then item.temp_c = tonumber(string.format("%.1f", (t > 80) and (t / 10.0) or t)) end
          if hum then item.humidity = math.floor(hum) end
        end
      end
      item.status_label = item.live_ok and "Đang hoạt động • LAN OK" or (item.online and "Đã kết nối Wi-Fi" or "Ngắt kết nối")
    end
    out[#out + 1] = item
  end
  return out, (type(voice_st) == "table" or type(hub_st) == "table"), voice_st
end

-- =============================================================================
-- UNIVERSAL SMART DEVICE AUTO-DISCOVERY, FINGERPRINTING & UNLIMITED ACTIONS
-- =============================================================================

local PROBE_PORTS = { 80, 554, 5555, 6466, 6668, 8000, 8008, 8080, 8081, 8090, 8899, 8990, 55443 }

local ALLOWED_ACTION_KINDS = {
  http_get = true,
  http_post = true,
  tuya_dp = true,
  tcp_send = true,
  udp_send = true,
  open_url = true,
  ping = true,
}

local function decode_json_param(val)
  if type(val) == "table" then return val end
  if type(val) == "string" and val ~= "" then
    local ok, dec = pcall(cjson.decode, val)
    if ok and type(dec) == "table" then return dec end
  end
  return nil
end

local function sanitize_category(cat)
  local s = trim(cat):lower():gsub("[^a-z0-9_%-]", "")
  if s == "" then return "custom" end
  return s
end

local function infer_category_from_text(text, fallback)
  local t = (tostring(text or "")):lower()
  if t:find("alarm") or t:find("siren") or t:find("antitheft") or t:find("security") or t:find("trom") or t:find("chong") or t:find("coi") or t:find("pir") or t:find("motion") or t:find("sos") then
    return "security"
  elseif t:find("cam") or t:find("hikvision") or t:find("dahua") or t:find("ezviz") or t:find("imou") or t:find("tapo") or t:find("onvif") or t:find("nvr") or t:find("ipc") then
    return "camera"
  elseif t:find("light") or t:find("bulb") or t:find("lamp") or t:find("led") or t:find("wled") or t:find("yeelight") or t:find("den") or t:find("dimmer") then
    return "light"
  elseif t:find("plug") or t:find("socket") or t:find("outlet") or t:find("strip") or t:find("ocam") or t:find("relay") or t:find("switch") or t:find("congtac") then
    return "plug"
  elseif t:find("curtain") or t:find("blind") or t:find("shutter") or t:find("cover") or t:find("rem") or t:find("cuacuon") or t:find("cua_cuon") or t:find("gate") then
    return "curtain"
  elseif t:find("lock") or t:find("khoa") or t:find("door") then
    return "lock"
  elseif t:find("sensor") or t:find("temp") or t:find("hum") or t:find("smoke") or t:find("gas") or t:find("leak") then
    return "sensor"
  elseif t:find("pump") or t:find("bom") or t:find("valve") or t:find("water") or t:find("tuoi") then
    return "pump"
  elseif t:find("sound") or t:find("speaker") or t:find("bose") or t:find("jbl") or t:find("sonos") or t:find("audio") or t:find("loa") then
    return "audio"
  elseif t:find("fan") or t:find("quat") then
    return "fan"
  elseif t:find("tv") or t:find("tivi") or t:find("bravia") or t:find("aquos") or t:find("shield") then
    return "tv"
  end
  return fallback or "plug"
end

local function parse_action_dp_val(v)
  if type(v) == "boolean" or type(v) == "number" then return v end
  local s = trim(v)
  if s:lower() == "true" then return true end
  if s:lower() == "false" then return false end
  local n = tonumber(s)
  if n ~= nil then return n end
  return s
end

local function sanitize_action_item(a, idx)
  if type(a) ~= "table" then return nil end
  local kind = trim(a.kind or a.type):lower()
  if kind == "http" then
    local m = trim(a.method):upper()
    kind = (m == "POST") and "http_post" or "http_get"
  end
  if not ALLOWED_ACTION_KINDS[kind] then return nil end
  local label = trim(a.label):sub(1, 64)
  if label == "" then return nil end
  local aid = trim(a.id):gsub("[^a-zA-Z0-9_%-]", "")
  if aid == "" then aid = "act_" .. tostring(os.time()) .. "_" .. tostring(idx or 1) end
  local item = {
    id = aid,
    label = label,
    icon = trim(a.icon):sub(1, 8),
    kind = kind,
    style = trim(a.style):sub(1, 24),
  }
  if kind == "http_get" or kind == "http_post" or kind == "open_url" then
    local u = trim(a.url)
    if not is_lan_http_url(u) then return nil end
    item.url = u
    if kind == "http_post" then
      item.body = tostring(a.body or ""):sub(1, 2048)
    end
  elseif kind == "tuya_dp" then
    local dp = trim(a.dp):gsub("[^a-zA-Z0-9_%-]", "")
    if dp == "" then dp = "1" end
    item.dp = dp
    item.dp_val = parse_action_dp_val(a.dp_val)
  elseif kind == "tcp_send" or kind == "udp_send" then
    local tip = trim(a.ip)
    local tport = tonumber(a.port)
    if not is_private_lan_ip(tip, false) or not tport or tport < 1 or tport > 65535 then return nil end
    item.ip = tip
    item.port = math.floor(tport)
    item.payload = tostring(a.payload or ""):sub(1, 1024)
  end
  return item
end

local function sanitize_actions(raw_actions)
  local out = {}
  if type(raw_actions) ~= "table" then return out end
  for idx, a in ipairs(raw_actions) do
    local s = sanitize_action_item(a, idx)
    if s then out[#out + 1] = s end
  end
  return out
end

local function build_default_actions_for_category(cat, ip, http_port)
  local base = "http://" .. ip .. ((http_port and http_port ~= 80) and (":" .. tostring(http_port)) or "")
  if cat == "security" then
    return {
      { id = "arm",    label = "Bật Chống Trộm", icon = "🛡️", kind = "http_get", url = base .. "/arm", style = "success" },
      { id = "disarm", label = "Tắt Báo Động",   icon = "🔓", kind = "http_get", url = base .. "/disarm", style = "neutral" },
      { id = "sos",    label = "Hú Còi SOS",     icon = "🚨", kind = "http_get", url = base .. "/sos", style = "danger" },
      { id = "ping",   label = "Kiểm Tra Online", icon = "🩺", kind = "ping", style = "info" },
    }
  elseif cat == "curtain" then
    return {
      { id = "open",  label = "Mở Ra",    icon = "🪟", kind = "http_get", url = base .. "/open", style = "success" },
      { id = "stop",  label = "Dừng Lại", icon = "⏸️", kind = "http_get", url = base .. "/stop", style = "neutral" },
      { id = "close", label = "Đóng Lại", icon = "🔒", kind = "http_get", url = base .. "/close", style = "danger" },
    }
  elseif cat == "lock" then
    return {
      { id = "unlock", label = "Mở Khóa", icon = "🔓", kind = "http_get", url = base .. "/unlock", style = "success" },
      { id = "lock",   label = "Khóa Lại", icon = "🔐", kind = "http_get", url = base .. "/lock", style = "danger" },
      { id = "ping",   label = "Kiểm Tra", icon = "🩺", kind = "ping", style = "info" },
    }
  elseif cat == "camera" then
    return {
      { id = "web",  label = "Mở Trang Camera", icon = "🌐", kind = "open_url", url = base .. "/", style = "info" },
      { id = "ping", label = "Kiểm Tra Online", icon = "🩺", kind = "ping", style = "success" },
    }
  elseif cat == "sensor" then
    return {
      { id = "ping", label = "Đọc / Kiểm Tra Online", icon = "🩺", kind = "ping", style = "info" },
      { id = "web",  label = "Mở Trang Cảm Biến",     icon = "🌐", kind = "open_url", url = base .. "/", style = "neutral" },
    }
  end
  return {
    { id = "on",   label = "Bật", icon = "⚡", kind = "http_get", url = base .. "/on", style = "success" },
    { id = "off",  label = "Tắt", icon = "🛑", kind = "http_get", url = base .. "/off", style = "danger" },
    { id = "ping", label = "Kiểm Tra Online", icon = "🩺", kind = "ping", style = "info" },
  }
end

local function is_ip_or_mac_registered(reg, ip, mac)
  local lm = (mac or ""):lower()
  for _, c in ipairs(reg.controllers or {}) do
    if (ip ~= "" and c.ip == ip) or (lm ~= "" and (c.mac or ""):lower() == lm) then
      return true, "controller", c.name
    end
  end
  for _, d in ipairs(reg.devices or {}) do
    if (ip ~= "" and d.ip == ip) or (lm ~= "" and (d.mac or ""):lower() == lm) then
      return true, "device", d.name
    end
  end
  return false, nil, nil
end

local function fingerprint_ip(ip, hint_port, open_ports_set, lan_hosts, lan_tvs, voice_st, tuya_udp_map, reg)
  local host_entry = lan_hosts[ip] or {}
  local hname = trim(host_entry.name)
  local hmac = trim(host_entry.mac):lower()
  local online = (host_entry.online == true)
  local ports_list = {}
  local pset = open_ports_set or {}
  for p, is_open in pairs(pset) do
    if is_open then
      ports_list[#ports_list + 1] = p
      online = true
    end
  end
  table.sort(ports_list)
  local already, reg_kind, reg_name = is_ip_or_mac_registered(reg, ip, hmac)

  local profile = {
    ip = ip,
    mac = hmac,
    hostname = hname,
    online = online,
    open_ports = ports_list,
    already_added = already,
    registered_kind = reg_kind or "",
    registered_name = reg_name or "",
    target_type = "device",
    confidence = "generic",
    brand = "LAN / Tùy biến",
    suggested_room = "Phòng khách",
    needs_fields = {},
    capabilities = { "actions", "ping" },
    meta = { web_url = "http://" .. ip .. ((hint_port and hint_port ~= 80) and (":" .. tostring(hint_port)) or "") .. "/" },
  }

  -- 1. ESP32 Voice Puck
  local vc = (type(voice_st) == "table" and type(voice_st.esp32_clients) == "table") and voice_st.esp32_clients[ip] or nil
  if is_esp32_host(host_entry) or vc ~= nil then
    local suf = (hmac ~= "" and hmac:gsub(":", ""):sub(-6):upper()) or ip:match("%.(%d+)$") or "ESP32"
    profile.target_type = "controller"
    profile.confidence = "high"
    profile.detected_kind = "Mạch Giọng Nói ESP32-C3 (" .. suf .. ")"
    profile.suggested_driver = "esp32_voice"
    profile.suggested_category = "other"
    profile.suggested_name = (hname ~= "") and ("Mạch Giọng Nói " .. hname) or ("Mạch Giọng Nói ESP32-C3 (" .. suf .. ")")
    profile.suggested_room = "Phòng ngủ"
    profile.brand = "DOANDUY ESP32-C3"
    profile.what_it_can_do = "Thu âm & ra lệnh giọng nói trực tiếp cho Voice Hub OpenWrt qua UDP 8995 (điều khiển TV, máy lạnh, đèn, quạt bằng tiếng Việt)."
    profile.capabilities = { "voice_mic", "udp_8995" }
    profile.suggested_actions = {}
    return profile
  end

  -- 2. Android TV / DuyTV LAN
  local matched_tv = nil
  for _, tv in ipairs(lan_tvs or {}) do
    if tv.ip == ip then matched_tv = tv; break end
  end
  if matched_tv or pset[8990] or (pset[5555] and pset[6466]) or hname:lower():find("shield") or hname:lower():find("aquos") or hname:lower():find("bravia") then
    profile.confidence = "high"
    profile.detected_kind = matched_tv and ("Android TV — " .. matched_tv.name) or "Android TV / Google TV (LAN)"
    profile.suggested_driver = "android_tv"
    profile.suggested_category = "tv"
    profile.suggested_name = matched_tv and matched_tv.name or ((hname ~= "") and hname or ("Android TV (" .. ip .. ")"))
    profile.brand = (matched_tv and matched_tv.brand) or "Android TV"
    profile.what_it_can_do = "Mở YouTube, mở DuyTV, chỉnh âm lượng +/-, điều hướng Home/Back, bật hoặc đưa TV về chế độ ngủ ngay từ giao diện Router & Giọng nói."
    profile.capabilities = { "tv_remote", "voice_cmd" }
    profile.meta.tv_id = matched_tv and matched_tv.id or ("tv_" .. ip:gsub("%.", "_"))
    profile.suggested_actions = {}
    return profile
  end

  -- 3. Known Controller S06 Pro (by registry/cfg IP or MAC)
  for _, c in ipairs(reg.controllers or {}) do
    if c.kind == "tuya_ir" and ((c.ip == ip) or (hmac ~= "" and (c.mac or ""):lower() == hmac)) then
      profile.target_type = "controller"
      profile.confidence = "high"
      profile.detected_kind = "Cục Hồng Ngoại Tuya S06 Pro"
      profile.suggested_driver = "tuya_ir"
      profile.suggested_category = "ac"
      profile.suggested_name = c.name or "Cục Hồng Ngoại S06 Pro"
      profile.suggested_room = c.room or "Phòng ngủ"
      profile.brand = "Tuya S06 IR"
      profile.meta.device_id = c.device_id or ""
      profile.what_it_can_do = "Cục phát hồng ngoại trung tâm: điều khiển máy lạnh 11 hãng không cần học remote, TV, Quạt, Loa Soundbar & đọc nhiệt độ/độ ẩm phòng."
      profile.capabilities = { "ir_tx", "ir_learn", "temp_humidity" }
      profile.suggested_actions = {}
      return profile
    end
  end

  -- 4. Google Cast / Smart Soundbar / Speaker (port 8008 / 8090)
  if pset[8008] or pset[8090] then
    local info = pset[8008] and http_get_json("http://" .. ip .. ":8008/setup/eureka_info", 2) or nil
    local cast_name = (type(info) == "table" and trim(info.name or info.ssid)) or hname
    local inf_cat = infer_category_from_text(cast_name .. " " .. hname, "audio")
    profile.confidence = "high"
    profile.detected_kind = (inf_cat == "tv") and "Thiết bị TV / Google Cast" or "Loa / Soundbar Thông Minh LAN"
    profile.suggested_driver = "smart_actions"
    profile.suggested_category = inf_cat
    profile.suggested_name = (cast_name ~= "") and cast_name or ("Loa / Cast (" .. ip .. ")")
    profile.brand = (cast_name:lower():find("bose")) and "Bose" or "Google Cast / Audio"
    profile.what_it_can_do = "Theo dõi trạng thái trực tuyến của loa/Soundbar, mở nhanh cổng cấu hình nội bộ và gắn thêm nút điều khiển HTTP/TCP hoặc hồng ngoại tùy ý."
    profile.capabilities = { "actions", "ping" }
    local web_p = pset[80] and 80 or (pset[8090] and 8090 or 8008)
    profile.meta.web_url = "http://" .. ip .. ((web_p ~= 80) and (":" .. tostring(web_p)) or "") .. "/"
    profile.suggested_actions = {
      { id = "ping", label = "Kiểm Tra Kết Nối", icon = "🩺", kind = "ping", style = "info" },
      { id = "web",  label = "Mở Giao Diện Thiết Bị", icon = "🌐", kind = "open_url", url = profile.meta.web_url, style = "neutral" },
    }
    return profile
  end

  -- 4b. Fast-path IP Camera when RTSP 554 / ONVIF 8899 is open (skip 4 redundant HTTP probes)
  if pset[554] or pset[8899] or (pset[8000] and infer_category_from_text(hname, "other") == "camera") then
    profile.confidence = "high"
    profile.detected_kind = "Camera An Ninh IP (RTSP/ONVIF)"
    profile.suggested_driver = "camera_lan"
    profile.suggested_category = "camera"
    profile.suggested_name = (hname ~= "" and hname or ("Camera An Ninh (" .. ip .. ")"))
    profile.brand = "Camera IP / ONVIF"
    profile.meta.web_url = "http://" .. ip .. "/"
    profile.meta.rtsp_url = "rtsp://" .. ip .. ":554/"
    profile.what_it_can_do = "Mở nhanh giao diện xem Camera trên LAN, sao chép link luồng RTSP, kiểm tra Camera đang bật hay mất kết nối và gắn thêm nút bật còi/PTZ."
    profile.capabilities = { "web_ui", "rtsp", "ping", "actions" }
    profile.suggested_actions = build_default_actions_for_category("camera", ip, 80)
    return profile
  end

  -- 5. Active HTTP Probes (hint_port, 80, 8080, 8081)
  local http_ports = {}
  local seen_hp = {}
  local function add_hp(p) if p and not seen_hp[p] then seen_hp[p] = true; http_ports[#http_ports + 1] = p end end
  if hint_port and hint_port ~= 554 and hint_port ~= 55443 and hint_port ~= 6668 and hint_port ~= 8081 then add_hp(hint_port) end
  if pset[80] then add_hp(80) end
  if pset[8080] then add_hp(8080) end
  if pset[8000] then add_hp(8000) end

  for _, hp in ipairs(http_ports) do
    local base = "http://" .. ip .. ((hp ~= 80) and (":" .. tostring(hp)) or "")
    -- 5a. WLED
    local wled = http_get_json(base .. "/json/info", 2)
    if type(wled) == "table" and wled.ver and type(wled.leds) == "table" then
      local wname = trim(wled.name)
      profile.confidence = "high"
      profile.detected_kind = "Đèn LED Thông Minh WLED"
      profile.suggested_driver = "wled"
      profile.suggested_category = "light"
      profile.suggested_name = (wname ~= "") and wname or ("Đèn WLED (" .. ip .. ")")
      profile.brand = "WLED v" .. tostring(wled.ver)
      profile.meta.port = hp
      profile.meta.led_count = tonumber(wled.leds.count) or 0
      profile.meta.web_url = base .. "/"
      profile.what_it_can_do = "Bật/Tắt đèn ngay lập tức, kéo thanh chỉnh độ sáng 1–100%, mở trang hiệu ứng RGBW trực tiếp trên WLED."
      profile.capabilities = { "power", "brightness" }
      profile.suggested_actions = {
        { id = "web", label = "Mở Trang WLED", icon = "🎨", kind = "open_url", url = base .. "/", style = "info" },
      }
      return profile
    end

    -- 5b. Shelly Gen1 / Gen2 / Gen3
    local sh = http_get_json(base .. "/shelly", 2)
    if type(sh) == "table" and sh.mac and (sh.gen ~= nil or sh.type ~= nil or sh.model ~= nil) then
      local gen = tonumber(sh.gen) or 1
      local model = trim(sh.model or sh.type or "Shelly")
      local sname = trim(sh.name or model)
      local inf_cat = infer_category_from_text(model .. " " .. sname .. " " .. hname, "plug")
      if model:upper():find("DIMMER") or model:upper():find("BULB") or model:upper():find("RGBW") then inf_cat = "light"
      elseif model:upper():find("PLUG") then inf_cat = "plug"
      elseif model:upper():find("2PM") or model:upper():find("2%.5") then inf_cat = infer_category_from_text(sname .. " " .. hname, "plug") end
      profile.confidence = "high"
      profile.detected_kind = "Thiết bị Shelly Gen" .. tostring(gen) .. " (" .. model .. ")"
      profile.suggested_driver = "shelly"
      profile.suggested_category = inf_cat
      profile.suggested_name = (sname ~= "") and ("Shelly " .. sname) or ("Shelly " .. model)
      profile.brand = "Shelly Gen" .. tostring(gen)
      profile.meta.port = hp
      profile.meta.shelly_gen = gen
      profile.meta.model = model
      profile.meta.web_url = base .. "/"
      profile.what_it_can_do = "Bật/Tắt tải qua mạng LAN không cần đám mây (Shelly RPC Gen" .. tostring(gen) .. "), phản hồi trạng thái tức thì và mở giao diện cấu hình."
      profile.capabilities = (inf_cat == "light" and model:upper():find("DIMMER")) and { "power", "brightness" } or { "power" }
      profile.suggested_actions = {
        { id = "web", label = "Mở Trang Shelly", icon = "🌐", kind = "open_url", url = base .. "/", style = "info" },
      }
      return profile
    end

    -- 5c. Tasmota
    local tsm = http_get_json(base .. "/cm?cmnd=Status%200", 2)
    if type(tsm) == "table" and type(tsm.Status) == "table" and (tsm.StatusSTS ~= nil or tsm.StatusNET ~= nil) then
      local fname = (type(tsm.Status.FriendlyName) == "table" and trim(tsm.Status.FriendlyName[1])) or trim(tsm.Status.DeviceName)
      local ch_cnt = 1
      local sts = type(tsm.StatusSTS) == "table" and tsm.StatusSTS or {}
      for ch = 2, 4 do
        if sts["POWER" .. tostring(ch)] ~= nil then ch_cnt = ch end
      end
      local has_dim = (sts.Dimmer ~= nil)
      local inf_cat = infer_category_from_text((fname or "") .. " " .. hname, has_dim and "light" or "plug")
      profile.confidence = "high"
      profile.detected_kind = "Thiết bị Tasmota (" .. tostring(ch_cnt) .. " kênh)"
      profile.suggested_driver = "tasmota"
      profile.suggested_category = inf_cat
      profile.suggested_name = (fname ~= "") and fname or ("Tasmota (" .. ip .. ")")
      profile.brand = "Tasmota Wi-Fi"
      profile.meta.port = hp
      profile.meta.channels = ch_cnt
      profile.meta.has_dimmer = has_dim
      profile.meta.web_url = base .. "/"
      profile.what_it_can_do = (inf_cat == "security")
        and "Bật/Tắt hệ thống bảo vệ hoặc hú còi báo động qua Tasmota LAN + tùy chỉnh kịch bản lệnh bất kỳ."
        or ("Bật/Tắt " .. tostring(ch_cnt) .. " kênh công tắc qua LAN nội bộ" .. (has_dim and ", kéo thanh độ sáng 1–100%" or "") .. ", mở giao diện Tasmota.")
      profile.capabilities = has_dim and { "power", "brightness" } or { "power" }
      local acts = {
        { id = "web", label = "Mở Trang Tasmota", icon = "🌐", kind = "open_url", url = base .. "/", style = "info" },
      }
      if ch_cnt > 1 then
        for ch = 1, ch_cnt do
          acts[#acts + 1] = {
            id = "ch" .. tostring(ch) .. "_toggle",
            label = "Đảo Kênh " .. tostring(ch),
            icon = "🔁",
            kind = "http_get",
            url = base .. "/cm?cmnd=Power" .. tostring(ch) .. "%20Toggle",
            style = "neutral",
          }
        end
      end
      profile.suggested_actions = acts
      return profile
    end

    -- 5d. Generic HTTP body (ESPHome, Alarm/Anti-Theft, Camera Web, Generic IoT Web)
    local root_html = http_request_lan("GET", base .. "/", nil, 2, 4096)
    if root_html ~= "" then
      local low_html = root_html:lower()
      local title = trim(root_html:match("<title[^>]*>([^<]+)</title>") or "")
      local hint_txt = title .. " " .. hname .. " " .. low_html:sub(1, 2048)
      local inf_cat = infer_category_from_text(hint_txt, "custom")

      if low_html:find("esphome", 1, true) then
        profile.confidence = "high"
        profile.detected_kind = "Thiết bị ESPHome LAN"
        profile.suggested_driver = "smart_actions"
        profile.suggested_category = (inf_cat ~= "custom") and inf_cat or "sensor"
        profile.suggested_name = (title ~= "" and title or (hname ~= "" and hname or ("ESPHome (" .. ip .. ")")))
        profile.brand = "ESPHome"
        profile.meta.port = hp
        profile.meta.web_url = base .. "/"
        profile.what_it_can_do = "Kết nối trực tiếp giao diện ESPHome nội bộ, kiểm tra hoạt động và gắn thêm nút điều khiển HTTP POST/GET tùy ý (đèn, rơ-le, cảm biến, chống trộm)."
        profile.suggested_actions = build_default_actions_for_category(profile.suggested_category, ip, hp)
        return profile
      elseif inf_cat == "security" then
        profile.confidence = "medium"
        profile.detected_kind = "Thiết bị Chống Trộm / Báo Động LAN"
        profile.suggested_driver = "smart_actions"
        profile.suggested_category = "security"
        profile.suggested_name = (title ~= "" and title or (hname ~= "" and hname or ("Chống Trộm (" .. ip .. ")")))
        profile.brand = "An Ninh / Báo Động LAN"
        profile.meta.port = hp
        profile.meta.web_url = base .. "/"
        profile.what_it_can_do = "Bật bảo vệ (Arm), Tắt báo động (Disarm), kích hoạt hú còi khẩn cấp (SOS) và theo dõi trực tuyến thiết bị chống trộm."
        profile.capabilities = { "arm", "disarm", "sos", "ping" }
        profile.suggested_actions = build_default_actions_for_category("security", ip, hp)
        return profile
      elseif pset[554] or pset[8000] or pset[8899] or inf_cat == "camera" then
        profile.confidence = "high"
        profile.detected_kind = "Camera An Ninh IP (LAN)"
        profile.suggested_driver = "camera_lan"
        profile.suggested_category = "camera"
        profile.suggested_name = (title ~= "" and title or (hname ~= "" and hname or ("Camera IP (" .. ip .. ")")))
        profile.brand = "Camera IP / ONVIF"
        profile.meta.port = hp
        profile.meta.web_url = base .. "/"
        profile.meta.rtsp_url = "rtsp://" .. ip .. ":554/"
        profile.what_it_can_do = "Mở nhanh giao diện xem Camera trên LAN, sao chép link luồng RTSP, kiểm tra Camera đang bật hay mất kết nối và gắn thêm nút bật còi/PTZ."
        profile.capabilities = { "web_ui", "rtsp", "ping", "actions" }
        profile.suggested_actions = build_default_actions_for_category("camera", ip, hp)
        return profile
      else
        profile.confidence = "medium"
        profile.detected_kind = (title ~= "") and ("Thiết bị Web LAN: " .. title:sub(1, 36)) or "Thiết bị Web / IoT LAN (Cổng HTTP " .. tostring(hp) .. ")"
        profile.suggested_driver = "smart_actions"
        profile.suggested_category = inf_cat
        profile.suggested_name = (title ~= "" and title:sub(1, 48)) or ((hname ~= "" and hname or ("Thiết bị IoT (" .. ip .. ")")))
        profile.brand = "HTTP / IoT LAN"
        profile.meta.port = hp
        profile.meta.web_url = base .. "/"
        profile.what_it_can_do = "Tạo thẻ điều khiển không giới hạn nút lệnh (Bật/Tắt/HTTP/TCP/Mở trang Web). Bạn có thể chọn loại thiết bị bất kỳ và đổi đường dẫn lệnh theo ý muốn."
        profile.suggested_actions = build_default_actions_for_category(inf_cat, ip, hp)
        return profile
      end
    end
  end

  -- 5e. Sonoff DIY (port 8081)
  if pset[8081] then
    local sres = http_request_lan("POST", "http://" .. ip .. ":8081/zeroconf/info", '{"deviceid":"","data":{}}', 2, 8192)
    if sres and sres:find('"error":0', 1, true) then
      profile.confidence = "high"
      profile.detected_kind = "Công Tắc / Ổ Cắm Sonoff DIY (Port 8081)"
      profile.suggested_driver = "sonoff_diy"
      profile.suggested_category = infer_category_from_text(hname, "plug")
      profile.suggested_name = (hname ~= "" and hname or ("Sonoff DIY (" .. ip .. ")"))
      profile.brand = "Sonoff DIY"
      profile.meta.port = 8081
      profile.what_it_can_do = "Bật/Tắt tức thì qua giao thức Sonoff DIY cục bộ trên cổng 8081 không cần Internet."
      profile.capabilities = { "power" }
      profile.suggested_actions = {}
      return profile
    end
  end

  -- 6. Yeelight Wi-Fi Bulb/Light (port 55443)
  if pset[55443] then
    local yres = tcp_send_recv(ip, 55443, '{"id":1,"method":"get_prop","params":["power","bright","name"]}\r\n', 600)
    profile.confidence = (yres and yres:find("result", 1, true)) and "high" or "medium"
    profile.detected_kind = "Đèn Thông Minh Yeelight Wi-Fi"
    profile.suggested_driver = "yeelight"
    profile.suggested_category = "light"
    profile.suggested_name = (hname ~= "" and hname or ("Đèn Yeelight (" .. ip .. ")"))
    profile.brand = "Yeelight"
    profile.meta.port = 55443
    profile.what_it_can_do = "Bật/Tắt đèn tức thì và kéo thanh chỉnh độ sáng 1–100% trực tiếp qua TCP cổng 55443."
    profile.capabilities = { "power", "brightness" }
    profile.suggested_actions = {}
    return profile
  end

  -- 7. Camera by RTSP/ONVIF Port or Hostname (even when port 80 is closed)
  local cam_hint = infer_category_from_text(hname, "other")
  if pset[554] or pset[8000] or pset[8899] or cam_hint == "camera" then
    profile.confidence = pset[554] and "high" or "medium"
    profile.detected_kind = "Camera An Ninh IP (RTSP/ONVIF)"
    profile.suggested_driver = "camera_lan"
    profile.suggested_category = "camera"
    profile.suggested_name = (hname ~= "" and hname or ("Camera An Ninh (" .. ip .. ")"))
    profile.brand = "Camera IP"
    profile.meta.rtsp_url = "rtsp://" .. ip .. ":554/"
    profile.what_it_can_do = "Giám sát trạng thái trực tuyến Camera trên mạng nhà, mở Web quản trị Camera và sao chép nhanh địa chỉ luồng RTSP."
    profile.capabilities = { "web_ui", "rtsp", "ping", "actions" }
    profile.suggested_actions = build_default_actions_for_category("camera", ip, 80)
    return profile
  end

  -- 8. Tuya Local (TCP 6668, UDP 6666/6667, or lwip hostname)
  local tudp = tuya_udp_map and tuya_udp_map[ip] or nil
  if pset[6668] or tudp or hname:lower():find("^lwip") then
    local tuya_cat = infer_category_from_text(hname, "plug")
    if tuya_cat == "other" then tuya_cat = "plug" end
    profile.confidence = (pset[6668] or tudp) and "high" or "medium"
    profile.detected_kind = "Thiết bị Tuya Smart LAN (Port 6668 / v3.5)"
    profile.suggested_driver = "tuya_switch"
    profile.suggested_category = tuya_cat
    profile.suggested_name = (hname ~= "" and not hname:lower():find("^lwip")) and hname or ("Thiết bị Tuya (" .. ip .. ")")
    profile.brand = "Tuya Wi-Fi Local"
    profile.needs_fields = { "device_id", "local_key", "dp" }
    profile.meta.tuya_device_id = (tudp and tudp.gwId) or ""
    profile.meta.tuya_version = (tudp and tudp.version) or "3.5"
    profile.what_it_can_do = "Điều khiển trực tiếp thiết bị Tuya (Đèn, Ổ cắm, Công tắc nhiều nút, Báo động, Rèm...) qua LAN siêu nhanh; chỉ cần điền Device ID & Local Key 16 ký tự (hoặc chuyển sang Cục S06 nếu là bộ phát hồng ngoại)."
    profile.capabilities = { "power", "tuya_dp", "actions" }
    profile.suggested_actions = {}
    return profile
  end

  -- 9. Universal Fallback (ANY IP — Unlimited Categories & Custom Actions)
  local fallback_cat = infer_category_from_text(hname, "custom")
  profile.confidence = "generic"
  profile.detected_kind = "Thiết bị Thông Minh / Tự Định Nghĩa (Không Giới Hạn)"
  profile.suggested_driver = "smart_actions"
  profile.suggested_category = fallback_cat
  profile.suggested_name = (hname ~= "" and hname or ("Thiết bị Thông Minh (" .. ip .. ")"))
  profile.brand = "LAN / Tùy biến vô hạn"
  profile.what_it_can_do = "Chưa có chữ ký tự động riêng — bạn vẫn có thể chọn BẤT KỲ loại nào (Đèn, Ổ cắm, Chống trộm, Cảm biến, Rèm, Khóa, hoặc Tự đặt tên mới) và gắn vô hạn nút lệnh HTTP / Tuya DP / TCP / UDP ngay lập tức."
  profile.suggested_actions = build_default_actions_for_category(fallback_cat, ip, hint_port or 80)
  return profile
end

-- =============================================================================
-- RPCD DISPATCH
-- =============================================================================

local function read_stdin_json()
  local raw = io.read("*a") or ""
  if raw == "" then return {} end
  local ok, dec = pcall(cjson.decode, raw)
  return (ok and type(dec) == "table") and dec or {}
end

local function out_json(tbl)
  io.write(cjson.encode(tbl))
end

local cmd = arg[1]
if cmd == "list" then
  out_json({
    status = {},
    scanHubs = {},
    probeIp = { ip = "string" },
    scanLanSmartDevices = {},
    saveHubConfig = { ip = "string", mac = "string", device_id = "string", local_key = "string", control_type = 0 },
    saveController = { id = "string", kind = "string", name = "string", room = "string", ip = "string", mac = "string", device_id = "string", local_key = "string", control_type = 0 },
    removeController = { id = "string" },
    searchCatalog = { query = "string", category = "string", include_online = true },
    testCatalogItem = { catalog_id = "string", irdb_path = "string", controller_id = "string", dry_run = true },
    addDevice = {
      driver = "string", catalog_id = "string", irdb_path = "string", controller_id = "string",
      name = "string", room = "string", category = "string", category_label = "string",
      ip = "string", mac = "string", device_id = "string", local_key = "string", dp = "string",
      on_url = "string", off_url = "string", tv_id = "string",
      port = 0, shelly_gen = 0, channels = 0, web_url = "string", rtsp_url = "string",
      actions_json = "string", capabilities_json = "string", meta_json = "string",
    },
    removeDevice = { id = "string" },
    saveDeviceAction = {
      id = "string", action_id = "string", label = "string", icon = "string", kind = "string",
      url = "string", body = "string", ip = "string", port = 0, payload = "string",
      dp = "string", dp_val = "string", style = "string",
    },
    removeDeviceAction = { id = "string", action_id = "string" },
    controlDevice = { id = "string", op = "string", value = "string", button = "string", dry_run = true },
    learnButton = { id = "string", button = "string", label = "string" },
  })
  return
end

if cmd == "call" then
  local method = arg[2]
  local params = read_stdin_json()
  local cfg = load_s06_cfg()
  local lan_hosts = read_lan_hosts()
  local reg = load_registry(cfg, lan_hosts)

  if method == "status" then
    local ctrls, voice_ok, voice_st = build_public_controllers(reg, cfg, lan_hosts, true)
    local primary = ctrls[1] or {}
    local rooms_seen = {}
    local rooms = {}
    local function add_room(r)
      r = trim(r)
      if r ~= "" and not rooms_seen[r] then rooms_seen[r] = true; rooms[#rooms + 1] = r end
    end
    for _, c in ipairs(ctrls) do add_room(c.room) end
    for _, d in ipairs(reg.devices or {}) do add_room(d.room) end
    local vstats = (type(voice_st) == "table" and type(voice_st.stats) == "table") and voice_st.stats or {}
    local vhist = (type(voice_st) == "table" and type(voice_st.history) == "table") and voice_st.history or {}
    local voice_hub = {
      ok = (type(voice_st) == "table"),
      uptime_s = (type(voice_st) == "table" and tonumber(voice_st.uptime_s)) or 0,
      esp32_pings = tonumber(vstats.esp32_pings) or 0,
      esp32_packets = tonumber(vstats.esp32_packets) or 0,
      stt_ok = tonumber(vstats.stt_ok) or 0,
      executed = tonumber(vstats.executed) or 0,
      last_cmd = (#vhist > 0) and tostring(vhist[#vhist]) or "",
    }
    out_json({
      ok = true,
      hub = primary,
      controllers = ctrls,
      devices = reg.devices or {},
      lan_tvs = read_lan_tvs(),
      rooms = rooms,
      voice_hub_ok = voice_ok,
      voice_hub = voice_hub,
    })

  elseif method == "scanHubs" then
    if cfg.ip and cfg.ip ~= "" and not lan_hosts[cfg.ip] then
      lan_hosts[cfg.ip] = { ip = cfg.ip, mac = (cfg.mac or ""):lower(), name = "S06 Pro", online = true }
    end
    local tuya_devs, esp_nodes = {}, {}
    for ip, h in pairs(lan_hosts) do
      local hn = (h.name or ""):lower()
      if hn:find("esp32", 1, true) then
        esp_nodes[#esp_nodes + 1] = {
          ip = ip, mac = h.mac or "", name = h.name, kind = "esp32_voice",
          online = h.online and true or false,
        }
      elseif tcp_open(ip, 6668, 200) then
        tuya_devs[#tuya_devs + 1] = {
          ip = ip, mac = h.mac or "", kind = "tuya_ir",
          name = (h.name and h.name ~= "") and h.name or ("Tuya LAN (" .. ip .. ")"),
          is_current = (ip == cfg.ip),
        }
      end
    end
    out_json({
      ok = true,
      hubs = tuya_devs,
      tuya_devices = tuya_devs,
      esp32_nodes = esp_nodes,
      lan_tvs = read_lan_tvs(),
    })

  elseif method == "probeIp" then
    local target_ip, hint_port, _, perr = parse_and_validate_lan_target(params.ip)
    if not target_ip then
      out_json({ ok = false, message = perr })
      return
    end
    local targets = {}
    local seen_p = {}
    if hint_port then
      seen_p[hint_port] = true
      targets[#targets + 1] = { ip = target_ip, port = hint_port }
    end
    for _, p in ipairs(PROBE_PORTS) do
      if not seen_p[p] then
        seen_p[p] = true
        targets[#targets + 1] = { ip = target_ip, port = p }
      end
    end
    local open_map = tcp_probe_batch(targets, 650)
    local pset = open_map[target_ip] or {}
    local has_http = (pset[80] or pset[8080] or pset[8008] or (hint_port and pset[hint_port])) and true or false
    local tuya_udp = (not has_http and (pset[6668] or not next(pset))) and sniff_tuya_udp(450) or {}
    local lan_tvs = read_lan_tvs()
    local voice_st = http_get_json(HUB_HTTP .. "/status", 1)
    local profile = fingerprint_ip(target_ip, hint_port, pset, lan_hosts, lan_tvs, voice_st, tuya_udp, reg)
    out_json({ ok = true, profile = profile })

  elseif method == "scanLanSmartDevices" then
    local t0 = now_ms()
    local lan_tvs = read_lan_tvs()
    local voice_st = http_get_json(HUB_HTTP .. "/status", 1)
    local tuya_udp = sniff_tuya_udp(450)
    local cand_map, cand_ips = {}, {}
    local function add_cand(ip)
      if is_private_lan_ip(ip, false) and not cand_map[ip] then
        cand_map[ip] = true
        cand_ips[#cand_ips + 1] = ip
      end
    end
    for ip, h in pairs(lan_hosts) do
      if h.online or (h.name and h.name ~= "") or tuya_udp[ip] then add_cand(ip) end
    end
    for _, tv in ipairs(lan_tvs) do add_cand(tv.ip) end
    for _, c in ipairs(reg.controllers or {}) do add_cand(c.ip) end
    for ip, _ in pairs(tuya_udp) do add_cand(ip) end

    local scan_ports = { 80, 554, 5555, 6466, 6668, 8008, 8080, 8081, 8090, 8990, 55443 }
    local targets = {}
    for idx = 1, math.min(#cand_ips, 36) do
      local ip = cand_ips[idx]
      for _, p in ipairs(scan_ports) do
        targets[#targets + 1] = { ip = ip, port = p }
      end
    end
    local open_map = tcp_probe_batch(targets, 700)
    local profiles = {}
    local conf_rank = { high = 3, medium = 2, generic = 1 }
    for idx = 1, math.min(#cand_ips, 36) do
      local ip = cand_ips[idx]
      local h = lan_hosts[ip] or {}
      local pset = open_map[ip] or {}
      local hcat = infer_category_from_text(h.name or "", "none")
      local is_registered = is_ip_or_mac_registered(reg, ip, h.mac)
      if next(pset) or tuya_udp[ip] or is_esp32_host(h) or is_registered or hcat == "camera" or hcat == "security" then
        profiles[#profiles + 1] = fingerprint_ip(ip, nil, pset, lan_hosts, lan_tvs, voice_st, tuya_udp, reg)
      end
    end
    table.sort(profiles, function(a, b)
      local ra, rb = conf_rank[a.confidence] or 0, conf_rank[b.confidence] or 0
      if ra ~= rb then return ra > rb end
      if (a.online and not b.online) then return true end
      if (b.online and not a.online) then return false end
      return tostring(a.ip) < tostring(b.ip)
    end)
    out_json({
      ok = true,
      devices = profiles,
      total_lan_hosts = #cand_ips,
      scanned_ms = math.max(1, now_ms() - t0),
    })

  elseif method == "saveHubConfig" then
    local ip = trim(params.ip)
    local mac = trim(params.mac):lower()
    local did = trim(params.device_id)
    local lk = trim(params.local_key)
    local ct = tonumber(params.control_type)
    local patch = {}
    if ip:match("^%d+%.%d+%.%d+%.%d+$") then patch.ip = ip end
    if mac:match("^[%x:]+$") then patch.mac = mac end
    if did ~= "" then patch.device_id = did end
    if lk ~= "" then
      if #lk ~= 16 then out_json({ ok = false, message = "Local Key Tuya phải đủ đúng 16 ký tự" }); return end
      patch.local_key = lk
      set_entity_key("s06_default", lk)
    end
    if ct and (ct == 1 or ct == 2) then patch.control_type = ct end
    sync_primary_cfg(patch)
    local c0 = find_controller(reg, "s06_default")
    if c0 then
      if patch.ip then c0.ip = patch.ip end
      if patch.mac then c0.mac = patch.mac end
      if patch.device_id then c0.device_id = patch.device_id end
      if patch.control_type then c0.control_type = patch.control_type end
      save_registry(reg)
    end
    out_json({ ok = true, message = "Đã lưu cấu hình S06 Pro (chmod 600)" })

  elseif method == "saveController" then
    local cid = trim(params.id)
    local kind = trim(params.kind)
    if kind == "" then kind = "tuya_ir" end
    local name = trim(params.name)
    local room = trim(params.room)
    local ip = trim(params.ip)
    local mac = trim(params.mac):lower()
    local did = trim(params.device_id)
    local lk = trim(params.local_key)
    local ct = tonumber(params.control_type) or 1
    if lk ~= "" and #lk ~= 16 then
      out_json({ ok = false, message = "Local Key Tuya phải đủ đúng 16 ký tự" })
      return
    end
    if cid == "" then
      cid = ((kind == "esp32_voice") and "esp32_" or "s06_") .. tostring(os.time()) .. "_" .. tostring(#(reg.controllers or {}) + 1)
    end
    local existing = nil
    for _, c in ipairs(reg.controllers or {}) do if c.id == cid then existing = c; break end end
    if existing then
      if name ~= "" then existing.name = name end
      if room ~= "" then existing.room = room end
      if ip:match("^%d+%.%d+%.%d+%.%d+$") then existing.ip = ip end
      if mac ~= "" then existing.mac = mac end
      if did ~= "" then existing.device_id = did end
      existing.control_type = ct
    else
      if not ip:match("^%d+%.%d+%.%d+%.%d+$") then
        out_json({ ok = false, message = "Cần nhập địa chỉ IP LAN hợp lệ" })
        return
      end
      reg.controllers[#reg.controllers + 1] = {
        id = cid,
        kind = kind,
        name = (name ~= "") and name or ((kind == "esp32_voice") and "Mạch Giọng Nói ESP32" or "Cục Hồng Ngoại S06"),
        room = (room ~= "") and room or "Phòng khách",
        ip = ip,
        mac = mac,
        device_id = did,
        control_type = ct,
      }
    end
    if lk ~= "" then set_entity_key(cid, lk) end
    if cid == "s06_default" then
      local patch = {}
      if ip:match("^%d+%.%d+%.%d+%.%d+$") then patch.ip = ip end
      if mac ~= "" then patch.mac = mac end
      if did ~= "" then patch.device_id = did end
      if lk ~= "" then patch.local_key = lk end
      patch.control_type = ct
      sync_primary_cfg(patch)
    end
    save_registry(reg)
    local ctrls = build_public_controllers(reg, load_s06_cfg(), lan_hosts, false)
    out_json({ ok = true, message = "Đã lưu bộ điều khiển!", controllers = ctrls })

  elseif method == "removeController" then
    local cid = trim(params.id)
    if cid == "s06_default" then
      out_json({ ok = false, message = "Không thể xóa cục S06 Pro mặc định" })
      return
    end
    local kept, removed = {}, false
    for _, c in ipairs(reg.controllers or {}) do
      if c.id == cid then removed = true else kept[#kept + 1] = c end
    end
    reg.controllers = kept
    save_registry(reg)
    out_json({ ok = removed, message = removed and "Đã xóa bộ điều khiển" or "Không tìm thấy" })

  elseif method == "searchCatalog" then
    local q = trim(params.query or ""):lower()
    local cat_filter = trim(params.category or "all"):lower()
    local include_online = (params.include_online == true or cat_filter == "irdb")
    local tokens = {}
    for tok in q:gmatch("%S+") do tokens[#tokens + 1] = tok end

    local results = {}
    if cat_filter ~= "irdb" then
      for _, it in ipairs(BUILTIN_CATALOG) do
        if cat_filter == "all" or it.category == cat_filter then
          local match = true
          for _, tk in ipairs(tokens) do
            if not it.search:find(tk, 1, true) and not it.name:lower():find(tk, 1, true) then
              match = false; break
            end
          end
          if match then
            results[#results + 1] = {
              id = it.id, source = "builtin", category = it.category,
              driver = it.driver, type = it.type, brand = it.brand,
              name = it.name, subtitle = it.subtitle,
              button_count = it.buttons and #it.buttons or nil,
            }
          end
        end
      end
    end

    if include_online or (#tokens > 0 and #results < 5) then
      local idx = ensure_irdb_index()
      if idx then
        local online_cnt = 0
        for line in idx:gmatch("[^\r\n]+") do
          local low = line:lower()
          local match = true
          for _, tk in ipairs(tokens) do
            if not low:find(tk, 1, true) then match = false; break end
          end
          if match then
            local b_brand, b_cat, b_model = line:match("^([^/]+)/([^/]+)/(.+)%.csv$")
            if b_brand and b_cat then
              local inferred = infer_irdb_category(b_cat)
              if cat_filter == "all" or cat_filter == "irdb" or inferred == cat_filter then
                results[#results + 1] = {
                  id = "irdb:" .. line, irdb_path = line, source = "irdb",
                  category = inferred, driver = "tuya_ir_remote", type = "ir_remote",
                  brand = b_brand, name = b_brand .. " — " .. b_cat:gsub("_", " "),
                  subtitle = "Kho Online IRDB (" .. (b_model or "") .. ")",
                }
                online_cnt = online_cnt + 1
                if online_cnt >= 25 or #results >= 40 then break end
              end
            end
          end
        end
      end
    end
    out_json({ ok = true, results = results, online_cached = (read_file(IRDB_CACHE) ~= nil) })

  elseif method == "testCatalogItem" then
    local cid = trim(params.catalog_id)
    local ipath = trim(params.irdb_path)
    local ctrl_id = trim(params.controller_id)
    if ctrl_id == "" then ctrl_id = "s06_default" end
    local dry = (params.dry_run == true)
    local pkt, label_tested

    if cid ~= "" and BUILTIN_BY_ID[cid] then
      local item = BUILTIN_BY_ID[cid]
      if item.type == "ac" and ok_ac then
        pkt = ac_ir.encode(item.brand, { power = true, temp = 26, mode = "cool", fan = "auto", swing = false }, "on")
        label_tested = item.name .. " (Bật 26°C)"
      elseif item.buttons then
        for _, b in ipairs(item.buttons) do
          if b.proto and ok_ac and ac_ir.supports_generic(b.proto) then
            pkt = ac_ir.encode_generic(b.proto, b.dev, b.sub, b.fn)
            label_tested = item.name .. " — " .. b.label
            break
          end
        end
      end
    elseif ipath ~= "" then
      local btns, err = fetch_irdb_csv_buttons(ipath)
      if not btns then
        out_json({ ok = false, message = "Không tải được hoặc chưa hỗ trợ chuẩn IR file này: " .. tostring(err) })
        return
      end
      pkt = ac_ir.encode_generic(btns[1].proto, btns[1].dev, btns[1].sub, btns[1].fn)
      label_tested = ipath .. " — " .. btns[1].label
    end

    if not pkt then
      out_json({ ok = false, message = "Mẫu này dùng Học phím — hãy Thêm rồi bấm Học từng nút bằng remote thật!" })
      return
    end
    if dry then
      out_json({ ok = true, dry_run = true, tested = label_tested, protocol = pkt.protocol, head_len = #pkt.head, key_len = #pkt.key })
      return
    end
    local ctrl = find_controller(reg, ctrl_id)
    if not ctrl then out_json({ ok = false, message = "Không tìm thấy cục phát S06" }); return end
    local hip, hdid, hlkey, hct = heal_controller_ip(ctrl, lan_hosts, cfg)
    if not ok_tuya or #hlkey ~= 16 then
      out_json({ ok = false, message = "Cục phát [" .. ctrl.name .. "] chưa có Local Key 16 ký tự" })
      return
    end
    local ok, err = tuya_v35.send_head_key(hip, hdid, hlkey, pkt.head, pkt.key, hct)
    out_json({ ok = ok and true or false, message = ok and ("Đã bắn thử [" .. label_tested .. "] qua " .. ctrl.name .. "!") or ("Lỗi gửi: " .. tostring(err)) })

  elseif method == "addDevice" then
    local drv = trim(params.driver)
    local cid = trim(params.catalog_id)
    local ipath = trim(params.irdb_path)
    local ctrl_id = trim(params.controller_id)
    if ctrl_id == "" then ctrl_id = "s06_default" end
    local custom_name = trim(params.name)
    local room = trim(params.room)
    if room == "" then room = "Phòng khách" end
    local cat_slug = sanitize_category(params.category)
    local cat_label = trim(params.category_label):sub(1, 48)
    local raw_acts = decode_json_param(params.actions) or decode_json_param(params.actions_json)
    local clean_acts = sanitize_actions(raw_acts)
    local raw_caps = decode_json_param(params.capabilities) or decode_json_param(params.capabilities_json)
    local clean_caps = {}
    if type(raw_caps) == "table" then
      for _, c in ipairs(raw_caps) do
        local cs = trim(c):gsub("[^a-zA-Z0-9_%-]", "")
        if cs ~= "" then clean_caps[#clean_caps + 1] = cs end
      end
    end
    local raw_meta = decode_json_param(params.meta) or decode_json_param(params.meta_json) or {}
    local p_port = tonumber(params.port)
    if p_port and (p_port < 1 or p_port > 65535) then p_port = nil end
    local new_dev

    if drv == "tuya_switch" then
      local ip = trim(params.ip)
      local did = trim(params.device_id)
      local lk = trim(params.local_key)
      local dp = trim(params.dp)
      if dp == "" then dp = "1" end
      local cat = (params.category and trim(params.category) ~= "") and cat_slug or "light"
      if not is_private_lan_ip(ip, false) or did == "" or #lk ~= 16 then
        out_json({ ok = false, message = "Thiết bị Tuya Wi-Fi cần IP LAN hợp lệ, Device ID và Local Key đúng 16 ký tự!" })
        return
      end
      local uid = "tsw_" .. tostring(os.time()) .. "_" .. tostring(#(reg.devices or {}) + 1)
      set_entity_key(uid, lk)
      new_dev = {
        id = uid, driver = "tuya_switch", type = "switch",
        name = (custom_name ~= "") and custom_name or ("Công tắc Tuya (" .. ip .. ")"),
        room = room, category = cat, category_label = (cat_label ~= "" and cat_label or nil),
        brand = "Tuya Wi-Fi",
        ip = ip, mac = trim(params.mac):lower(), device_id = did, dp = dp,
        has_key = true, state = { on = false }, buttons = {}, actions = clean_acts,
      }
    elseif drv == "http_relay" then
      local on_url = trim(params.on_url)
      local off_url = trim(params.off_url)
      local cat = (params.category and trim(params.category) ~= "") and cat_slug or "light"
      if not is_lan_http_url(on_url) or (off_url ~= "" and not is_lan_http_url(off_url)) then
        out_json({ ok = false, message = "URL Relay chỉ chấp nhận địa chỉ mạng LAN nội bộ (http://192.168.x.x/... hoặc 10.x/172.16.x)" })
        return
      end
      local uid = "hrel_" .. tostring(os.time()) .. "_" .. tostring(#(reg.devices or {}) + 1)
      new_dev = {
        id = uid, driver = "http_relay", type = "switch",
        name = (custom_name ~= "") and custom_name or "Công tắc HTTP Relay LAN",
        room = room, category = cat, category_label = (cat_label ~= "" and cat_label or nil),
        brand = "HTTP / Tasmota / ESP32",
        on_url = on_url, off_url = (off_url ~= "") and off_url or on_url,
        state = { on = false }, buttons = {}, actions = clean_acts,
      }
    elseif drv == "tasmota" or drv == "shelly" or drv == "wled" or drv == "yeelight" or drv == "sonoff_diy" then
      local ip = trim(params.ip)
      if not is_private_lan_ip(ip, false) then
        out_json({ ok = false, message = "Cần nhập địa chỉ IP LAN hợp lệ (192.168.x.x / 10.x / 172.16-31.x)" })
        return
      end
      local default_ports = { tasmota = 80, shelly = 80, wled = 80, sonoff_diy = 8081, yeelight = 55443 }
      local use_port = (p_port and p_port > 0) and math.floor(p_port) or default_ports[drv]
      local cat = (params.category and trim(params.category) ~= "") and cat_slug or ((drv == "wled" or drv == "yeelight") and "light" or "plug")
      local def_caps = (#clean_caps > 0) and clean_caps or (((drv == "wled" or drv == "yeelight") and { "power", "brightness" }) or { "power" })
      local brand_map = { tasmota = "Tasmota Wi-Fi", shelly = "Shelly LAN", wled = "WLED", yeelight = "Yeelight", sonoff_diy = "Sonoff DIY" }
      local uid = drv .. "_" .. tostring(os.time()) .. "_" .. tostring(#(reg.devices or {}) + 1)
      new_dev = {
        id = uid, driver = drv, type = "switch",
        name = (custom_name ~= "") and custom_name or (brand_map[drv] .. " (" .. ip .. ")"),
        room = room, category = cat, category_label = (cat_label ~= "" and cat_label or nil),
        brand = brand_map[drv],
        ip = ip, mac = trim(params.mac):lower(), port = use_port,
        shelly_gen = (drv == "shelly") and (tonumber(params.shelly_gen) or tonumber(raw_meta.shelly_gen) or 1) or nil,
        channels = tonumber(params.channels) or tonumber(raw_meta.channels) or 1,
        web_url = is_lan_http_url(trim(params.web_url)) and trim(params.web_url) or (is_lan_http_url(raw_meta.web_url) and raw_meta.web_url or nil),
        capabilities = def_caps,
        state = { on = false, brightness = 100 },
        buttons = {},
        actions = clean_acts,
      }
    elseif drv == "camera_lan" or drv == "smart_actions" then
      local ip = trim(params.ip)
      if ip ~= "" and not is_private_lan_ip(ip, false) then
        out_json({ ok = false, message = "IP LAN thiết bị không hợp lệ (đã chặn localhost/IP công cộng/Router)" })
        return
      end
      if ip == "" and #clean_acts == 0 then
        out_json({ ok = false, message = "Cần nhập IP LAN hoặc ít nhất 1 nút lệnh LAN hợp lệ" })
        return
      end
      local cat = (params.category and trim(params.category) ~= "") and cat_slug or ((drv == "camera_lan") and "camera" or "custom")
      if #clean_acts == 0 and ip ~= "" then
        clean_acts = build_default_actions_for_category(cat, ip, p_port or 80)
      end
      local web_u = trim(params.web_url)
      if web_u == "" and type(raw_meta.web_url) == "string" then web_u = raw_meta.web_url end
      if web_u ~= "" and not is_lan_http_url(web_u) then web_u = "" end
      if web_u == "" and ip ~= "" then web_u = "http://" .. ip .. ((p_port and p_port ~= 80) and (":" .. tostring(p_port)) or "") .. "/" end
      local rtsp_u = trim(params.rtsp_url)
      if rtsp_u == "" and type(raw_meta.rtsp_url) == "string" then rtsp_u = raw_meta.rtsp_url end
      if rtsp_u == "" and drv == "camera_lan" and ip ~= "" then rtsp_u = "rtsp://" .. ip .. ":554/" end
      local uid = ((drv == "camera_lan") and "cam_" or "smart_") .. tostring(os.time()) .. "_" .. tostring(#(reg.devices or {}) + 1)
      new_dev = {
        id = uid, driver = drv, type = drv,
        name = (custom_name ~= "") and custom_name or ((drv == "camera_lan") and ("Camera IP (" .. ip .. ")") or ("Thiết bị (" .. (ip ~= "" and ip or "LAN") .. ")")),
        room = room, category = cat, category_label = (cat_label ~= "" and cat_label or nil),
        brand = (drv == "camera_lan") and "Camera IP LAN" or "Thiết Bị Thông Minh LAN",
        ip = ip, mac = trim(params.mac):lower(), port = p_port,
        web_url = (web_u ~= "") and web_u or nil,
        rtsp_url = (rtsp_u ~= "") and rtsp_u or nil,
        capabilities = (#clean_caps > 0) and clean_caps or ((drv == "camera_lan") and { "web_ui", "rtsp", "ping", "actions" } or { "actions", "ping" }),
        state = (cat == "security") and { alarm_mode = "disarmed", on = false } or { on = false },
        buttons = {},
        actions = clean_acts,
      }
    elseif drv == "android_tv" then
      local tv_id = trim(params.tv_id)
      local ip = trim(params.ip)
      local tv_found = nil
      for _, t in ipairs(read_lan_tvs()) do
        if (tv_id ~= "" and t.id == tv_id) or (ip ~= "" and t.ip == ip) then tv_found = t; break end
      end
      if not tv_found then
        if not is_private_lan_ip(ip, false) then
          out_json({ ok = false, message = "Không tìm thấy TV LAN id: " .. tv_id })
          return
        end
        tv_found = { id = (tv_id ~= "") and tv_id or ("tv_" .. ip:gsub("%.", "_")), name = (custom_name ~= "") and custom_name or ("Android TV (" .. ip .. ")"), brand = "Android TV", ip = ip }
      end
      local uid = "atv_" .. tv_found.id
      for _, d in ipairs(reg.devices or {}) do
        if d.id == uid then out_json({ ok = false, message = tv_found.name .. " đã có sẵn trong danh sách!" }); return end
      end
      new_dev = {
        id = uid, driver = "android_tv", type = "android_tv",
        name = (custom_name ~= "") and custom_name or tv_found.name,
        room = room, category = "tv", brand = tv_found.brand or "Android TV",
        ip = tv_found.ip, tv_id = tv_found.id, buttons = {}, actions = clean_acts,
      }
    elseif cid ~= "" and BUILTIN_BY_ID[cid] then
      local it = BUILTIN_BY_ID[cid]
      local did = cid .. "_" .. tostring(os.time()) .. "_" .. tostring(#(reg.devices or {}) + 1)
      if it.type == "ac" then
        new_dev = {
          id = did, driver = "tuya_ir_ac", type = "ac", controller_id = ctrl_id,
          name = (custom_name ~= "") and custom_name or it.name,
          room = room, category = "ac", brand = it.brand,
          brand_label = ok_ac and ac_ir.get_brand_info(it.brand).label or it.brand,
          source = "builtin",
          state = { power = false, temp = 26, mode = "cool", fan = "auto", swing = false },
          buttons = {},
        }
        if ctrl_id == "s06_default" then sync_primary_cfg({ ac_brand = it.brand }) end
      else
        local btns = {}
        for _, b in ipairs(it.buttons or {}) do
          btns[#btns + 1] = { id = b.id, label = b.label, proto = b.proto, dev = b.dev, sub = b.sub, fn = b.fn }
        end
        new_dev = {
          id = did, driver = it.driver or "tuya_ir_remote", type = it.type, controller_id = ctrl_id,
          name = (custom_name ~= "") and custom_name or it.name,
          room = room, category = it.category, brand = it.brand,
          source = "builtin", buttons = btns,
        }
      end
    elseif ipath ~= "" then
      local btns, err = fetch_irdb_csv_buttons(ipath)
      if not btns then
        out_json({ ok = false, message = "Không thêm được từ IRDB: " .. tostring(err) })
        return
      end
      local b_brand, b_cat = ipath:match("^([^/]+)/([^/]+)/")
      local did = "irdb_" .. tostring(os.time()) .. "_" .. tostring(#(reg.devices or {}) + 1)
      new_dev = {
        id = did, driver = "tuya_ir_remote", type = "ir_remote", controller_id = ctrl_id,
        name = (custom_name ~= "") and custom_name or ((b_brand or "IR") .. " " .. (b_cat or "Remote"):gsub("_", " ")),
        room = room, category = infer_irdb_category(b_cat),
        brand = b_brand or "IRDB", source = "irdb", irdb_path = ipath, buttons = btns,
      }
    else
      out_json({ ok = false, message = "Thiếu thông tin thiết bị cần thêm" })
      return
    end

    reg.devices[#reg.devices + 1] = new_dev
    save_registry(reg)
    out_json({ ok = true, message = "Đã thêm: " .. new_dev.name, device = new_dev, devices = reg.devices })

  elseif method == "removeDevice" then
    local did = trim(params.id)
    local kept, removed = {}, false
    for _, d in ipairs(reg.devices or {}) do
      if d.id == did then removed = true else kept[#kept + 1] = d end
    end
    reg.devices = kept
    save_registry(reg)
    local kv = load_key_vault()
    if kv[did] then kv[did] = nil; save_key_vault(kv) end
    out_json({ ok = removed, message = removed and "Đã xóa thiết bị" or "Không tìm thấy thiết bị", devices = kept })

  elseif method == "saveDeviceAction" then
    local did = trim(params.id)
    local target = nil
    for _, d in ipairs(reg.devices or {}) do if d.id == did then target = d; break end end
    if not target then out_json({ ok = false, message = "Không tìm thấy thiết bị" }); return end
    local act_tbl = {
      id = trim(params.action_id),
      label = trim(params.label),
      icon = trim(params.icon),
      kind = trim(params.kind),
      url = trim(params.url),
      body = params.body,
      ip = (trim(params.ip) ~= "") and trim(params.ip) or (target.ip or ""),
      port = tonumber(params.port) or 0,
      payload = params.payload,
      dp = trim(params.dp),
      dp_val = params.dp_val,
      style = trim(params.style),
    }
    target.actions = target.actions or {}
    local clean = sanitize_action_item(act_tbl, #target.actions + 1)
    if not clean then
      out_json({ ok = false, message = "Lệnh không hợp lệ (cần tên nút, URL LAN hoặc IP/Port LAN hợp lệ)" })
      return
    end
    local updated = false
    for i, a in ipairs(target.actions) do
      if a.id == clean.id then target.actions[i] = clean; updated = true; break end
    end
    if not updated then target.actions[#target.actions + 1] = clean end
    save_registry(reg)
    out_json({ ok = true, message = "Đã lưu nút lệnh [" .. clean.label .. "]", device = target })

  elseif method == "removeDeviceAction" then
    local did = trim(params.id)
    local aid = trim(params.action_id)
    local target = nil
    for _, d in ipairs(reg.devices or {}) do if d.id == did then target = d; break end end
    if not target then out_json({ ok = false, message = "Không tìm thấy thiết bị" }); return end
    local kept, removed = {}, false
    for _, a in ipairs(target.actions or {}) do
      if a.id == aid then removed = true else kept[#kept + 1] = a end
    end
    target.actions = kept
    save_registry(reg)
    out_json({ ok = removed, message = removed and "Đã xóa nút lệnh" or "Không tìm thấy nút lệnh", device = target })

  elseif method == "controlDevice" then
    local did = trim(params.id)
    local op = trim(params.op)
    local val = trim(params.value)
    local btn_id = trim(params.button)
    local dry = (params.dry_run == true)

    local target = nil
    for _, d in ipairs(reg.devices or {}) do if d.id == did then target = d; break end end
    if not target then out_json({ ok = false, message = "Không tìm thấy thiết bị" }); return end
    local drv = target.driver or ((target.type == "ac") and "tuya_ir_ac" or "tuya_ir_remote")

    local function check_device_online(dev_ip)
      local t0 = now_ms()
      if not is_private_lan_ip(dev_ip, false) then return false, 0 end
      local plist = { 80, 554, 6668, 8008, 8080, 8081, 8990, 55443 }
      if dev_ip == target.ip and target.port and tonumber(target.port) then
        table.insert(plist, 1, tonumber(target.port))
      end
      local tgts = {}
      for _, p in ipairs(plist) do tgts[#tgts + 1] = { ip = dev_ip, port = p } end
      local om = tcp_probe_batch(tgts, 550)
      local is_up = (om[dev_ip] and next(om[dev_ip]) ~= nil) or (lan_hosts[dev_ip] and lan_hosts[dev_ip].online == true)
      return is_up and true or false, math.max(1, now_ms() - t0)
    end

    local function execute_custom_action(act)
      if not act then return false, "Không tìm thấy nút lệnh" end
      if act.kind == "ping" then
        local pip = (act.ip and act.ip ~= "") and act.ip or (target.ip or "")
        if dry then return true, target.name .. " → Đang hoạt động (Dry-Run)" end
        local up, ms = check_device_online(pip)
        target.state = target.state or {}
        target.state.online = up
        save_registry(reg)
        return true, up and ("🟢 " .. target.name .. " đang TRỰC TUYẾN (" .. tostring(ms) .. "ms)") or ("🔴 " .. target.name .. " chưa phản hồi (" .. pip .. ")")
      elseif act.kind == "http_get" then
        if not is_lan_http_url(act.url) then return false, "URL LAN không hợp lệ" end
        if not dry then
          local _, herr = http_request_lan("GET", act.url, nil, 3, 16384)
          if herr then return false, herr end
        end
        return true, target.name .. " → Đã chạy [" .. act.label .. "]"
      elseif act.kind == "http_post" then
        if not is_lan_http_url(act.url) then return false, "URL LAN không hợp lệ" end
        if not dry then
          local _, herr = http_request_lan("POST", act.url, act.body or "", 3, 16384)
          if herr then return false, herr end
        end
        return true, target.name .. " → Đã gửi POST [" .. act.label .. "]"
      elseif act.kind == "tuya_dp" then
        local lkey = get_entity_key(target.id, cfg)
        if not dry and (not ok_tuya or #lkey ~= 16) then return false, "Thiết bị Tuya chưa đủ Local Key 16 ký tự" end
        if not dry then
          local ok_t, terr = tuya_v35.set_dps(target.ip, target.device_id, lkey, { [tostring(act.dp or "1")] = act.dp_val }, 3)
          if not ok_t then return false, "Lỗi Tuya: " .. tostring(terr) end
        end
        return true, target.name .. " → Đã kích hoạt [" .. act.label .. "]"
      elseif act.kind == "tcp_send" then
        if not dry then
          local _, terr = tcp_send_recv(act.ip, act.port, act.payload or "", 400)
          if terr then return false, "Lỗi TCP: " .. tostring(terr) end
        end
        return true, target.name .. " → Đã gửi TCP [" .. act.label .. "]"
      elseif act.kind == "udp_send" then
        if not dry then
          local ok_u, uerr = udp_send_once(act.ip, act.port, act.payload or "")
          if not ok_u then return false, "Lỗi UDP: " .. tostring(uerr) end
        end
        return true, target.name .. " → Đã gửi UDP [" .. act.label .. "]"
      elseif act.kind == "open_url" then
        return true, "Mở trang: " .. tostring(act.url)
      end
      return false, "Loại lệnh chưa hỗ trợ: " .. tostring(act.kind)
    end

    if op == "action" and btn_id ~= "" then
      local found_act = nil
      for _, a in ipairs(target.actions or {}) do if a.id == btn_id then found_act = a; break end end
      local ok_a, msg_a = execute_custom_action(found_act)
      if ok_a then
        target.state = target.state or {}
        if btn_id == "arm" then target.state.alarm_mode = "armed"; target.state.on = true
        elseif btn_id == "disarm" then target.state.alarm_mode = "disarmed"; target.state.on = false
        elseif btn_id == "sos" then target.state.alarm_mode = "sos"; target.state.on = true
        elseif btn_id == "on" then target.state.on = true
        elseif btn_id == "off" then target.state.on = false end
        save_registry(reg)
      end
      out_json({ ok = ok_a, dry_run = dry, device = target, message = msg_a })
      return
    end

    if drv == "tasmota" then
      local st = target.state or { on = false, brightness = 100 }
      local ch = (tonumber(btn_id) and tonumber(btn_id) >= 2) and tostring(math.floor(tonumber(btn_id))) or ""
      local base = "http://" .. target.ip .. ((target.port and tonumber(target.port) ~= 80) and (":" .. tostring(target.port)) or "")
      local msg_txt
      if op == "brightness" then
        local bri = math.min(100, math.max(1, math.floor(tonumber(val) or 100)))
        if not dry then http_request_lan("GET", base .. "/cm?cmnd=Dimmer%20" .. tostring(bri), nil, 3, 8192) end
        st.brightness = bri; st.on = true
        msg_txt = target.name .. " → Độ sáng " .. tostring(bri) .. "%"
      else
        local nxt = (op == "on") and true or ((op == "off") and false or (not st.on))
        local cm = nxt and ("Power" .. ch .. "%20On") or ("Power" .. ch .. "%20Off")
        if not dry then http_request_lan("GET", base .. "/cm?cmnd=" .. cm, nil, 3, 8192) end
        st.on = nxt
        msg_txt = target.name .. (nxt and " → ĐÃ BẬT" or " → ĐÃ TẮT")
      end
      target.state = st; save_registry(reg)
      out_json({ ok = true, dry_run = dry, device = target, message = msg_txt })

    elseif drv == "shelly" then
      local st = target.state or { on = false, brightness = 100 }
      local gen = tonumber(target.shelly_gen) or 1
      local ch = math.max(0, math.floor(tonumber(btn_id) or 0))
      local base = "http://" .. target.ip .. ((target.port and tonumber(target.port) ~= 80) and (":" .. tostring(target.port)) or "")
      local url, msg_txt
      if op == "brightness" then
        local bri = math.min(100, math.max(1, math.floor(tonumber(val) or 100)))
        url = (gen >= 2)
          and (base .. "/rpc/Light.Set?id=" .. tostring(ch) .. "&on=true&brightness=" .. tostring(bri))
          or (base .. "/light/" .. tostring(ch) .. "?turn=on&brightness=" .. tostring(bri))
        st.brightness = bri; st.on = true
        msg_txt = target.name .. " → Độ sáng " .. tostring(bri) .. "%"
      else
        local nxt = (op == "on") and true or ((op == "off") and false or (not st.on))
        url = (gen >= 2)
          and (base .. "/rpc/Switch.Set?id=" .. tostring(ch) .. "&on=" .. (nxt and "true" or "false"))
          or (base .. "/relay/" .. tostring(ch) .. "?turn=" .. (nxt and "on" or "off"))
        st.on = nxt
        msg_txt = target.name .. (nxt and " → ĐÃ BẬT" or " → ĐÃ TẮT")
      end
      if not dry then http_request_lan("GET", url, nil, 3, 8192) end
      target.state = st; save_registry(reg)
      out_json({ ok = true, dry_run = dry, device = target, message = msg_txt })

    elseif drv == "wled" then
      local st = target.state or { on = false, brightness = 100 }
      local base = "http://" .. target.ip .. ((target.port and tonumber(target.port) ~= 80) and (":" .. tostring(target.port)) or "")
      local payload_tbl, msg_txt
      if op == "brightness" then
        local pct = math.min(100, math.max(1, math.floor(tonumber(val) or 100)))
        local bri255 = math.max(1, math.floor(pct * 255 / 100))
        payload_tbl = { on = true, bri = bri255 }
        st.brightness = pct; st.on = true
        msg_txt = target.name .. " → Độ sáng " .. tostring(pct) .. "%"
      else
        local nxt = (op == "on") and true or ((op == "off") and false or (not st.on))
        payload_tbl = { on = nxt }
        st.on = nxt
        msg_txt = target.name .. (nxt and " → ĐÃ BẬT" or " → ĐÃ TẮT")
      end
      if not dry then http_request_lan("POST", base .. "/json/state", cjson.encode(payload_tbl), 3, 8192) end
      target.state = st; save_registry(reg)
      out_json({ ok = true, dry_run = dry, device = target, message = msg_txt })

    elseif drv == "yeelight" then
      local st = target.state or { on = false, brightness = 100 }
      local rpc_line, msg_txt
      if op == "brightness" then
        local pct = math.min(100, math.max(1, math.floor(tonumber(val) or 100)))
        rpc_line = string.format('{"id":1,"method":"set_bright","params":[%d,"smooth",300]}\r\n', pct)
        st.brightness = pct; st.on = true
        msg_txt = target.name .. " → Độ sáng " .. tostring(pct) .. "%"
      else
        local nxt = (op == "on") and true or ((op == "off") and false or (not st.on))
        rpc_line = string.format('{"id":1,"method":"set_power","params":["%s","smooth",300]}\r\n', nxt and "on" or "off")
        st.on = nxt
        msg_txt = target.name .. (nxt and " → ĐÃ BẬT" or " → ĐÃ TẮT")
      end
      local ok_y, yerr = true, nil
      if not dry then ok_y, yerr = tcp_send_recv(target.ip, target.port or 55443, rpc_line, 400) end
      if ok_y == nil then
        out_json({ ok = false, message = "Lỗi Yeelight: " .. tostring(yerr) .. " (Hãy bật LAN Control trong app Yeelight)" })
        return
      end
      target.state = st; save_registry(reg)
      out_json({ ok = true, dry_run = dry, device = target, message = msg_txt })

    elseif drv == "sonoff_diy" then
      local st = target.state or { on = false }
      local nxt = (op == "on") and true or ((op == "off") and false or (not st.on))
      local url = "http://" .. target.ip .. ":" .. tostring(target.port or 8081) .. "/zeroconf/switch"
      local body = string.format('{"deviceid":"","data":{"switch":"%s"}}', nxt and "on" or "off")
      if not dry then http_request_lan("POST", url, body, 3, 8192) end
      st.on = nxt; target.state = st; save_registry(reg)
      out_json({ ok = true, dry_run = dry, device = target, message = target.name .. (nxt and " → ĐÃ BẬT" or " → ĐÃ TẮT") })

    elseif drv == "camera_lan" or drv == "smart_actions" then
      local st = target.state or { on = false }
      if op == "ping" then
        if dry then
          out_json({ ok = true, dry_run = true, device = target, message = target.name .. " → Online (Dry-Run)" })
          return
        end
        local up, ms = check_device_online(target.ip or "")
        st.online = up; target.state = st; save_registry(reg)
        out_json({ ok = true, device = target, message = up and ("🟢 " .. target.name .. " đang TRỰC TUYẾN (" .. tostring(ms) .. "ms)") or ("🔴 " .. target.name .. " mất kết nối") })
        return
      end
      local want_id = (btn_id ~= "" and btn_id) or op
      local found_act = nil
      for _, a in ipairs(target.actions or {}) do if a.id == want_id then found_act = a; break end end
      if found_act then
        local ok_a, msg_a = execute_custom_action(found_act)
        if ok_a then
          if op == "arm" then st.alarm_mode = "armed"; st.on = true
          elseif op == "disarm" then st.alarm_mode = "disarmed"; st.on = false
          elseif op == "sos" then st.alarm_mode = "sos"; st.on = true
          elseif op == "on" then st.on = true
          elseif op == "off" then st.on = false end
          target.state = st; save_registry(reg)
        end
        out_json({ ok = ok_a, dry_run = dry, device = target, message = msg_a })
      elseif op == "arm" or op == "disarm" or op == "sos" or op == "on" or op == "off" then
        if op == "arm" then st.alarm_mode = "armed"; st.on = true
        elseif op == "disarm" then st.alarm_mode = "disarmed"; st.on = false
        elseif op == "sos" then st.alarm_mode = "sos"; st.on = true
        elseif op == "on" then st.on = true
        elseif op == "off" then st.on = false end
        target.state = st; save_registry(reg)
        out_json({ ok = true, dry_run = dry, device = target, message = target.name .. " → Đã chuyển trạng thái (chưa gắn URL lệnh riêng — bấm '➕ Thêm Lệnh' để gắn link/lệnh thật)" })
      else
        out_json({ ok = false, message = "Chưa có lệnh phù hợp cho thao tác [" .. tostring(want_id) .. "]" })
      end

    elseif drv == "tuya_switch" then
      local st = target.state or { on = false }
      local nxt = (op == "on") and true or ((op == "off") and false or (not st.on))
      local dp = tostring(target.dp or "1")
      local lkey = get_entity_key(target.id, cfg)
      if not dry and (not ok_tuya or #lkey ~= 16) then
        out_json({ ok = false, message = "Công tắc Tuya chưa đủ Local Key 16 ký tự" })
        return
      end
      local ok, err = true, nil
      if not dry then
        ok, err = tuya_v35.set_dps(target.ip, target.device_id, lkey, { [dp] = nxt }, 3)
      end
      if ok then st.on = nxt; target.state = st; save_registry(reg) end
      out_json({ ok = ok and true or false, dry_run = dry, device = target, message = ok and (target.name .. (nxt and " → ĐÃ BẬT" or " → ĐÃ TẮT")) or ("Lỗi Tuya Switch: " .. tostring(err)) })

    elseif drv == "http_relay" then
      local st = target.state or { on = false }
      local nxt = (op == "on") and true or ((op == "off") and false or (not st.on))
      local u = nxt and target.on_url or (target.off_url or target.on_url)
      if not is_lan_http_url(u) then out_json({ ok = false, message = "URL Relay LAN không hợp lệ" }); return end
      if not dry then
        http_fetch_raw(u, 3)
      end
      st.on = nxt; target.state = st; save_registry(reg)
      out_json({ ok = true, dry_run = dry, device = target, message = target.name .. (nxt and " → ĐÃ BẬT" or " → ĐÃ TẮT") })

    elseif drv == "android_tv" then
      local ok_call = false
      if dry then
        ok_call = true
      elseif op == "cmd" and val ~= "" then
        local r = http_get_json(HUB_HTTP .. "/command?text=" .. url_encode(val) .. "&device=" .. url_encode(target.tv_id or ""), 4)
        ok_call = (type(r) == "table" and r.status == "ok")
      elseif op == "key" and btn_id ~= "" then
        local r = http_get_json(HUB_HTTP .. "/remote_key?key=" .. url_encode(btn_id) .. "&device=" .. url_encode(target.tv_id or ""), 4)
        ok_call = (type(r) == "table" and r.status == "ok")
      end
      out_json({ ok = ok_call, dry_run = dry, device = target, message = ok_call and ("Đã gửi lệnh tới " .. target.name) or ("TV hoặc Voice Hub chưa phản hồi") })

    elseif drv == "tuya_ir_ac" and ok_ac then
      local ctrl = find_controller(reg, target.controller_id or "s06_default")
      local hip, hdid, hlkey, hct = heal_controller_ip(ctrl or { id="s06_default", ip=cfg.ip, mac=cfg.mac, device_id=cfg.device_id, control_type=cfg.control_type }, lan_hosts, cfg)
      if not dry and (not ok_tuya or #hlkey ~= 16) then
        out_json({ ok = false, message = "Cục S06 chưa có Local Key 16 ký tự" })
        return
      end
      local st = target.state or { power = false, temp = 26, mode = "cool", fan = "auto", swing = false }
      local prev_pwr = st.power and true or false
      local enc_op = "set"
      if op == "on" then st.power = true; enc_op = "on"
      elseif op == "off" then st.power = false; enc_op = "off"
      elseif op == "temp_up" then st.temp = math.min(30, (tonumber(st.temp) or 26) + 1); st.power = true
      elseif op == "temp_down" then st.temp = math.max(16, (tonumber(st.temp) or 26) - 1); st.power = true
      elseif op == "set_temp" then st.temp = math.min(30, math.max(16, tonumber(val) or 26)); st.power = true
      elseif op == "mode" and val ~= "" then st.mode = val; st.power = true
      elseif op == "fan" and val ~= "" then st.fan = val; st.power = true; enc_op = "fan"
      elseif op == "swing" then st.swing = not (st.swing and true or false); st.power = true; enc_op = "swing"
      elseif op == "next_variant" then
        target.brand = ac_ir.next_variant(target.brand)
        target.brand_label = ac_ir.get_brand_info(target.brand).label
        target.state = st
        save_registry(reg)
        if (target.controller_id or "s06_default") == "s06_default" then sync_primary_cfg({ ac_brand = target.brand }) end
        out_json({ ok = true, message = "Đã đổi mã sang: " .. target.brand_label, device = target })
        return
      end
      st.was_on = prev_pwr
      local pkt = ac_ir.encode(target.brand or "lg2", st, enc_op)
      if not pkt then out_json({ ok = false, message = "Lỗi mã hóa AC brand: " .. tostring(target.brand) }); return end
      local ok, err = true, nil
      if not dry then
        ok, err = tuya_v35.send_head_key(hip, hdid, hlkey, pkt.head, pkt.key, hct)
      end
      if ok then
        target.state = st
        save_registry(reg)
        if (target.controller_id or "s06_default") == "s06_default" then
          sync_primary_cfg({ ac_brand = target.brand, ac_temp = st.temp, ac_mode = st.mode, ac_fan = st.fan, ac_power = st.power, ac_swing = st.swing })
        end
      end
      out_json({
        ok = ok and true or false, dry_run = dry, protocol = pkt.protocol, head_len = #pkt.head, key_len = #pkt.key,
        message = ok and ("Đã gửi " .. target.name .. " (" .. tostring(st.temp) .. "°C • " .. tostring(st.mode) .. ")") or ("Lỗi S06: " .. tostring(err)),
        device = target,
      })

    else
      local ctrl = find_controller(reg, target.controller_id or "s06_default")
      local hip, hdid, hlkey, hct = heal_controller_ip(ctrl or { id="s06_default", ip=cfg.ip, mac=cfg.mac, device_id=cfg.device_id, control_type=cfg.control_type }, lan_hosts, cfg)
      if not dry and (not ok_tuya or #hlkey ~= 16) then
        out_json({ ok = false, message = "Cục S06 chưa có Local Key 16 ký tự" })
        return
      end
      local b_found = nil
      for _, b in ipairs(target.buttons or {}) do if b.id == btn_id then b_found = b; break end end
      if not b_found then out_json({ ok = false, message = "Không tìm thấy nút: " .. btn_id }); return end
      if b_found.base64 and b_found.base64 ~= "" then
        local ok, err = true, nil
        if not dry then ok, err = tuya_v35.send_ir(hip, hdid, hlkey, b_found.base64, hct) end
        out_json({ ok = ok and true or false, dry_run = dry, mode = "learned", message = ok and ("Đã bấm [" .. b_found.label .. "] (Mã đã học)") or ("Lỗi S06: " .. tostring(err)) })
      elseif b_found.proto and ok_ac and ac_ir.supports_generic(b_found.proto) then
        local pkt = ac_ir.encode_generic(b_found.proto, b_found.dev, b_found.sub, b_found.fn)
        if not pkt then out_json({ ok = false, message = "Lỗi encode " .. tostring(b_found.proto) }); return end
        local ok, err = true, nil
        if not dry then ok, err = tuya_v35.send_head_key(hip, hdid, hlkey, pkt.head, pkt.key, hct) end
        out_json({ ok = ok and true or false, dry_run = dry, mode = pkt.protocol, head_len = #pkt.head, key_len = #pkt.key, message = ok and ("Đã bấm [" .. b_found.label .. "] (" .. pkt.protocol .. ")") or ("Lỗi S06: " .. tostring(err)) })
      else
        out_json({ ok = false, need_learn = true, message = "Nút [" .. b_found.label .. "] chưa có mã IR — bật Chế độ Học Phím rồi bấm nút này!" })
      end
    end

  elseif method == "learnButton" then
    local did = trim(params.id)
    local btn_id = trim(params.button)
    local btn_label = trim(params.label)
    local target = nil
    for _, d in ipairs(reg.devices or {}) do if d.id == did then target = d; break end end
    if not target then out_json({ ok = false, message = "Không tìm thấy thiết bị" }); return end
    local ctrl = find_controller(reg, target.controller_id or "s06_default")
    local hip, hdid, hlkey, hct = heal_controller_ip(ctrl or { id="s06_default", ip=cfg.ip, mac=cfg.mac, device_id=cfg.device_id, control_type=cfg.control_type }, lan_hosts, cfg)
    if not ok_tuya or #hlkey ~= 16 then
      out_json({ ok = false, message = "Cục S06 chưa có Local Key 16 ký tự" })
      return
    end
    if btn_id == "" then btn_id = "custom_" .. tostring(os.time()) end
    local code = tuya_v35.learn_ir(hip, hdid, hlkey, 12, hct)
    if not code then
      out_json({ ok = false, message = "Hết 12s chưa nhận tín hiệu remote. Hãy chĩa sát vào S06 Pro và thử lại." })
      return
    end
    target.buttons = target.buttons or {}
    local updated = false
    for _, b in ipairs(target.buttons) do
      if b.id == btn_id then
        b.base64 = code
        if btn_label ~= "" then b.label = btn_label end
        updated = true; break
      end
    end
    if not updated then
      target.buttons[#target.buttons + 1] = { id = btn_id, label = (btn_label ~= "") and btn_label or btn_id, base64 = code }
    end
    save_registry(reg)
    if target.category == "fan" then
      local voice_map = { power = "fan_power", speed_up = "fan_speed_up", speed_down = "fan_speed_down", swing = "fan_swing", timer = "fan_timer" }
      local vk = voice_map[btn_id]
      if vk then
        local fresh = load_s06_cfg()
        fresh.ir_codes[vk] = code
        write_atomic(S06_CFG_FILE, cjson.encode(fresh), "600")
      end
    end
    out_json({ ok = true, message = "Đã học xong nút [" .. ((btn_label ~= "") and btn_label or btn_id) .. "]!", device = target })
  else
    out_json({ ok = false, message = "Unknown method: " .. tostring(method) })
  end
end
