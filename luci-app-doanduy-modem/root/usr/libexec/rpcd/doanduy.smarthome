for _, it in ipairs(BUILTIN_CATALOG) do BUILTIN_BY_ID[it.id] = it end

-- =============================================================================
-- ONLINE PROBONOPD/IRDB CATALOG
-- =============================================================================

local function ensure_irdb_index()
  local raw = read_file(IRDB_CACHE)
  if raw and #raw > 1000 then return raw end
  local p = io.popen("curl -4 -sSL --connect-timeout 3 -m 6 'https://cdn.jsdelivr.net/gh/probonopd/irdb@master/codes/index' 2>/dev/null")
  if not p then return nil end
  raw = p:read("*a") or ""
  p:close()
  if #raw > 1000 then
    write_atomic(IRDB_CACHE, raw, "644")
    return raw
  end
  return nil
end

local function is_valid_irdb_path(path)
  if type(path) ~= "string" or path == "" then return false end
  if path:find("%.%.", 1, true) then return false end
  return path:match("^[A-Za-z0-9_. ,/+%-]+%.csv$") ~= nil
end

local function fetch_irdb_csv_buttons(irdb_path)
  if not is_valid_irdb_path(irdb_path) then return nil, "invalid_irdb_path" end
  local url = "https://cdn.jsdelivr.net/gh/probonopd/irdb@master/codes/" .. url_encode(irdb_path)
  local p = io.popen(string.format("curl -4 -sSL --connect-timeout 3 -m 6 %s 2>/dev/null", sh_quote(url)))
  if not p then return nil, "curl_failed" end
  local csv = p:read("*a") or ""
  p:close()
  if csv == "" or not csv:find("functionname", 1, true) then return nil, "empty_or_invalid_csv" end

  local seen_sig = {}
  local all = {}
  for line in csv:gmatch("[^\r\n]+") do
    if not line:match("^functionname,") then
      local fname, proto, dev, sub, fn = line:match("^([^,]+),([^,]+),([%-]?%d+),([%-]?%d+),([%-]?%d+)")
      if fname and proto and ok_ac and ac_ir.supports_generic(proto) then
        local sig = proto .. ":" .. dev .. ":" .. sub .. ":" .. fn
        if not seen_sig[sig] then
          seen_sig[sig] = true
          all[#all + 1] = {
            id = "btn_" .. tostring(#all + 1),
            label = trim(fname),
            proto = trim(proto),
            dev = tonumber(dev),
            sub = tonumber(sub),
            fn = tonumber(fn),
          }
        end
      end
    end
  end
  if #all == 0 then return nil, "no_supported_protocol_buttons" end

  local prio_pats = {"power","standby","vol","mute","channel","ch%+","ch%-","input","source","menu","ok","select","enter","up","down","left","right","back","exit","play","pause","speed","swing","timer"}
  local chosen = {}
  local used = {}
  for _, pat in ipairs(prio_pats) do
    for idx, b in ipairs(all) do
      if not used[idx] and b.label:lower():find(pat) then
        used[idx] = true; chosen[#chosen + 1] = b
        if #chosen >= 24 then break end
      end
    end
    if #chosen >= 24 then break end
  end
  for idx, b in ipairs(all) do
    if #chosen >= 24 then break end
    if not used[idx] then chosen[#chosen + 1] = b end
  end
  for idx, b in ipairs(chosen) do
    local ll = b.label:lower()
    if ll:find("power") and not ll:find("off") then b.id = "power"
    elseif ll:find("vol.*%+") or ll == "vol+" then b.id = "vol_up"
    elseif ll:find("vol.*%-") or ll == "vol-" then b.id = "vol_down"
    elseif ll:find("mute") then b.id = "mute"
    else b.id = "k_" .. tostring(idx) end
  end
  return chosen
end

local function infer_irdb_category(cat_str)
  local c = (cat_str or ""):lower()
  if c:find("tv") or c:find("tele") or c:find("projector") then return "tv" end
  if c:find("fan") then return "fan" end
  if c:find("audio") or c:find("amp") or c:find("receiver") or c:find("sound") or c:find("speaker") or c:find("cd") then return "audio" end
  if c:find("air") or c:find("ac") then return "ac" end
  return "other"
end

-- =============================================================================
-- VOICE HUB SYNC & PUBLIC VIEW SANITIZER (Zero-Leak)
-- =============================================================================

local function sync_primary_cfg(patch)
  local cfg = load_s06_cfg()
  for k, v in pairs(patch) do cfg[k] = v end
  write_atomic(S06_CFG_FILE, cjson.encode(cfg), "600")
  if patch.ac_brand then
    http_get_json(HUB_HTTP .. "/s06/brand?brand=" .. url_encode(patch.ac_brand), 2)
  end
end

local function read_lan_tvs()
  local tvs = {}
  local raw = read_file(HUB_DEV_FILE)
  if raw and raw ~= "" then
    local ok, dec = pcall(cjson.decode, raw)
    if ok and type(dec) == "table" then
      for _, tv in ipairs(dec) do
        tvs[#tvs + 1] = { id = tv.id, name = tv.name, brand = tv.brand, ip = tv.ip }
      end
    end
  end
  return tvs
end

local function build_public_controllers(reg, cfg, lan_hosts, probe_primary)
  local kv = load_key_vault()
  local hub_st = probe_primary and http_get_json(HUB_HTTP .. "/s06/status?probe=1", 2) or nil
  local out = {}
  for _, c in ipairs(reg.controllers or {}) do
    local ip = c.ip or ""
    local mac = (c.mac or ""):lower()
    local h_entry = (ip ~= "" and lan_hosts[ip]) or nil
    if not h_entry and mac ~= "" then
      for hip, h in pairs(lan_hosts) do
        if (h.mac or ""):lower() == mac then ip = hip; h_entry = h; break end
      end
    end
    local has_key = (kv[c.id] and #kv[c.id] == 16) or (c.id == "s06_default" and #(cfg.local_key or "") == 16)
    local item = {
      id = c.id,
      kind = c.kind or "tuya_ir",
      name = c.name or c.id,
      room = c.room or "Phòng khách",
      ip = ip,
      mac = mac,
      device_id = c.device_id or "",
      control_type = tonumber(c.control_type) or 1,
      has_key = has_key and true or false,
      online = (h_entry and h_entry.online) and true or false,
      live_ok = (h_entry and h_entry.online) and true or false,
      is_default = c.is_default and true or false,
    }
    if c.id == "s06_default" and type(hub_st) == "table" and hub_st.ip then
      item.ip = hub_st.ip
      item.live_ok = hub_st.live_ok and true or false
      item.online = item.live_ok or item.online
      item.ac_brand = hub_st.ac_brand
      if type(hub_st.dps) == "table" then
        local t = tonumber(hub_st.dps["101"] or hub_st.dps["1"])
        local hum = tonumber(hub_st.dps["102"] or hub_st.dps["2"])
        if t then item.temp_c = tonumber(string.format("%.1f", (t > 80) and (t / 10.0) or t)) end
        if hum then item.humidity = math.floor(hum) end
      end
    end
    out[#out + 1] = item
  end
  return out, (type(hub_st) == "table")
end

-- =============================================================================
-- RPCD DISPATCH
-- =============================================================================

local function read_stdin_json()
  local raw = io.read("*a") or ""
  if raw == "" then return {} end
  local ok, dec = pcall(cjson.decode, raw)
  return (ok and type(dec) == "table") and dec or {}
end

local function out_json(tbl)
  io.write(cjson.encode(tbl))
end

local cmd = arg[1]
if cmd == "list" then
  out_json({
    status = {},
    scanHubs = {},
    saveHubConfig = { ip = "string", mac = "string", device_id = "string", local_key = "string", control_type = 0 },
    saveController = { id = "string", kind = "string", name = "string", room = "string", ip = "string", mac = "string", device_id = "string", local_key = "string", control_type = 0 },
    removeController = { id = "string" },
    searchCatalog = { query = "string", category = "string", include_online = true },
    testCatalogItem = { catalog_id = "string", irdb_path = "string", controller_id = "string", dry_run = true },
    addDevice = { driver = "string", catalog_id = "string", irdb_path = "string", controller_id = "string", name = "string", room = "string", category = "string", ip = "string", mac = "string", device_id = "string", local_key = "string", dp = "string", on_url = "string", off_url = "string", tv_id = "string" },
    removeDevice = { id = "string" },
    controlDevice = { id = "string", op = "string", value = "string", button = "string", dry_run = true },
    learnButton = { id = "string", button = "string", label = "string" },
  })
  return
end

if cmd == "call" then
  local method = arg[2]
  local params = read_stdin_json()
  local cfg = load_s06_cfg()
  local lan_hosts = read_lan_hosts()
  local reg = load_registry(cfg, lan_hosts)

  if method == "status" then
    local ctrls, voice_ok = build_public_controllers(reg, cfg, lan_hosts, true)
    local primary = ctrls[1] or {}
    local rooms_seen = {}
    local rooms = {}
    local function add_room(r)
      r = trim(r)
      if r ~= "" and not rooms_seen[r] then rooms_seen[r] = true; rooms[#rooms + 1] = r end
    end
    for _, c in ipairs(ctrls) do add_room(c.room) end
    for _, d in ipairs(reg.devices or {}) do add_room(d.room) end
    out_json({
      ok = true,
      hub = primary,
      controllers = ctrls,
      devices = reg.devices or {},
      lan_tvs = read_lan_tvs(),
      rooms = rooms,
      voice_hub_ok = voice_ok,
    })

  elseif method == "scanHubs" then
    if cfg.ip and cfg.ip ~= "" and not lan_hosts[cfg.ip] then
      lan_hosts[cfg.ip] = { ip = cfg.ip, mac = (cfg.mac or ""):lower(), name = "S06 Pro", online = true }
    end
    local tuya_devs, esp_nodes = {}, {}
    for ip, h in pairs(lan_hosts) do
      local hn = (h.name or ""):lower()
      if hn:find("esp32", 1, true) then
        esp_nodes[#esp_nodes + 1] = {
          ip = ip, mac = h.mac or "", name = h.name, kind = "esp32_voice",
          online = h.online and true or false,
        }
      elseif tcp_open(ip, 6668, 200) then
        tuya_devs[#tuya_devs + 1] = {
          ip = ip, mac = h.mac or "", kind = "tuya_ir",
          name = (h.name and h.name ~= "") and h.name or ("Tuya LAN (" .. ip .. ")"),
          is_current = (ip == cfg.ip),
        }
      end
    end
    out_json({
      ok = true,
      hubs = tuya_devs,
      tuya_devices = tuya_devs,
      esp32_nodes = esp_nodes,
      lan_tvs = read_lan_tvs(),
    })

  elseif method == "saveHubConfig" then
    local ip = trim(params.ip)
    local mac = trim(params.mac):lower()
    local did = trim(params.device_id)
    local lk = trim(params.local_key)
    local ct = tonumber(params.control_type)
    local patch = {}
    if ip:match("^%d+%.%d+%.%d+%.%d+$") then patch.ip = ip end
    if mac:match("^[%x:]+$") then patch.mac = mac end
    if did ~= "" then patch.device_id = did end
    if lk ~= "" then
      if #lk ~= 16 then out_json({ ok = false, message = "Local Key Tuya phải đủ đúng 16 ký tự" }); return end
      patch.local_key = lk
      set_entity_key("s06_default", lk)
    end
    if ct and (ct == 1 or ct == 2) then patch.control_type = ct end
    sync_primary_cfg(patch)
    local c0 = find_controller(reg, "s06_default")
    if c0 then
      if patch.ip then c0.ip = patch.ip end
      if patch.mac then c0.mac = patch.mac end
      if patch.device_id then c0.device_id = patch.device_id end
      if patch.control_type then c0.control_type = patch.control_type end
      save_registry(reg)
    end
    out_json({ ok = true, message = "Đã lưu cấu hình S06 Pro (chmod 600)" })

  elseif method == "saveController" then
    local cid = trim(params.id)
    local kind = trim(params.kind)
    if kind == "" then kind = "tuya_ir" end
    local name = trim(params.name)
    local room = trim(params.room)
    local ip = trim(params.ip)
    local mac = trim(params.mac):lower()
    local did = trim(params.device_id)
    local lk = trim(params.local_key)
    local ct = tonumber(params.control_type) or 1
    if lk ~= "" and #lk ~= 16 then
      out_json({ ok = false, message = "Local Key Tuya phải đủ đúng 16 ký tự" })
      return
    end
    if cid == "" then
      cid = ((kind == "esp32_voice") and "esp32_" or "s06_") .. tostring(os.time()) .. "_" .. tostring(#(reg.controllers or {}) + 1)
    end
    local existing = nil
    for _, c in ipairs(reg.controllers or {}) do if c.id == cid then existing = c; break end end
    if existing then
      if name ~= "" then existing.name = name end
      if room ~= "" then existing.room = room end
      if ip:match("^%d+%.%d+%.%d+%.%d+$") then existing.ip = ip end
      if mac ~= "" then existing.mac = mac end
      if did ~= "" then existing.device_id = did end
      existing.control_type = ct
    else
      if not ip:match("^%d+%.%d+%.%d+%.%d+$") then
        out_json({ ok = false, message = "Cần nhập địa chỉ IP LAN hợp lệ" })
        return
      end
      reg.controllers[#reg.controllers + 1] = {
        id = cid,
        kind = kind,
        name = (name ~= "") and name or ((kind == "esp32_voice") and "Mạch Giọng Nói ESP32" or "Cục Hồng Ngoại S06"),
        room = (room ~= "") and room or "Phòng khách",
        ip = ip,
        mac = mac,
        device_id = did,
        control_type = ct,
      }
    end
    if lk ~= "" then set_entity_key(cid, lk) end
    if cid == "s06_default" then
      local patch = {}
      if ip:match("^%d+%.%d+%.%d+%.%d+$") then patch.ip = ip end
      if mac ~= "" then patch.mac = mac end
      if did ~= "" then patch.device_id = did end
      if lk ~= "" then patch.local_key = lk end
      patch.control_type = ct
      sync_primary_cfg(patch)
    end
    save_registry(reg)
    local ctrls = build_public_controllers(reg, load_s06_cfg(), lan_hosts, false)
    out_json({ ok = true, message = "Đã lưu bộ điều khiển!", controllers = ctrls })

  elseif method == "removeController" then
    local cid = trim(params.id)
    if cid == "s06_default" then
      out_json({ ok = false, message = "Không thể xóa cục S06 Pro mặc định" })
      return
    end
    local kept, removed = {}, false
    for _, c in ipairs(reg.controllers or {}) do
      if c.id == cid then removed = true else kept[#kept + 1] = c end
    end
    reg.controllers = kept
    save_registry(reg)
    out_json({ ok = removed, message = removed and "Đã xóa bộ điều khiển" or "Không tìm thấy" })

  elseif method == "searchCatalog" then
    local q = trim(params.query or ""):lower()
    local cat_filter = trim(params.category or "all"):lower()
    local include_online = (params.include_online == true or cat_filter == "irdb")
    local tokens = {}
    for tok in q:gmatch("%S+") do tokens[#tokens + 1] = tok end

    local results = {}
    if cat_filter ~= "irdb" then
      for _, it in ipairs(BUILTIN_CATALOG) do
        if cat_filter == "all" or it.category == cat_filter then
          local match = true
          for _, tk in ipairs(tokens) do
            if not it.search:find(tk, 1, true) and not it.name:lower():find(tk, 1, true) then
              match = false; break
            end
          end
          if match then
            results[#results + 1] = {
              id = it.id, source = "builtin", category = it.category,
              driver = it.driver, type = it.type, brand = it.brand,
              name = it.name, subtitle = it.subtitle,
              button_count = it.buttons and #it.buttons or nil,
            }
          end
        end
      end
    end

    if include_online or (#tokens > 0 and #results < 5) then
      local idx = ensure_irdb_index()
      if idx then
        local online_cnt = 0
        for line in idx:gmatch("[^\r\n]+") do
          local low = line:lower()
          local match = true
          for _, tk in ipairs(tokens) do
            if not low:find(tk, 1, true) then match = false; break end
          end
          if match then
            local b_brand, b_cat, b_model = line:match("^([^/]+)/([^/]+)/(.+)%.csv$")
            if b_brand and b_cat then
              local inferred = infer_irdb_category(b_cat)
              if cat_filter == "all" or cat_filter == "irdb" or inferred == cat_filter then
                results[#results + 1] = {
                  id = "irdb:" .. line, irdb_path = line, source = "irdb",
                  category = inferred, driver = "tuya_ir_remote", type = "ir_remote",
                  brand = b_brand, name = b_brand .. " — " .. b_cat:gsub("_", " "),
                  subtitle = "Kho Online IRDB (" .. (b_model or "") .. ")",
                }
                online_cnt = online_cnt + 1
                if online_cnt >= 25 or #results >= 40 then break end
              end
            end
          end
        end
      end
    end
    out_json({ ok = true, results = results, online_cached = (read_file(IRDB_CACHE) ~= nil) })

  elseif method == "testCatalogItem" then
    local cid = trim(params.catalog_id)
    local ipath = trim(params.irdb_path)
    local ctrl_id = trim(params.controller_id)
    if ctrl_id == "" then ctrl_id = "s06_default" end
    local dry = (params.dry_run == true)
    local pkt, label_tested

    if cid ~= "" and BUILTIN_BY_ID[cid] then
      local item = BUILTIN_BY_ID[cid]
      if item.type == "ac" and ok_ac then
        pkt = ac_ir.encode(item.brand, { power = true, temp = 26, mode = "cool", fan = "auto", swing = false }, "on")
        label_tested = item.name .. " (Bật 26°C)"
      elseif item.buttons then
        for _, b in ipairs(item.buttons) do
          if b.proto and ok_ac and ac_ir.supports_generic(b.proto) then
            pkt = ac_ir.encode_generic(b.proto, b.dev, b.sub, b.fn)
            label_tested = item.name .. " — " .. b.label
            break
          end
        end
      end
    elseif ipath ~= "" then
      local btns, err = fetch_irdb_csv_buttons(ipath)
      if not btns then
        out_json({ ok = false, message = "Không tải được hoặc chưa hỗ trợ chuẩn IR file này: " .. tostring(err) })
        return
      end
      pkt = ac_ir.encode_generic(btns[1].proto, btns[1].dev, btns[1].sub, btns[1].fn)
      label_tested = ipath .. " — " .. btns[1].label
    end

    if not pkt then
      out_json({ ok = false, message = "Mẫu này dùng Học phím — hãy Thêm rồi bấm Học từng nút bằng remote thật!" })
      return
    end
    if dry then
      out_json({ ok = true, dry_run = true, tested = label_tested, protocol = pkt.protocol, head_len = #pkt.head, key_len = #pkt.key })
      return
    end
    local ctrl = find_controller(reg, ctrl_id)
    if not ctrl then out_json({ ok = false, message = "Không tìm thấy cục phát S06" }); return end
    local hip, hdid, hlkey, hct = heal_controller_ip(ctrl, lan_hosts, cfg)
    if not ok_tuya or #hlkey ~= 16 then
      out_json({ ok = false, message = "Cục phát [" .. ctrl.name .. "] chưa có Local Key 16 ký tự" })
      return
    end
    local ok, err = tuya_v35.send_head_key(hip, hdid, hlkey, pkt.head, pkt.key, hct)
    out_json({ ok = ok and true or false, message = ok and ("Đã bắn thử [" .. label_tested .. "] qua " .. ctrl.name .. "!") or ("Lỗi gửi: " .. tostring(err)) })

  elseif method == "addDevice" then
    local drv = trim(params.driver)
    local cid = trim(params.catalog_id)
    local ipath = trim(params.irdb_path)
    local ctrl_id = trim(params.controller_id)
    if ctrl_id == "" then ctrl_id = "s06_default" end
    local custom_name = trim(params.name)
    local room = trim(params.room)
    if room == "" then room = "Phòng khách" end
    local new_dev

    if drv == "tuya_switch" then
      local ip = trim(params.ip)
      local did = trim(params.device_id)
      local lk = trim(params.local_key)
      local dp = trim(params.dp)
      if dp == "" then dp = "1" end
      local cat = trim(params.category)
      if cat == "" then cat = "light" end
      if not ip:match("^%d+%.%d+%.%d+%.%d+$") or did == "" or #lk ~= 16 then
        out_json({ ok = false, message = "Công tắc Tuya Wi-Fi cần IP LAN hợp lệ, Device ID và Local Key đúng 16 ký tự!" })
        return
      end
      local uid = "tsw_" .. tostring(os.time()) .. "_" .. tostring(#(reg.devices or {}) + 1)
      set_entity_key(uid, lk)
      new_dev = {
        id = uid, driver = "tuya_switch", type = "switch",
        name = (custom_name ~= "") and custom_name or ("Công tắc Đèn/Quạt (" .. ip .. ")"),
        room = room, category = cat, brand = "Tuya Wi-Fi",
        ip = ip, mac = trim(params.mac):lower(), device_id = did, dp = dp,
        has_key = true, state = { on = false }, buttons = {},
      }
    elseif drv == "http_relay" then
      local on_url = trim(params.on_url)
      local off_url = trim(params.off_url)
      local cat = trim(params.category)
      if cat == "" then cat = "light" end
      if not is_lan_http_url(on_url) or (off_url ~= "" and not is_lan_http_url(off_url)) then
        out_json({ ok = false, message = "URL Relay chỉ chấp nhận địa chỉ mạng LAN nội bộ (http://192.168.x.x/... hoặc 10.x/172.16.x)" })
        return
      end
      local uid = "hrel_" .. tostring(os.time()) .. "_" .. tostring(#(reg.devices or {}) + 1)
      new_dev = {
        id = uid, driver = "http_relay", type = "switch",
        name = (custom_name ~= "") and custom_name or "Công tắc HTTP Relay LAN",
        room = room, category = cat, brand = "HTTP / Tasmota / ESP32",
        on_url = on_url, off_url = (off_url ~= "") and off_url or on_url,
        state = { on = false }, buttons = {},
      }
    elseif drv == "android_tv" then
      local tv_id = trim(params.tv_id)
      local tv_found = nil
      for _, t in ipairs(read_lan_tvs()) do if t.id == tv_id then tv_found = t; break end end
      if not tv_found then
        out_json({ ok = false, message = "Không tìm thấy TV LAN id: " .. tv_id })
        return
      end
      local uid = "atv_" .. tv_found.id
      for _, d in ipairs(reg.devices or {}) do
        if d.id == uid then out_json({ ok = false, message = tv_found.name .. " đã có sẵn trong danh sách!" }); return end
      end
      new_dev = {
        id = uid, driver = "android_tv", type = "android_tv",
        name = (custom_name ~= "") and custom_name or tv_found.name,
        room = room, category = "tv", brand = tv_found.brand or "Android TV",
        ip = tv_found.ip, tv_id = tv_found.id, buttons = {},
      }
    elseif cid ~= "" and BUILTIN_BY_ID[cid] then
      local it = BUILTIN_BY_ID[cid]
      local did = cid .. "_" .. tostring(os.time()) .. "_" .. tostring(#(reg.devices or {}) + 1)
      if it.type == "ac" then
        new_dev = {
          id = did, driver = "tuya_ir_ac", type = "ac", controller_id = ctrl_id,
          name = (custom_name ~= "") and custom_name or it.name,
          room = room, category = "ac", brand = it.brand,
          brand_label = ok_ac and ac_ir.get_brand_info(it.brand).label or it.brand,
          source = "builtin",
          state = { power = false, temp = 26, mode = "cool", fan = "auto", swing = false },
          buttons = {},
        }
        if ctrl_id == "s06_default" then sync_primary_cfg({ ac_brand = it.brand }) end
      else
        local btns = {}
        for _, b in ipairs(it.buttons or {}) do
          btns[#btns + 1] = { id = b.id, label = b.label, proto = b.proto, dev = b.dev, sub = b.sub, fn = b.fn }
        end
        new_dev = {
          id = did, driver = it.driver or "tuya_ir_remote", type = it.type, controller_id = ctrl_id,
          name = (custom_name ~= "") and custom_name or it.name,
          room = room, category = it.category, brand = it.brand,
          source = "builtin", buttons = btns,
        }
      end
    elseif ipath ~= "" then
      local btns, err = fetch_irdb_csv_buttons(ipath)
      if not btns then
        out_json({ ok = false, message = "Không thêm được từ IRDB: " .. tostring(err) })
        return
      end
      local b_brand, b_cat = ipath:match("^([^/]+)/([^/]+)/")
      local did = "irdb_" .. tostring(os.time()) .. "_" .. tostring(#(reg.devices or {}) + 1)
      new_dev = {
        id = did, driver = "tuya_ir_remote", type = "ir_remote", controller_id = ctrl_id,
        name = (custom_name ~= "") and custom_name or ((b_brand or "IR") .. " " .. (b_cat or "Remote"):gsub("_", " ")),
        room = room, category = infer_irdb_category(b_cat),
        brand = b_brand or "IRDB", source = "irdb", irdb_path = ipath, buttons = btns,
      }
    else
      out_json({ ok = false, message = "Thiếu thông tin thiết bị cần thêm" })
      return
    end

    reg.devices[#reg.devices + 1] = new_dev
    save_registry(reg)
    out_json({ ok = true, message = "Đã thêm: " .. new_dev.name, device = new_dev, devices = reg.devices })

  elseif method == "removeDevice" then
    local did = trim(params.id)
    local kept, removed = {}, false
    for _, d in ipairs(reg.devices or {}) do
      if d.id == did then removed = true else kept[#kept + 1] = d end
    end
    reg.devices = kept
    save_registry(reg)
    local kv = load_key_vault()
    if kv[did] then kv[did] = nil; save_key_vault(kv) end
    out_json({ ok = removed, message = removed and "Đã xóa thiết bị" or "Không tìm thấy thiết bị", devices = kept })

  elseif method == "controlDevice" then
    local did = trim(params.id)
    local op = trim(params.op)
    local val = trim(params.value)
    local btn_id = trim(params.button)
    local dry = (params.dry_run == true)

    local target = nil
    for _, d in ipairs(reg.devices or {}) do if d.id == did then target = d; break end end
    if not target then out_json({ ok = false, message = "Không tìm thấy thiết bị" }); return end
    local drv = target.driver or ((target.type == "ac") and "tuya_ir_ac" or "tuya_ir_remote")

    if drv == "tuya_switch" then
      local st = target.state or { on = false }
      local nxt = (op == "on") and true or ((op == "off") and false or (not st.on))
      local dp = tostring(target.dp or "1")
      local lkey = get_entity_key(target.id, cfg)
      if not dry and (not ok_tuya or #lkey ~= 16) then
        out_json({ ok = false, message = "Công tắc Tuya chưa đủ Local Key 16 ký tự" })
        return
      end
      local ok, err = true, nil
      if not dry then
        ok, err = tuya_v35.set_dps(target.ip, target.device_id, lkey, { [dp] = nxt }, 3)
      end
      if ok then st.on = nxt; target.state = st; save_registry(reg) end
      out_json({ ok = ok and true or false, dry_run = dry, device = target, message = ok and (target.name .. (nxt and " → ĐÃ BẬT" or " → ĐÃ TẮT")) or ("Lỗi Tuya Switch: " .. tostring(err)) })

    elseif drv == "http_relay" then
      local st = target.state or { on = false }
      local nxt = (op == "on") and true or ((op == "off") and false or (not st.on))
      local u = nxt and target.on_url or (target.off_url or target.on_url)
      if not is_lan_http_url(u) then out_json({ ok = false, message = "URL Relay LAN không hợp lệ" }); return end
      if not dry then
        os.execute(string.format("curl -4 -sS --connect-timeout 2 -m 3 %s >/dev/null 2>&1", sh_quote(u)))
      end
      st.on = nxt; target.state = st; save_registry(reg)
      out_json({ ok = true, dry_run = dry, device = target, message = target.name .. (nxt and " → ĐÃ BẬT" or " → ĐÃ TẮT") })

    elseif drv == "android_tv" then
      local ok_call = false
      if dry then
        ok_call = true
      elseif op == "cmd" and val ~= "" then
        local r = http_get_json(HUB_HTTP .. "/command?text=" .. url_encode(val) .. "&device=" .. url_encode(target.tv_id or ""), 4)
        ok_call = (type(r) == "table" and r.status == "ok")
      elseif op == "key" and btn_id ~= "" then
        local r = http_get_json(HUB_HTTP .. "/remote_key?key=" .. url_encode(btn_id) .. "&device=" .. url_encode(target.tv_id or ""), 4)
        ok_call = (type(r) == "table" and r.status == "ok")
      end
      out_json({ ok = ok_call, dry_run = dry, device = target, message = ok_call and ("Đã gửi lệnh tới " .. target.name) or ("TV hoặc Voice Hub chưa phản hồi") })

    elseif drv == "tuya_ir_ac" and ok_ac then
      local ctrl = find_controller(reg, target.controller_id or "s06_default")
      local hip, hdid, hlkey, hct = heal_controller_ip(ctrl or { id="s06_default", ip=cfg.ip, mac=cfg.mac, device_id=cfg.device_id, control_type=cfg.control_type }, lan_hosts, cfg)
      if not dry and (not ok_tuya or #hlkey ~= 16) then
        out_json({ ok = false, message = "Cục S06 chưa có Local Key 16 ký tự" })
        return
      end
      local st = target.state or { power = false, temp = 26, mode = "cool", fan = "auto", swing = false }
      local prev_pwr = st.power and true or false
      local enc_op = "set"
      if op == "on" then st.power = true; enc_op = "on"
      elseif op == "off" then st.power = false; enc_op = "off"
      elseif op == "temp_up" then st.temp = math.min(30, (tonumber(st.temp) or 26) + 1); st.power = true
      elseif op == "temp_down" then st.temp = math.max(16, (tonumber(st.temp) or 26) - 1); st.power = true
      elseif op == "set_temp" then st.temp = math.min(30, math.max(16, tonumber(val) or 26)); st.power = true
      elseif op == "mode" and val ~= "" then st.mode = val; st.power = true
      elseif op == "fan" and val ~= "" then st.fan = val; st.power = true; enc_op = "fan"
      elseif op == "swing" then st.swing = not (st.swing and true or false); st.power = true; enc_op = "swing"
      elseif op == "next_variant" then
        target.brand = ac_ir.next_variant(target.brand)
        target.brand_label = ac_ir.get_brand_info(target.brand).label
        target.state = st
        save_registry(reg)
        if (target.controller_id or "s06_default") == "s06_default" then sync_primary_cfg({ ac_brand = target.brand }) end
        out_json({ ok = true, message = "Đã đổi mã sang: " .. target.brand_label, device = target })
        return
      end
      st.was_on = prev_pwr
      local pkt = ac_ir.encode(target.brand or "lg2", st, enc_op)
      if not pkt then out_json({ ok = false, message = "Lỗi mã hóa AC brand: " .. tostring(target.brand) }); return end
      local ok, err = true, nil
      if not dry then
        ok, err = tuya_v35.send_head_key(hip, hdid, hlkey, pkt.head, pkt.key, hct)
      end
      if ok then
        target.state = st
        save_registry(reg)
        if (target.controller_id or "s06_default") == "s06_default" then
          sync_primary_cfg({ ac_brand = target.brand, ac_temp = st.temp, ac_mode = st.mode, ac_fan = st.fan, ac_power = st.power, ac_swing = st.swing })
        end
      end
      out_json({
        ok = ok and true or false, dry_run = dry, protocol = pkt.protocol, head_len = #pkt.head, key_len = #pkt.key,
        message = ok and ("Đã gửi " .. target.name .. " (" .. tostring(st.temp) .. "°C • " .. tostring(st.mode) .. ")") or ("Lỗi S06: " .. tostring(err)),
        device = target,
      })

    else
      local ctrl = find_controller(reg, target.controller_id or "s06_default")
      local hip, hdid, hlkey, hct = heal_controller_ip(ctrl or { id="s06_default", ip=cfg.ip, mac=cfg.mac, device_id=cfg.device_id, control_type=cfg.control_type }, lan_hosts, cfg)
      if not dry and (not ok_tuya or #hlkey ~= 16) then
        out_json({ ok = false, message = "Cục S06 chưa có Local Key 16 ký tự" })
        return
      end
      local b_found = nil
      for _, b in ipairs(target.buttons or {}) do if b.id == btn_id then b_found = b; break end end
      if not b_found then out_json({ ok = false, message = "Không tìm thấy nút: " .. btn_id }); return end
      if b_found.base64 and b_found.base64 ~= "" then
        local ok, err = true, nil
        if not dry then ok, err = tuya_v35.send_ir(hip, hdid, hlkey, b_found.base64, hct) end
        out_json({ ok = ok and true or false, dry_run = dry, mode = "learned", message = ok and ("Đã bấm [" .. b_found.label .. "] (Mã đã học)") or ("Lỗi S06: " .. tostring(err)) })
      elseif b_found.proto and ok_ac and ac_ir.supports_generic(b_found.proto) then
        local pkt = ac_ir.encode_generic(b_found.proto, b_found.dev, b_found.sub, b_found.fn)
        if not pkt then out_json({ ok = false, message = "Lỗi encode " .. tostring(b_found.proto) }); return end
        local ok, err = true, nil
        if not dry then ok, err = tuya_v35.send_head_key(hip, hdid, hlkey, pkt.head, pkt.key, hct) end
        out_json({ ok = ok and true or false, dry_run = dry, mode = pkt.protocol, head_len = #pkt.head, key_len = #pkt.key, message = ok and ("Đã bấm [" .. b_found.label .. "] (" .. pkt.protocol .. ")") or ("Lỗi S06: " .. tostring(err)) })
      else
        out_json({ ok = false, need_learn = true, message = "Nút [" .. b_found.label .. "] chưa có mã IR — bật Chế độ Học Phím rồi bấm nút này!" })
      end
    end

  elseif method == "learnButton" then
    local did = trim(params.id)
    local btn_id = trim(params.button)
    local btn_label = trim(params.label)
    local target = nil
    for _, d in ipairs(reg.devices or {}) do if d.id == did then target = d; break end end
    if not target then out_json({ ok = false, message = "Không tìm thấy thiết bị" }); return end
    local ctrl = find_controller(reg, target.controller_id or "s06_default")
    local hip, hdid, hlkey, hct = heal_controller_ip(ctrl or { id="s06_default", ip=cfg.ip, mac=cfg.mac, device_id=cfg.device_id, control_type=cfg.control_type }, lan_hosts, cfg)
    if not ok_tuya or #hlkey ~= 16 then
      out_json({ ok = false, message = "Cục S06 chưa có Local Key 16 ký tự" })
      return
    end
    if btn_id == "" then btn_id = "custom_" .. tostring(os.time()) end
    local code = tuya_v35.learn_ir(hip, hdid, hlkey, 12, hct)
    if not code then
      out_json({ ok = false, message = "Hết 12s chưa nhận tín hiệu remote. Hãy chĩa sát vào S06 Pro và thử lại." })
      return
    end
    target.buttons = target.buttons or {}
    local updated = false
    for _, b in ipairs(target.buttons) do
      if b.id == btn_id then
        b.base64 = code
        if btn_label ~= "" then b.label = btn_label end
        updated = true; break
      end
    end
    if not updated then
      target.buttons[#target.buttons + 1] = { id = btn_id, label = (btn_label ~= "") and btn_label or btn_id, base64 = code }
    end
    save_registry(reg)
    if target.category == "fan" then
      local voice_map = { power = "fan_power", speed_up = "fan_speed_up", speed_down = "fan_speed_down", swing = "fan_swing", timer = "fan_timer" }
      local vk = voice_map[btn_id]
      if vk then
        local fresh = load_s06_cfg()
        fresh.ir_codes[vk] = code
        write_atomic(S06_CFG_FILE, cjson.encode(fresh), "600")
      end
    end
    out_json({ ok = true, message = "Đã học xong nút [" .. ((btn_label ~= "") and btn_label or btn_id) .. "]!", device = target })
  else
    out_json({ ok = false, message = "Unknown method: " .. tostring(method) })
  end
end
