#!/usr/bin/lua
-- DOANDUY Smart Home RPCD Backend for Tuya S06 Pro Local LAN Control & Universal IR Catalog
package.path = "/usr/lib/lua/?.lua;/usr/lib/lua/?/init.lua;" .. (package.path or "")

local cjson = require("cjson")
local nixio = require("nixio")
local ok_tuya, tuya_v35 = pcall(require, "tuya_v35_local")
local ok_ac, ac_ir = pcall(require, "ac_ir_protocols")

local S06_CFG_FILE = "/etc/duytv_s06_config.json"
local DEVICES_FILE = "/etc/config/doanduy_smarthome.json"
local HUB_DEV_FILE = "/etc/duytv_lan_devices.json"
local IRDB_CACHE   = "/tmp/irdb_index.txt"
local HUB_HTTP     = "http://127.0.0.1:8996"

local function read_file(path)
  local f = io.open(path, "r")
  if not f then return nil end
  local d = f:read("*a")
  f:close()
  return d
end

local function write_atomic(path, content, mode)
  local dir = path:match("^(.+)/[^/]+$")
  if dir then os.execute("mkdir -p '" .. dir:gsub("'", "'\\''") .. "' >/dev/null 2>&1") end
  local tmp = path .. ".tmp"
  local f = assert(io.open(tmp, "wb"))
  f:write(content)
  f:close()
  os.rename(tmp, path)
  if mode then os.execute("chmod " .. mode .. " '" .. path:gsub("'", "'\\''") .. "' >/dev/null 2>&1") end
end

local function trim(s)
  return (tostring(s or "")):gsub("^%s+", ""):gsub("%s+$", "")
end

local function sh_quote(s)
  return "'" .. tostring(s or ""):gsub("'", "'\\''") .. "'"
end

local function http_get_json(url, timeout_s)
  local p = io.popen(string.format("curl -4 -sS --connect-timeout 2 -m %d %s 2>/dev/null", timeout_s or 3, sh_quote(url)))
  if not p then return nil end
  local raw = p:read("*a") or ""
  p:close()
  if raw == "" then return nil end
  local ok, dec = pcall(cjson.decode, raw)
  return ok and dec or nil
end

local function tcp_open(ip, port, timeout_ms)
  local s = nixio.socket("inet", "stream")
  if not s then return false end
  s:setblocking(false)
  local ok = s:connect(ip, port)
  if ok then s:close(); return true end
  local fds = {{ fd = s, events = nixio.poll_flags("out") }}
  local rc = nixio.poll(fds, timeout_ms or 180)
  local err = s:getopt("socket", "error")
  local rev = fds[1].revents or 0
  s:close()
  return (rc and rc > 0 and rev > 0 and err == 0) and true or false
end

local function url_encode(s)
  return (tostring(s or "")):gsub("([^%w%-%._~ /])", function(c)
    return string.format("%%%02X", string.byte(c))
  end):gsub(" ", "%%20")
end

-- =============================================================================
-- HUB CONFIG & SAFE PUBLIC VIEW (Zero-Leak: never returns raw local_key)
-- =============================================================================

local function load_s06_cfg()
  local cfg = {
    ip = "192.168.1.130",
    mac = "20:f1:b2:fa:76:27",
    device_id = "a3fc144d9c06ae63b5bqj0",
    version = "3.5",
    local_key = "",
    control_type = 1,
    ac_brand = "lg2",
    ac_temp = 26,
    ir_codes = {},
  }
  local raw = read_file(S06_CFG_FILE)
  if raw and raw ~= "" then
    local ok, dec = pcall(cjson.decode, raw)
    if ok and type(dec) == "table" then
      for k, v in pairs(dec) do cfg[k] = v end
    end
  end
  if type(cfg.ir_codes) ~= "table" then cfg.ir_codes = {} end
  return cfg
end

local function heal_hub_ip(cfg)
  local arp = read_file("/proc/net/arp") or ""
  local tgt = trim(cfg.mac or ""):lower()
  if tgt ~= "" then
    for line in arp:gmatch("[^\r\n]+") do
      local ip, _, _, mac = line:match("^(%d+%.%d+%.%d+%.%d+)%s+%S+%s+%S+%s+([%x:]+)")
      if ip and mac and mac:lower() == tgt then
        cfg.ip = ip
        break
      end
    end
  end
end

local function get_live_hub_info(cfg, allow_probe)
  heal_hub_ip(cfg)
  local has_key = (#(cfg.local_key or "") == 16)
  local out = {
    ip = cfg.ip,
    mac = cfg.mac,
    device_id = cfg.device_id,
    version = cfg.version or "3.5",
    control_type = tonumber(cfg.control_type) or 1,
    has_key = has_key,
    ac_brand = cfg.ac_brand or "lg2",
    live_ok = false,
    temp_c = nil,
    humidity = nil,
  }
  if allow_probe then
    local st = http_get_json(HUB_HTTP .. "/s06/status?probe=1", 3)
    if type(st) == "table" and st.ip then
      out.live_ok = st.live_ok and true or false
      out.ip = st.ip or out.ip
      out.dps = st.dps
      if type(st.dps) == "table" then
        local t = tonumber(st.dps["101"] or st.dps["1"])
        local h = tonumber(st.dps["102"] or st.dps["2"])
        if t then out.temp_c = tonumber(string.format("%.1f", (t > 80) and (t / 10.0) or t)) end
        if h then out.humidity = math.floor(h) end
      end
      return out
    elseif ok_tuya and has_key then
      local dps = tuya_v35.status(cfg.ip, cfg.device_id, cfg.local_key, 2)
      if type(dps) == "table" then
        out.live_ok = true
        out.dps = dps
        local t = tonumber(dps["101"] or dps["1"])
        local h = tonumber(dps["102"] or dps["2"])
        if t then out.temp_c = tonumber(string.format("%.1f", (t > 80) and (t / 10.0) or t)) end
        if h then out.humidity = math.floor(h) end
      end
    end
  end
  return out
end

-- =============================================================================
-- SMART DEVICE REGISTRY (/etc/config/doanduy_smarthome.json)
-- =============================================================================

local function seed_default_devices(cfg)
  local br = cfg.ac_brand or "lg2"
  local label = (ok_ac and ac_ir.get_brand_info(br).label) or "LG Inverter (Chuẩn mới LG2)"
  return {
    {
      id = "ac_default_1",
      name = "Máy lạnh " .. trim(label:match("^([^%(]+)") or "LG Inverter"),
      room = "Phòng ngủ",
      category = "ac",
      type = "ac",
      brand = br,
      brand_label = label,
      source = "builtin",
      state = {
        power = cfg.ac_power and true or false,
        temp = tonumber(cfg.ac_temp) or 26,
        mode = cfg.ac_mode or "cool",
        fan = cfg.ac_fan or "auto",
        swing = cfg.ac_swing and true or false,
      },
      buttons = {},
    }
  }
end

local function load_devices(cfg)
  local raw = read_file(DEVICES_FILE)
  if raw and raw ~= "" then
    local ok, dec = pcall(cjson.decode, raw)
    if ok and type(dec) == "table" and type(dec.devices) == "table" then
      return dec.devices
    end
  end
  local seeded = seed_default_devices(cfg)
  write_atomic(DEVICES_FILE, cjson.encode({ version = 1, devices = seeded }), "600")
  return seeded
end

local function save_devices(devs)
  write_atomic(DEVICES_FILE, cjson.encode({ version = 1, devices = devs }), "600")
end

