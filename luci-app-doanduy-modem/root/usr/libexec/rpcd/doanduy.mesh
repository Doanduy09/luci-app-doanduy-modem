#!/bin/sh
# DOANDUY Auto-Mesh RPCD Backend

run_bg() {
	if command -v setsid >/dev/null 2>&1; then
		setsid "$@" </dev/null >/dev/null 2>&1 &
	else
		( "$@" </dev/null >/dev/null 2>&1 & )
	fi
}

case "$1" in
	list)
		echo '{"status":{},"setMode":{"mode":"string","node_ip":"string"},"setWifi":{"sync_mode":"string","ssid_2g":"string","ssid_5g":"string","key":"string","encryption":"string","keep_key":"boolean"}}'
		;;
	call)
		input=""
		read -r -t 2 input 2>/dev/null || true
		case "$2" in
			status)
				if [ -x /usr/bin/auto_mesh ]; then
					/usr/bin/auto_mesh status
				else
					echo '{"success":false,"message":"Chưa cài đặt /usr/bin/auto_mesh"}'
				fi
				;;
			setMode)
				mode=$(printf '%s' "$input" | jsonfilter -e '$.mode' 2>/dev/null | tr -cd 'a-z_')
				nip=$(printf '%s' "$input" | jsonfilter -e '$.node_ip' 2>/dev/null | tr -cd '0-9.')
				case "$mode" in
					pair|auto)
						run_bg /usr/bin/auto_mesh pair
						echo '{"success":true,"message":"Đã bật Auto-Mesh (tự dò ghép tối đa 10 phút, tự tắt nếu không có Mesh và tự bật lại khi khởi động lại router)!"}'
						;;
					controller)
						run_bg /usr/bin/auto_mesh controller
						echo '{"success":true,"message":"Đang thiết lập cố định làm Router Chính (192.168.1.1, DHCP BẬT, phát sóng DOANDUY_MESH)..."}'
						;;
					node)
						[ -n "$nip" ] || nip="192.168.1.10"
						run_bg /usr/bin/auto_mesh node "$nip"
						echo "{\"success\":true,\"new_ip\":\"$nip\",\"message\":\"Đang chuyển làm Router Phụ (IP $nip, tắt DHCP, nối vào Router Chính 192.168.1.1)...\"}"
						;;
					unmesh|standalone|off)
						run_bg /usr/bin/auto_mesh unmesh
						echo '{"success":true,"new_ip":"192.168.1.1","message":"Đã tắt Mesh! Đang khôi phục IP mặc định 192.168.1.1 và bật lại DHCP..."}'
						;;
					*)
						echo '{"success":false,"message":"Chế độ Mesh không hợp lệ"}'
						;;
				esac
				;;
			setWifi)
				if [ -f /usr/lib/lua/doanduy/mesh_wifi.lua ] && command -v lua >/dev/null 2>&1; then
					res=$(printf '%s' "$input" | /usr/bin/lua /usr/lib/lua/doanduy/mesh_wifi.lua set_wifi 2>/dev/null)
					[ -n "$res" ] || res='{"success":false,"message":"Lỗi xử lý cấu hình Wi-Fi"}'
					case "$res" in
						*'"success":true'*)
							[ -x /usr/bin/auto_mesh ] && run_bg /usr/bin/auto_mesh wifi_applied
							;;
					esac
					printf '%s\n' "$res"
				else
					echo '{"success":false,"message":"Thiếu module đồng bộ Wi-Fi /usr/lib/lua/doanduy/mesh_wifi.lua"}'
				fi
				;;
			*)
				echo '{"success":false,"message":"Unknown method"}'
				;;
		esac
		;;
esac
