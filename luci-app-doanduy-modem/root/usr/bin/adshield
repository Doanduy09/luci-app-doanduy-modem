pagead2.googleadservices.com
adservice.google.com
adservice.google.com.vn
adservice.google.vn
ads.google.com
admob.com

# VIETNAMESE AD NETWORKS & TRACKERS (BẢO VỆ TUYỆT ĐỐI VCMEDIA & CỐC CỐC TẢI VỀ)
admicro.vn
eclick.vn
ambient-platform.vn
ants.vn
blueseed.tv
microad.vn
adtima.vn
adtimaserver.vn
media-coccoc.com
qc.coccoc.com
qc.coccoc.vn
banners-gallery.coccoc.com
media-ad.vn
vietad.vn
novanet.vn
tracking.shopee.vn
ads.shopee.vn
ads.zalo.me
tracking.zalo.me
adsmol.zaloapp.com
ads.tiktok.com
analytics.tiktok.com
log.byteoversea.com

# SMART TV (SAMSUNG, LG) & HARDWARE TELEMETRY ADS
samsungads.com
smetrics.samsung.com
config.samsungads.com
gpm.samsungqbe.com
log-config.samsungacs.com
lgtvcommon.com
ssp.lgtvcommon.com
ad.lgappstv.com
ibs.lgappstv.com
tracking.miui.com
data.mistat.xiaomi.com
ad.xiaomi.com
sdkconfig.ad.xiaomi.com

# GLOBAL POPUP, BANNER, NATIVE ADS & TRACKERS
taboola.com
outbrain.com
popads.net
popcash.net
propellerads.com
mgid.com
adsterra.com
adnxs.com
criteo.com
casalemedia.com
openx.net
rubiconproject.com
pubmatic.com
flashtalking.com
scorecardresearch.com
quantserve.com
adcolony.com
unityads.unity3d.com
# META & FACEBOOK AD NETWORKS, PIXEL TRACKERS & EVENT PROCESSING
an.facebook.com
