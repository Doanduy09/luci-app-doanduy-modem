#!/bin/sh
# ==============================================================================
# DOANDUY UNIVERSAL MULTI-TIER AUTO-MESH ENGINE (v2.7.0)
# - Tự động 100% Always-Ready: Có mạng = Router Chính (192.168.1.1),
#   không mạng = Router Phụ (192.168.1.10..99) tự dò & ghép bất cứ lúc nào
# - Hỗ trợ mọi dòng chip & giữ nguyên Hardware Offload (NSS / WED / HNAT)
# - Router Tri-Band tự tách Relay AP sang radio 5G riêng tránh đụng kênh Uplink
# - Đồng bộ Wi-Fi mã hóa từ Router Chính (mặc định) hoặc tùy chỉnh Wi-Fi riêng
# ==============================================================================
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
export TZ='ICT-7'

MESH_UCI="doanduy_mesh"
CACHE_FILE="/tmp/auto_mesh_status.json"
LOG_FILE="/tmp/auto_mesh.log"
LOCK_FILE="/var/lock/doanduy_auto_mesh.lock"
RECONCILE_LOCK="/var/lock/doanduy_auto_mesh_reconcile.lock"
LAST_RELOAD_FILE="/tmp/doanduy_mesh_last_reload"
LOST_TS_FILE="/tmp/doanduy_mesh_lost_ts"
NUDGE_DONE_FILE="/tmp/doanduy_mesh_nudge_done"
SCAN_MISS_FILE="/tmp/doanduy_mesh_scan_miss"
DIRECT_OK_STREAK_FILE="/tmp/doanduy_mesh_direct_streak"
PAIR_UNTIL_FILE="/tmp/doanduy_mesh_pair_until"
IDLE_FLAG_FILE="/tmp/doanduy_mesh_auto_idle"
HAD_PEER_FILE="/tmp/doanduy_mesh_had_peer"
ACTION_EPOCH_FILE="/tmp/doanduy_mesh_action_epoch"
WIFI_HELPER="/usr/lib/lua/doanduy/mesh_wifi.lua"
PAIR_WINDOW_SEC=300
DEFAULT_MESH_SSID="DOANDUY_MESH"
DEFAULT_MESH_KEY="DoanduyMesh@2026!Sec"
LEGACY_MESH_SSID="SysMesh_Athena"
DEFAULT_NODE_IP="192.168.1.10"
RESCUE_IP="192.168.1.254"

safe_wifi_reload() {
	local force="${1:-0}" now_s last_s
	now_s=$(date +%s)
	last_s=$(cat "$LAST_RELOAD_FILE" 2>/dev/null || echo 0)
	if [ "$force" != "1" ] && [ $((now_s - ${last_s:-0})) -lt 8 ]; then
		return 0
	fi
	echo "$now_s" > "$LAST_RELOAD_FILE"
	( /sbin/wifi reload >/dev/null 2>&1 & )
}

run_locked() {
	mkdir -p /var/lock 2>/dev/null
	{
		local _t=0
		while ! flock -n 9 2>/dev/null; do
			_t=$((_t + 1))
			[ "$_t" -ge 15 ] && return 0
			sleep 1
		done
		"$@"
	} 9>"$RECONCILE_LOCK"
}

get_upstream_gateway() {
	local gw
	gw=$(uci -q get network.mesh_uplink.gateway 2>/dev/null | cut -d/ -f1)
	if [ -z "$gw" ] && command -v ubus >/dev/null 2>&1; then
		gw=$(ubus call network.interface.mesh_uplink status 2>/dev/null | jsonfilter -e '@.route[0].nexthop' 2>/dev/null | head -n 1)
	fi
	echo "${gw:-192.168.1.1}"
}

get_wifi_summary_json() {
	local out
	if [ -f "$WIFI_HELPER" ] && command -v lua >/dev/null 2>&1; then
		out=$(lua "$WIFI_HELPER" summary 2>/dev/null)
	fi
	case "$out" in
		\{*\}) echo "$out" ;;
		*) echo '{"sync_mode":"master","ssid_2g":"","ssid_5g":"","encryption":"none","has_key":false}' ;;
	esac
}

get_scan_misses() {
	local m
	m=$(cat "$SCAN_MISS_FILE" 2>/dev/null || echo 0)
	echo "${m:-0}"
}

log_mesh() {
	if [ -f "$LOG_FILE" ] && [ "$(wc -c < "$LOG_FILE" 2>/dev/null || echo 0)" -gt 32768 ]; then
		tail -n 80 "$LOG_FILE" > "${LOG_FILE}.tmp" 2>/dev/null && mv -f "${LOG_FILE}.tmp" "$LOG_FILE" 2>/dev/null
	fi
	echo "$(date '+%Y-%m-%d %H:%M:%S') $1" >> "$LOG_FILE"
	logger -t doanduy_mesh "$1" 2>/dev/null || true
}

json_esc() {
	printf '%s' "$1" | tr -d '\r\n' | sed 's/\\/\\\\/g; s/"/\\"/g'
}

bump_action_epoch() {
	mkdir -p /tmp 2>/dev/null
	printf '%s_%s\n' "$(date +%s)" "$$" > "$ACTION_EPOCH_FILE"
}

is_epoch_current() {
	local cur
	cur=$(cat "$ACTION_EPOCH_FILE" 2>/dev/null || echo 0)
	[ "$cur" = "${1:-0}" ]
}

get_node_ip() {
	local uip
	uip=$(uci -q get network.mesh_uplink.ipaddr 2>/dev/null | cut -d/ -f1)
	if [ -z "$uip" ] && [ -n "$(uci -q get network.mesh_uplink 2>/dev/null)" ] && command -v ubus >/dev/null 2>&1; then
		uip=$(ubus call network.interface.mesh_uplink status 2>/dev/null | jsonfilter -e '@["ipv4-address"][0].address' 2>/dev/null | head -n 1)
	fi
	if [ -n "$uip" ]; then
		echo "$uip"
		return 0
	fi
	uci -q get network.lan.ipaddr 2>/dev/null | cut -d/ -f1 || echo "192.168.1.1"
}

write_instant_status_cache() {
	get_mesh_cfg
	local role pair_rem radio chan htmode lip lmac lname bmodel searching=false has_dir=false wifi_js up_gw
	role=$(get_active_role)
	pair_rem=$(get_pairing_remaining)
	radio=$(get_best_mesh_radio)
	chan=$(uci -q get "wireless.${radio}.channel" || echo "36")
	htmode=$(uci -q get "wireless.${radio}.htmode" || echo "HE160")
	lip=$(get_node_ip)
	up_gw=$(get_upstream_gateway)
	lmac=$(tr 'a-z' 'A-Z' < /sys/class/net/br-lan/address 2>/dev/null || echo "00:00:00:00:00:00")
	lname=$(uci -q get system.@system[0].hostname || echo "DOANDUY")
	bmodel=$(cat /tmp/sysinfo/model 2>/dev/null || echo "Router DOANDUY")
	wifi_js=$(get_wifi_summary_json)
	if [ -s "$CACHE_FILE" ]; then
		[ "$(jsonfilter -i "$CACHE_FILE" -e '@.has_internet' 2>/dev/null)" = "true" ] && has_dir=true
	fi
	if [ "$role" = "searching_node" ] || [ "$role" = "controller" ]; then
		searching=true
	fi
	cat <<EOF > "${CACHE_FILE}.tmp"
{
  "success": true,
  "ts": $(date +%s),
  "enabled": $([ "$CFG_ENABLED" = "1" ] && echo true || echo false),
  "role": "$(json_esc "$role")",
  "searching": $searching,
  "search_remaining": ${pair_rem:-0},
  "mesh_ssid": "$(json_esc "$CFG_SSID")",
  "channel": "$(json_esc "$chan")",
  "htmode": "$(json_esc "$htmode")",
  "local_ip": "$(json_esc "$lip")",
  "local_mac": "$(json_esc "$lmac")",
  "local_name": "$(json_esc "$lname")",
  "board_model": "$(json_esc "$bmodel")",
  "master_ip": "$(json_esc "$up_gw")",
  "master_model": "$(json_esc "$bmodel")",
  "master_name": "$(json_esc "$lname")",
  "has_internet": $has_dir,
  "wifi": $wifi_js,
  "peer_count": 0,
  "peers": []
}
EOF
	mv -f "${CACHE_FILE}.tmp" "$CACHE_FILE" 2>/dev/null
	[ -L /www/mesh_topology.json ] || ln -sf "$CACHE_FILE" /www/mesh_topology.json 2>/dev/null || true
}

ensure_mesh_uci() {
	mkdir -p /etc/config /var/lock /tmp 2>/dev/null
	[ -f "/etc/config/$MESH_UCI" ] || touch "/etc/config/$MESH_UCI"
	if ! uci -q get "${MESH_UCI}.mesh" >/dev/null 2>&1; then
		uci -q set "${MESH_UCI}.mesh=mesh"
		uci -q set "${MESH_UCI}.mesh.enabled=1"
		uci -q set "${MESH_UCI}.mesh.mode=auto"
		uci -q set "${MESH_UCI}.mesh.node_ip=${DEFAULT_NODE_IP}"
		uci -q set "${MESH_UCI}.mesh.ssid=${DEFAULT_MESH_SSID}"
		uci -q set "${MESH_UCI}.mesh.key=${DEFAULT_MESH_KEY}"
		uci -q set "${MESH_UCI}.mesh.wifi_sync_mode=master"
		uci -q commit "$MESH_UCI"
	elif [ -z "$(uci -q get "${MESH_UCI}.mesh.wifi_sync_mode" 2>/dev/null)" ]; then
		uci -q set "${MESH_UCI}.mesh.wifi_sync_mode=master"
		uci -q commit "$MESH_UCI"
	fi
}

get_mesh_cfg() {
	ensure_mesh_uci
	CFG_ENABLED=$(uci -q get "${MESH_UCI}.mesh.enabled" 2>/dev/null)
	[ -z "$CFG_ENABLED" ] && CFG_ENABLED="1"
	CFG_MODE=$(uci -q get "${MESH_UCI}.mesh.mode" 2>/dev/null)
	[ -z "$CFG_MODE" ] && CFG_MODE="auto"
	CFG_NODE_IP=$(uci -q get "${MESH_UCI}.mesh.node_ip" 2>/dev/null)
	[ -z "$CFG_NODE_IP" ] && CFG_NODE_IP="$DEFAULT_NODE_IP"
	CFG_SSID=$(uci -q get "${MESH_UCI}.mesh.ssid" 2>/dev/null)
	[ -z "$CFG_SSID" ] && CFG_SSID="$DEFAULT_MESH_SSID"
	CFG_KEY=$(uci -q get "${MESH_UCI}.mesh.key" 2>/dev/null)
	[ -z "$CFG_KEY" ] && CFG_KEY="$DEFAULT_MESH_KEY"
	CFG_WIFI_SYNC_MODE=$(uci -q get "${MESH_UCI}.mesh.wifi_sync_mode" 2>/dev/null)
	[ -z "$CFG_WIFI_SYNC_MODE" ] && CFG_WIFI_SYNC_MODE="master"
}

# Tìm netdev interface đang chạy của một UCI radio (OpenWrt 25.12 iwinfo cần tên interface thay vì radioX)
get_radio_ifname() {
	local radio="$1" wif="" ifc
	[ -n "$radio" ] || return 0
	if command -v ubus >/dev/null 2>&1; then
		wif=$(ubus call network.wireless status 2>/dev/null | jsonfilter -e "@.${radio}.interfaces[0].ifname" 2>/dev/null)
		if [ -n "$wif" ] && [ -d "/sys/class/net/$wif" ]; then
			echo "$wif"
			return 0
		fi
	fi
	for ifc in $(uci show wireless 2>/dev/null | sed -n 's/^wireless\.\([^.=]*\)=wifi-iface$/\1/p'); do
		if [ "$(uci -q get "wireless.${ifc}.device")" = "$radio" ]; then
			wif=$(uci -q get "wireless.${ifc}.ifname")
			if [ -n "$wif" ] && [ -d "/sys/class/net/$wif" ]; then
				echo "$wif"
				return 0
			fi
		fi
	done
	local idx="${radio#radio}"
	for wif in "phy${idx}-ap0" "phy${idx}-sta0"; do
		if [ -d "/sys/class/net/$wif" ]; then
			echo "$wif"
			return 0
		fi
	done
}

# Ánh xạ ngược netdev interface (vd phy2-ap0) -> UCI wifi-device (vd radio2)
get_radio_for_ifname() {
	local w_if="$1" dev ifc phy_name idx
	[ -n "$w_if" ] || return 0
	if command -v ubus >/dev/null 2>&1; then
		local ws
		ws=$(ubus call network.wireless status 2>/dev/null)
		for dev in $(uci show wireless 2>/dev/null | sed -n 's/^wireless\.\([^.=]*\)=wifi-device$/\1/p'); do
			if printf '%s' "$ws" | jsonfilter -e "@.${dev}.interfaces[*].ifname" 2>/dev/null | grep -qx "$w_if"; then
				echo "$dev"
				return 0
			fi
		done
	fi
	for ifc in $(uci show wireless 2>/dev/null | sed -n 's/^wireless\.\([^.=]*\)=wifi-iface$/\1/p'); do
		if [ "$(uci -q get "wireless.${ifc}.ifname")" = "$w_if" ]; then
			uci -q get "wireless.${ifc}.device"
			return 0
		fi
	done
	case "$w_if" in
		phy[0-9]*-*)
			phy_name="${w_if%%-*}"
			idx="${phy_name#phy}"
			if [ -n "$(uci -q get "wireless.radio${idx}")" ]; then
				echo "radio${idx}"
				return 0
			fi
			;;
	esac
}

get_phy_for_radio() {
	local radio="$1" wif phy_num
	wif=$(get_radio_ifname "$radio")
	if [ -n "$wif" ] && command -v iw >/dev/null 2>&1; then
		phy_num=$(iw dev "$wif" info 2>/dev/null | awk '/wiphy /{print $2; exit}')
		if [ -n "$phy_num" ] && [ -d "/sys/class/ieee80211/phy${phy_num}" ]; then
			echo "phy${phy_num}"
			return 0
		fi
	fi
	local idx="${radio#radio}"
	[ -d "/sys/class/ieee80211/phy${idx}" ] && echo "phy${idx}"
}

# Kiểm tra radio có thực sự hỗ trợ kênh mục tiêu (tránh ép kênh 36 lên radio 5G High-band 100-165 trên router 3 băng tần)
radio_supports_channel() {
	local radio="$1" chan="$2" wif flist phy chout line band
	[ -n "$chan" ] || return 0
	[ -n "$radio" ] || return 1

	wif=$(get_radio_ifname "$radio")
	if [ -n "$wif" ] && command -v iwinfo >/dev/null 2>&1; then
		flist=$(iwinfo "$wif" freqlist 2>/dev/null)
		if [ -n "$flist" ]; then
			printf '%s\n' "$flist" | grep -qE "Channel ${chan}([^0-9]|$)" && return 0 || return 1
		fi
	fi

	phy=$(get_phy_for_radio "$radio")
	if [ -n "$phy" ] && command -v iw >/dev/null 2>&1; then
		chout=$(iw phy "$phy" channels 2>/dev/null)
		if [ -n "$chout" ]; then
			line=$(printf '%s\n' "$chout" | grep -E "\[$chan\]($|[^0-9])" | head -n 1)
			[ -n "$line" ] || return 1
			printf '%s' "$line" | grep -q '(disabled)' && return 1
			return 0
		fi
	fi

	band=$(uci -q get "wireless.${radio}.band")
	if [ "$chan" -le 14 ] 2>/dev/null; then
		[ "$band" = "2g" ] && return 0 || return 1
	else
		[ "$band" = "5g" ] || [ "$band" = "6g" ] && return 0 || return 1
	fi
}

# Tự động phục hồi nếu trước đó có radio bị gán nhầm kênh không hỗ trợ (vd radio0 5G-High bị kẹt ở kênh 36)
heal_invalid_radio_channels() {
	local dev cur_c healed=0
	for dev in $(uci show wireless 2>/dev/null | sed -n 's/^wireless\.\([^.=]*\)=wifi-device$/\1/p'); do
		cur_c=$(uci -q get "wireless.${dev}.channel")
		case "$cur_c" in ''|auto|0) continue ;; esac
		if ! radio_supports_channel "$dev" "$cur_c"; then
			uci -q set "wireless.${dev}.channel=auto"
			healed=1
		fi
	done
	echo "$healed"
}

# Chọn card Wi-Fi có băng thông & tốc độ cao nhất tương thích kênh (Ưu tiên 5GHz Low ch36 > 5GHz High > 6GHz)
get_best_mesh_radio() {
	local target_chan="$1" best_radio="" best_prio=0 dev band htmode dis prio
	for dev in $(uci show wireless 2>/dev/null | sed -n 's/^wireless\.\([^.=]*\)=wifi-device$/\1/p'); do
		dis=$(uci -q get "wireless.${dev}.disabled")
		[ "$dis" = "1" ] && continue
		if [ -n "$target_chan" ]; then
			radio_supports_channel "$dev" "$target_chan" || continue
		fi
		band=$(uci -q get "wireless.${dev}.band")
		htmode=$(uci -q get "wireless.${dev}.htmode")
		prio=1
		if [ "$band" = "5g" ]; then
			prio=3
			echo "$htmode" | grep -qE "80" && prio=4
			echo "$htmode" | grep -qE "160|320" && prio=6
			radio_supports_channel "$dev" 36 && prio=$((prio + 2))
		elif [ "$band" = "6g" ]; then
			prio=3
			echo "$htmode" | grep -qE "160|320" && prio=5
		fi
		if [ "$prio" -gt "$best_prio" ]; then
			best_prio="$prio"
			best_radio="$dev"
		fi
	done
	[ -z "$best_radio" ] && best_radio=$(uci show wireless 2>/dev/null | sed -n 's/^wireless\.\([^.=]*\)=wifi-device$/\1/p' | head -n 1)
	[ -z "$best_radio" ] && best_radio="radio0"
	echo "$best_radio"
}

# Chọn radio 5GHz/6GHz KHÁC radio uplink cho Relay AP trên router Tri-Band (tránh nghẽn cùng kênh uplink)
get_best_relay_radio() {
	local uplink_radio="$1" dev dis band
	for dev in $(uci show wireless 2>/dev/null | sed -n 's/^wireless\.\([^.=]*\)=wifi-device$/\1/p'); do
		[ "$dev" = "$uplink_radio" ] && continue
		dis=$(uci -q get "wireless.${dev}.disabled")
		[ "$dis" = "1" ] && continue
		band=$(uci -q get "wireless.${dev}.band")
		if [ "$band" = "5g" ] || [ "$band" = "6g" ]; then
			echo "$dev"
			return 0
		fi
	done
	echo "$uplink_radio"
}

# Tối ưu công suất phát cực đại (Max TX Power) & độ rộng kênh tốc độ cao nhất tương thích kênh
maximize_mesh_radio_perf() {
	local radio="$1" changed=0 drv_type band cur_ht best_ht max_tx hlist wif dev c_country cur_ch ht_candidates
	[ -n "$radio" ] || return 0
	wif=$(get_radio_ifname "$radio")
	[ -n "$wif" ] || wif="$radio"
	drv_type=$(uci -q get "wireless.${radio}.type")
	band=$(uci -q get "wireless.${radio}.band")
	cur_ht=$(uci -q get "wireless.${radio}.htmode")
	cur_ch=$(uci -q get "wireless.${radio}.channel")

	# Mở rộng băng thông tối đa an toàn theo kênh (kênh >= 149 UNII-3 tối đa 80MHz, tránh ép HE160 gây mất RX)
	if { [ "$band" = "5g" ] || [ "$band" = "6g" ]; } && command -v iwinfo >/dev/null 2>&1; then
		hlist=$(iwinfo "$wif" htmodelist 2>/dev/null)
		if [ "$band" = "5g" ] && [ "$cur_ch" -ge 149 ] 2>/dev/null; then
			ht_candidates="EHT80 HE80 VHT80"
		else
			ht_candidates="EHT320 EHT160 HE160 VHT160 EHT80 HE80 VHT80"
		fi
		best_ht=""
		for m in $ht_candidates; do
			if echo " $hlist " | grep -q " $m "; then
				best_ht="$m"
				break
			fi
		done
		if [ -n "$best_ht" ] && [ "$cur_ht" != "$best_ht" ]; then
			if [ "$band" = "5g" ] && [ "$cur_ch" -ge 149 ] 2>/dev/null; then
				uci -q set "wireless.${radio}.htmode=${best_ht}"
				changed=1
			else
				case "$cur_ht" in *160*|*320*) ;; *)
					uci -q set "wireless.${radio}.htmode=${best_ht}"
					changed=1
				;; esac
			fi
		fi
	fi

	# Mở khóa miền tần số trên tất cả các radio đang bật nếu đang để mặc định '00' để đạt Max TX Power
	for dev in $(uci show wireless 2>/dev/null | sed -n 's/^wireless\.\([^.=]*\)=wifi-device$/\1/p'); do
		[ "$(uci -q get "wireless.${dev}.disabled")" = "1" ] && continue
		c_country=$(uci -q get "wireless.${dev}.country")
		if [ -z "$c_country" ] || [ "$c_country" = "00" ]; then
			uci -q set "wireless.${dev}.country=US"
			changed=1
		fi
	done

	# Đẩy công suất phát (txpower) lên mức cao nhất phần cứng hỗ trợ
	if command -v iwinfo >/dev/null 2>&1; then
		max_tx=$(iwinfo "$wif" txpowerlist 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="dBm" && $(i-1)+0>m) m=$(i-1)+0} END{if(m>0) print m}')
		if [ -n "$max_tx" ] && [ "$(uci -q get "wireless.${radio}.txpower")" != "$max_tx" ]; then
			uci -q set "wireless.${radio}.txpower=${max_tx}"
			changed=1
		fi
	fi

	[ "$(uci -q get "wireless.${radio}.cell_density")" != "0" ] && { uci -q set "wireless.${radio}.cell_density=0"; changed=1; }
	[ "$(uci -q get "wireless.${radio}.noscan")" != "1" ] && { uci -q set "wireless.${radio}.noscan=1"; changed=1; }

	if [ "$drv_type" = "mtwifi" ]; then
		[ "$(uci -q get "wireless.${radio}.txburst")" != "1" ] && { uci -q set "wireless.${radio}.txburst=1"; changed=1; }
		[ "$(uci -q get "wireless.${radio}.beamforming")" != "1" ] && { uci -q set "wireless.${radio}.beamforming=1"; changed=1; }
	else
		[ "$(uci -q get "wireless.${radio}.he_su_beamformer")" != "1" ] && { uci -q set "wireless.${radio}.he_su_beamformer=1"; changed=1; }
		[ "$(uci -q get "wireless.${radio}.he_mu_beamformer")" != "1" ] && { uci -q set "wireless.${radio}.he_mu_beamformer=1"; changed=1; }
		[ "$(uci -q get "wireless.${radio}.su_beamformer")" != "1" ] && { uci -q set "wireless.${radio}.su_beamformer=1"; changed=1; }
		[ "$(uci -q get "wireless.${radio}.mu_beamformer")" != "1" ] && { uci -q set "wireless.${radio}.mu_beamformer=1"; changed=1; }
		[ "$(uci -q get "wireless.${radio}.ldpc")" != "1" ] && { uci -q set "wireless.${radio}.ldpc=1"; changed=1; }
	fi

	# Bật STP trên br-lan (forward_delay 2s) để chống vòng lặp khi chạy đa tầng mà không chờ 30s
	if [ -f /sys/class/net/br-lan/bridge/stp_state ]; then
		echo 1 > /sys/class/net/br-lan/bridge/stp_state 2>/dev/null || true
		echo 200 > /sys/class/net/br-lan/bridge/forward_delay 2>/dev/null || true
	fi

	echo "$changed"
}

check_direct_internet() {
	DIRECT_SRC=""
	local iface st up l3 d
	if command -v ubus >/dev/null 2>&1; then
		for iface in duydoan_5g wan wan6 modem wwan; do
			st=$(ubus call "network.interface.${iface}" status 2>/dev/null)
			[ -n "$st" ] || continue
			up=$(echo "$st" | jsonfilter -e '@.up' 2>/dev/null)
			[ "$up" = "true" ] || continue
			l3=$(echo "$st" | jsonfilter -e '@.l3_device' 2>/dev/null)
			case "$l3" in ""|br-lan|lo) continue ;; esac
			if [ -d "/sys/class/net/$l3" ]; then
				if ping -4 -I "$l3" -c 1 -W 1 1.1.1.1 >/dev/null 2>&1 || \
				   ping -4 -I "$l3" -c 1 -W 1 8.8.8.8 >/dev/null 2>&1; then
					DIRECT_SRC="${iface} (${l3})"
					return 0
				fi
			fi
		done
	fi
	for d in wwan0 mhi_hwip0 rmnet_mhi0.1 usb0 eth2 pppoe-wan; do
		[ -d "/sys/class/net/$d" ] || continue
		ip -4 addr show dev "$d" 2>/dev/null | grep -q 'inet ' || continue
		if ping -4 -I "$d" -c 1 -W 1 1.1.1.1 >/dev/null 2>&1 || \
		   ping -4 -I "$d" -c 1 -W 1 8.8.8.8 >/dev/null 2>&1; then
			DIRECT_SRC="$d"
			return 0
		fi
	done
	return 1
}

get_all_local_macs() {
	local f m list=","
	for f in /sys/class/net/*/address; do
		[ -f "$f" ] || continue
		m=$(tr 'a-z' 'A-Z' < "$f" 2>/dev/null)
		[ -n "$m" ] && list="${list}${m},"
	done
	echo "$list"
}

get_mac_seed_oct() {
	local mac last_hex dec
	mac=$(cat /sys/class/net/br-lan/address 2>/dev/null || cat /sys/class/net/eth0/address 2>/dev/null || echo "00:00:00:00:00:42")
	last_hex="${mac##*:}"
	dec=$(printf '%d' "0x${last_hex}" 2>/dev/null || echo 66)
	echo "${dec:-66}"
}

# Quét tất cả trạm Mesh xung quanh: ƯU TIÊN SỐ 1 nối trực tiếp Router Chính (DOANDUY_MESH >= -78dBm),
# chỉ nối tiếp qua Router Phụ (DOANDUY_MESH_R) nếu Router Chính ngoài tầm phủ sóng!
scan_for_master_mesh() {
	FOUND_MESH_SSID=""
	FOUND_MESH_CHAN=""
	FOUND_MESH_BSSID=""
	FOUND_MESH_RADIO=""
	FOUND_MESH_TIER="1"
	local cand_ifs="" dev w_if raw my_macs best_line best_score=-9999 best_out="" best_wif="" score
	local relay_ssid="${CFG_SSID}_R"
	my_macs=$(get_all_local_macs)

	for dev in $(uci show wireless 2>/dev/null | sed -n 's/^wireless\.\([^.=]*\)=wifi-device$/\1/p'); do
		[ "$(uci -q get "wireless.${dev}.disabled")" = "1" ] && continue
		w_if=$(get_radio_ifname "$dev")
		[ -n "$w_if" ] && case " $cand_ifs " in *" $w_if "*) ;; *) cand_ifs="$cand_ifs $w_if" ;; esac
	done
	for w_if in $(iw dev 2>/dev/null | awk '/Interface/{print $2}') rax0 ra0 wlan1 wlan0 phy0-ap0 phy1-ap0 phy2-ap0; do
		if [ -d "/sys/class/net/$w_if" ]; then
			case " $cand_ifs " in *" $w_if "*) ;; *) cand_ifs="$cand_ifs $w_if" ;; esac
		fi
	done

	for w_if in $cand_ifs; do
		[ -n "$w_if" ] || continue
		raw=""
		best_line=""
		if command -v iwinfo >/dev/null 2>&1; then
			raw=$(iwinfo "$w_if" scan 2>/dev/null)
			if [ -n "$raw" ]; then
				best_line=$(printf '%s\n' "$raw" | awk -v s1="$CFG_SSID" -v s2="$LEGACY_MESH_SSID" -v s3="$relay_ssid" -v own="$my_macs" '
					BEGIN { best_score=-9999; bssid=""; essid=""; chan=""; sig=-95 }
					function flush_cell() {
						if ((essid == s1 || essid == s2 || essid == s3) && bssid != "" && index(own, "," bssid ",") == 0) {
							s = sig + 0
							tier = ((essid == s1 || essid == s2) && s >= -78) ? 1 : 2
							sc = (tier == 1 ? 1000 : 0) + s
							if (sc > best_score) {
								best_score = sc
								best_out = essid "|" (chan != "" ? chan : "36") "|" bssid "|" s "|" tier "|" sc
							}
						}
					}
					/^Cell / { flush_cell(); bssid=toupper($NF); essid=""; chan=""; sig=-95 }
					/ESSID:/ {
						p = index($0, "\"")
						if (p > 0) {
							rest = substr($0, p + 1)
							q = index(rest, "\"")
							if (q > 0) essid = substr(rest, 1, q - 1)
						}
					}
					/Channel:/ { chan = $NF; gsub(/[^0-9]/, "", chan) }
					/Signal:/ {
						for (i = 1; i <= NF; i++) if ($i == "Signal:") { sig = $(i+1); gsub(/[^0-9-]/, "", sig) }
					}
					END { flush_cell(); if (best_out != "") print best_out }
				')
			fi
		fi

		if [ -z "$best_line" ] && command -v iw >/dev/null 2>&1 && [ -d "/sys/class/net/$w_if" ]; then
			ip link set "$w_if" up 2>/dev/null || true
			raw=$(iw dev "$w_if" scan 2>/dev/null)
			if [ -n "$raw" ]; then
				best_line=$(printf '%s\n' "$raw" | awk -v s1="$CFG_SSID" -v s2="$LEGACY_MESH_SSID" -v s3="$relay_ssid" -v own="$my_macs" '
					BEGIN { best_score=-9999; bssid=""; essid=""; chan=""; sig=-95 }
					function flush_bss() {
						if ((essid == s1 || essid == s2 || essid == s3) && bssid != "" && index(own, "," bssid ",") == 0) {
							s = sig + 0
							tier = ((essid == s1 || essid == s2) && s >= -78) ? 1 : 2
							sc = (tier == 1 ? 1000 : 0) + s
							if (sc > best_score) {
								best_score = sc
								best_out = essid "|" (chan != "" ? chan : "36") "|" bssid "|" s "|" tier "|" sc
							}
						}
					}
					/^BSS / { flush_bss(); split($2, a, "("); bssid=toupper(a[1]); essid=""; chan=""; sig=-95 }
					/^[[:space:]]*SSID: / { sub(/^[[:space:]]*SSID: /, ""); essid=$0 }
					/primary channel:/ { chan=$NF; gsub(/[^0-9]/, "", chan) }
					/^[[:space:]]*signal:/ { sig=$2; sub(/\..*/, "", sig) }
					END { flush_bss(); if (best_out != "") print best_out }
				')
			fi
		fi

		if [ -n "$best_line" ]; then
			score=$(printf '%s' "$best_line" | cut -d'|' -f6)
			if [ "${score:--9999}" -gt "$best_score" ] 2>/dev/null; then
				best_score="$score"
				best_out="$best_line"
				best_wif="$w_if"
			fi
		fi
	done

	if [ -n "$best_out" ]; then
		FOUND_MESH_SSID=$(printf '%s' "$best_out" | cut -d'|' -f1)
		FOUND_MESH_CHAN=$(printf '%s' "$best_out" | cut -d'|' -f2)
		FOUND_MESH_BSSID=$(printf '%s' "$best_out" | cut -d'|' -f3)
		FOUND_MESH_TIER=$(printf '%s' "$best_out" | cut -d'|' -f5)
		[ -z "$FOUND_MESH_TIER" ] && FOUND_MESH_TIER="1"
		FOUND_MESH_RADIO=$(get_radio_for_ifname "$best_wif")
		return 0
	fi
	return 1
}

# Cấp phát IP không đụng hàng khi mới ghép (.50..99 băm theo MAC) rồi tự xếp tuần tự (.10, .11, .12 ... .49)
pick_free_node_ip() {
	local cur_lan my_macs arp_mac oct cand seed
	cur_lan=$(get_node_ip)
	my_macs=$(get_all_local_macs | tr 'A-Z' 'a-z')

	case "$cur_lan" in
		192.168.1.[1-4][0-9])
			arp_mac=$(awk -v ip="$cur_lan" '$1==ip && $3!="0x0" {print tolower($4)}' /proc/net/arp 2>/dev/null | head -n 1)
			case "$my_macs" in
				*,"${arp_mac}",*) echo "$cur_lan"; return 0 ;;
			esac
			if [ -z "$arp_mac" ]; then
				echo "$cur_lan"
				return 0
			fi
			;;
	esac

	local up_dev real_lan
	real_lan=$(uci -q get network.lan.ipaddr 2>/dev/null | cut -d/ -f1)
	up_dev=$(ubus call network.interface.mesh_uplink status 2>/dev/null | jsonfilter -e '@.l3_device' 2>/dev/null)
	if [ "$real_lan" != "192.168.1.1" ] && [ -n "$up_dev" ] && ping -I "$up_dev" -c 1 -W 1 192.168.1.1 >/dev/null 2>&1; then
		for oct in $(seq 10 49); do
			cand="192.168.1.${oct}"
			if ! ping -c 1 -W 1 "$cand" >/dev/null 2>&1; then
				echo "$cand"
				return 0
			fi
			arp_mac=$(awk -v ip="$cand" '$1==ip && $3!="0x0" {print tolower($4)}' /proc/net/arp 2>/dev/null | head -n 1)
			case "$my_macs" in
				*,"${arp_mac}",*) echo "$cand"; return 0 ;;
			esac
		done
	fi

	seed=$(get_mac_seed_oct)
	echo "192.168.1.$((50 + (seed % 50)))"
}

flush_secondary_node_ips() {
	local ip_cidr ip_only
	for ip_cidr in $(ip -4 addr show dev br-lan 2>/dev/null | awk '/inet 192\.168\.1\./{print $2}'); do
		ip_only="${ip_cidr%%/*}"
		case "$ip_only" in
			192.168.1.1|"$RESCUE_IP") ;;
			*) ip addr del "$ip_cidr" dev br-lan 2>/dev/null || true ;;
		esac
	done
}

start_pairing_window() {
	local dur="${1:-$PAIR_WINDOW_SEC}"
	rm -f "$IDLE_FLAG_FILE" "$LOST_TS_FILE"
	echo $(( $(date +%s) + dur )) > "$PAIR_UNTIL_FILE"
}

get_pairing_remaining() {
	[ -f "$PAIR_UNTIL_FILE" ] || { echo 0; return 0; }
	local until now_s rem
	until=$(cat "$PAIR_UNTIL_FILE" 2>/dev/null || echo 0)
	now_s=$(date +%s)
	rem=$((until - now_s))
	[ "$rem" -gt 0 ] && echo "$rem" || echo 0
}

get_active_role() {
	get_mesh_cfg
	[ "$CFG_ENABLED" = "0" ] || [ "$CFG_MODE" = "standalone" ] && { echo "standalone"; return 0; }
	if [ -n "$(uci -q get wireless.mesh_sta)" ] && [ "$(uci -q get wireless.mesh_sta.disabled)" != "1" ]; then
		echo "node"
		return 0
	fi
	if [ -n "$(uci -q get network.mesh_uplink)" ]; then
		echo "node"
		return 0
	fi
	if [ "$(uci -q get dhcp.lan.ignore)" = "1" ] && [ "$(uci -q get network.lan.ipaddr)" != "192.168.1.1" ]; then
		echo "node"
		return 0
	fi
	if [ -n "$(uci -q get wireless.mesh_backhaul_ap)" ] && [ "$(uci -q get wireless.mesh_backhaul_ap.disabled)" != "1" ]; then
		echo "controller"
		return 0
	fi
	echo "searching_node"
}

configure_roaming_on_user_aps() {
	local iface mode dev drv_type enc changed=0
	for iface in $(uci show wireless 2>/dev/null | sed -n 's/^wireless\.\([^.=]*\)=wifi-iface$/\1/p'); do
		case "$iface" in mesh_backhaul_ap|mesh_sta) continue ;; esac
		mode=$(uci -q get "wireless.${iface}.mode")
		[ "$mode" = "ap" ] || continue
		dev=$(uci -q get "wireless.${iface}.device")
		drv_type=$(uci -q get "wireless.${dev}.type")
		enc=$(uci -q get "wireless.${iface}.encryption")
		[ "$drv_type" = "mtwifi" ] && continue

		# L3 NAT Mesh: tắt 802.11r (tránh giữ IP subnet cũ), bật 802.11k/v + BSS Transition
		[ "$(uci -q get "wireless.${iface}.ieee80211r")" = "1" ] && {
			uci -q set "wireless.${iface}.ieee80211r=0"
			changed=1
		}
		case "$enc" in
			psk2*|psk-mixed*|sae*)
				if [ "$(uci -q get "wireless.${iface}.ieee80211k")" != "1" ] || \
				   [ "$(uci -q get "wireless.${iface}.ieee80211v")" != "1" ] || \
				   [ "$(uci -q get "wireless.${iface}.bss_transition")" != "1" ] || \
				   [ "$(uci -q get "wireless.${iface}.ieee80211w")" = "1" ]; then
					uci -q set "wireless.${iface}.ieee80211k=1"
					uci -q set "wireless.${iface}.ieee80211v=1"
					uci -q set "wireless.${iface}.bss_transition=1"
					uci -q set "wireless.${iface}.ieee80211w=0"
					changed=1
				fi
				;;
		esac
	done
	echo "$changed"
}

apply_controller_role() {
	get_mesh_cfg
	local radio cur_ip cur_ignore net_changed=0 wifi_changed=0 cur_ch dhcp_start
	radio=$(get_best_mesh_radio)
	cur_ip=$(uci -q get network.lan.ipaddr)
	cur_ignore=$(uci -q get dhcp.lan.ignore)
	rm -f "$LOST_TS_FILE"

	if [ "$cur_ip" != "192.168.1.1" ] || [ -n "$(uci -q get network.lan.gateway)" ] || [ -n "$(uci -q get network.mesh_uplink)" ]; then
		uci -q delete network.mesh_uplink
		uci -q delete network.lan.gateway
		uci -q delete network.lan.dns
		uci -q delete network.lan.metric
		uci set network.lan.ipaddr='192.168.1.1'
		uci set network.lan.netmask='255.255.255.0'
		uci set network.lan.force_link='1'
		net_changed=1
	fi
	if [ -n "$(uci -q get firewall.mesh_uplink_zone)" ] || [ -n "$(uci -q get firewall.mesh_lan_to_uplink)" ] || [ -n "$(uci -q get firewall.mesh_uplink_to_lan)" ]; then
		uci -q delete firewall.mesh_uplink_zone
		uci -q delete firewall.mesh_lan_to_uplink
		uci -q delete firewall.mesh_uplink_to_lan
		uci commit firewall
		/etc/init.d/firewall reload >/dev/null 2>&1 || true
	fi
	if [ "$(uci -q get network.lan_rescue.ipaddr)" != "$RESCUE_IP" ]; then
		uci set network.lan_rescue=interface
		uci set network.lan_rescue.device='br-lan'
		uci set network.lan_rescue.proto='static'
		uci set network.lan_rescue.ipaddr="$RESCUE_IP"
		uci set network.lan_rescue.netmask='255.255.255.0'
		uci set network.lan_rescue.force_link='1'
		net_changed=1
	fi
	[ "$net_changed" = "1" ] && uci commit network

	# Giữ dải 192.168.1.10..99 dành riêng cho các Router Phụ, DHCP cấp từ .100 trở lên
	dhcp_start=$(uci -q get dhcp.lan.start 2>/dev/null || echo 100)
	if [ "$cur_ignore" = "1" ] || [ "${dhcp_start:-100}" -lt 100 ]; then
		uci set dhcp.lan.ignore='0'
		[ "${dhcp_start:-100}" -lt 100 ] && uci set dhcp.lan.start='100'
		uci commit dhcp
		net_changed=1
	fi

	for mi in mesh_sta mesh_80211s; do
		if [ -n "$(uci -q get "wireless.${mi}")" ]; then
			uci -q delete "wireless.${mi}"
			wifi_changed=1
		fi
	done

	cur_ch=$(uci -q get "wireless.${radio}.channel")
	if [ -z "$cur_ch" ] || [ "$cur_ch" = "auto" ] || [ "$cur_ch" = "0" ]; then
		local b=$(uci -q get "wireless.${radio}.band")
		if [ "$b" = "5g" ]; then
			uci set "wireless.${radio}.channel=36"
			wifi_changed=1
		elif [ "$b" = "2g" ]; then
			uci set "wireless.${radio}.channel=6"
			wifi_changed=1
		fi
	fi

	[ "$(maximize_mesh_radio_perf "$radio")" = "1" ] && wifi_changed=1

	if [ "$(uci -q get wireless.mesh_backhaul_ap.ssid)" != "$CFG_SSID" ] || \
	   [ "$(uci -q get wireless.mesh_backhaul_ap.disabled)" = "1" ] || \
	   [ "$(uci -q get wireless.mesh_backhaul_ap.wds)" != "0" ] || \
	   [ "$(uci -q get wireless.mesh_backhaul_ap.device)" != "$radio" ]; then
		uci -q delete wireless.mesh_backhaul_ap
		uci set wireless.mesh_backhaul_ap=wifi-iface
		uci set wireless.mesh_backhaul_ap.device="$radio"
		uci set wireless.mesh_backhaul_ap.mode='ap'
		uci set wireless.mesh_backhaul_ap.network='lan'
		uci set wireless.mesh_backhaul_ap.ssid="$CFG_SSID"
		uci set wireless.mesh_backhaul_ap.encryption='psk2'
		uci set wireless.mesh_backhaul_ap.key="$CFG_KEY"
		uci set wireless.mesh_backhaul_ap.wds='0'
		uci set wireless.mesh_backhaul_ap.hidden='0'
		uci set wireless.mesh_backhaul_ap.disabled='0'
		wifi_changed=1
	fi

	if [ -f "$WIFI_HELPER" ] && command -v lua >/dev/null 2>&1; then
		lua "$WIFI_HELPER" restore_orig >/dev/null 2>&1
		if [ "$?" -eq 2 ]; then
			wifi_changed=1
			log_mesh "Thiết bị lên Router Chính -> Khôi phục Wi-Fi mặc định ban đầu trước khi phát sóng."
		fi
	fi

	[ "$(configure_roaming_on_user_aps)" = "1" ] && wifi_changed=1

	if [ "$net_changed" = "1" ]; then
		flush_secondary_node_ips
		ip addr add 192.168.1.1/24 dev br-lan 2>/dev/null || true
		ip addr add "${RESCUE_IP}/24" dev br-lan 2>/dev/null || true
		ip route del default via 192.168.1.1 dev br-lan 2>/dev/null || true
		/etc/init.d/network reload >/dev/null 2>&1 || true
		/etc/init.d/dnsmasq restart >/dev/null 2>&1 || true
		log_mesh "Thiết lập ROUTER CHÍNH (IP 192.168.1.1, công suất sóng Mesh tối đa trên $radio)."
	fi

	if [ "$wifi_changed" = "1" ]; then
		uci commit wireless
		safe_wifi_reload 1
	fi
}

# Tự động giải quyết trùng IP & chuyển từ IP tạm (.50..99) sang IP tuần tự chính thức (.10, .11, .12 ... .49)
verify_unique_node_ip() {
	[ "$(uci -q get network.mesh_uplink.proto)" = "dhcp" ] && return 0
	local cur_ip my_macs dup=0 oct new_ip up_dev up_gw prefix mtopo owner_mac cur_oct
	cur_ip=$(get_node_ip)
	up_gw=$(get_upstream_gateway)
	prefix="${up_gw%.*}"
	my_macs=$(get_all_local_macs)
	up_dev=$(ubus call network.interface.mesh_uplink status 2>/dev/null | jsonfilter -e '@.l3_device' 2>/dev/null)
	[ -n "$up_dev" ] || up_dev="br-lan"
	mtopo=$(fetch_http_fast "http://${up_gw}/mesh_topology.json")

	cur_oct="${cur_ip##*.}"
	if [ "${cur_oct:-0}" -ge 50 ] 2>/dev/null; then
		dup=1
	fi
	if [ "$dup" -eq 0 ] && command -v arping >/dev/null 2>&1; then
		arping -D -I "$up_dev" -c 1 -w 1 "$cur_ip" >/dev/null 2>&1 || dup=1
	fi
	if [ "$dup" -eq 0 ] && [ -n "$mtopo" ]; then
		owner_mac=$(printf '%s' "$mtopo" | jsonfilter -e "@.peers[@.ip='${cur_ip}'].mac" 2>/dev/null | tr 'a-z' 'A-Z' | head -n 1)
		if [ -n "$owner_mac" ]; then
			case "$my_macs" in
				*,"${owner_mac}",*) ;;
				*) dup=1 ;;
			esac
		fi
	fi
	[ "$dup" -eq 1 ] || return 0

	for oct in $(seq 10 49); do
		new_ip="${prefix}.${oct}"
		[ "$new_ip" = "$cur_ip" ] && continue
		[ "$new_ip" = "$up_gw" ] && continue
		if [ -n "$mtopo" ]; then
			owner_mac=$(printf '%s' "$mtopo" | jsonfilter -e "@.peers[@.ip='${new_ip}'].mac" 2>/dev/null | tr 'a-z' 'A-Z' | head -n 1)
			if [ -n "$owner_mac" ]; then
				case "$my_macs" in
					*,"${owner_mac}",*) ;;
					*) continue ;;
				esac
			fi
		fi
		if ! ping -c 1 -W 1 "$new_ip" >/dev/null 2>&1; then
			uci set network.mesh_uplink.ipaddr="$new_ip"
			uci set network.lan.ipaddr="192.168.${oct}.1"
			uci commit network
			/etc/init.d/network reload >/dev/null 2>&1 || true
			/etc/init.d/dnsmasq restart >/dev/null 2>&1 || true
			log_mesh "Cấp phát IP tuần tự chính thức: $new_ip (LAN 192.168.${oct}.1)!"
			return 0
		fi
	done
}

# Bật thêm trạm phát tiếp sóng Mesh (Relay AP: DOANDUY_MESH_R) trên Router Phụ đã thông mạng để hỗ trợ tầng dưới
# Tri-Band tự đẩy Relay AP sang radio 5G riêng khác Uplink để tránh đụng kênh làm giảm nửa băng thông!
ensure_node_relay_ap() {
	get_mesh_cfg
	local uplink_radio radio target_ssid target_key relay_ch changed=0
	uplink_radio=$(uci -q get wireless.mesh_sta.device)
	[ -z "$uplink_radio" ] && uplink_radio=$(get_best_mesh_radio)
	radio=$(get_best_relay_radio "$uplink_radio")
	target_ssid="${CFG_SSID}_R"
	target_key="$CFG_KEY"

	# Router Dual-Band dùng chung 1 radio 5G: đợi kết nối Uplink ổn định (>= 1 chu kỳ) rồi mới dựng Relay AP
	if [ "$radio" = "$uplink_radio" ] && [ ! -f "$HAD_PEER_FILE" ]; then
		return 0
	fi

	if [ "$radio" != "$uplink_radio" ]; then
		relay_ch=$(uci -q get "wireless.${radio}.channel")
		case "$relay_ch" in ''|auto|0)
			if radio_supports_channel "$radio" 149; then
				uci set "wireless.${radio}.channel=149"
				changed=1
			elif radio_supports_channel "$radio" 36; then
				uci set "wireless.${radio}.channel=36"
				changed=1
			fi
		;; *)
			if ! radio_supports_channel "$radio" "$relay_ch"; then
				uci set "wireless.${radio}.channel=auto"
				changed=1
			fi
		;; esac
		[ "$(maximize_mesh_radio_perf "$radio")" = "1" ] && changed=1
	fi

	if [ -f /sys/class/net/br-lan/bridge/stp_state ]; then
		echo 1 > /sys/class/net/br-lan/bridge/stp_state 2>/dev/null || true
		echo 200 > /sys/class/net/br-lan/bridge/forward_delay 2>/dev/null || true
	fi

	if [ "$(uci -q get wireless.mesh_backhaul_ap.ssid)" != "$target_ssid" ] || \
	   [ "$(uci -q get wireless.mesh_backhaul_ap.disabled)" = "1" ] || \
	   [ "$(uci -q get wireless.mesh_backhaul_ap.wds)" != "0" ] || \
	   [ "$(uci -q get wireless.mesh_backhaul_ap.device)" != "$radio" ]; then
		uci -q delete wireless.mesh_backhaul_ap
		uci set wireless.mesh_backhaul_ap=wifi-iface
		uci set wireless.mesh_backhaul_ap.device="$radio"
		uci set wireless.mesh_backhaul_ap.mode='ap'
		uci set wireless.mesh_backhaul_ap.network='lan'
		uci set wireless.mesh_backhaul_ap.ssid="$target_ssid"
		uci set wireless.mesh_backhaul_ap.encryption='psk2'
		uci set wireless.mesh_backhaul_ap.key="$target_key"
		uci set wireless.mesh_backhaul_ap.wds='0'
		uci set wireless.mesh_backhaul_ap.hidden='0'
		uci set wireless.mesh_backhaul_ap.disabled='0'
		changed=1
	fi

	if [ "$changed" = "1" ]; then
		uci commit wireless
		safe_wifi_reload 0
		log_mesh "Router Phụ đã thông mạng -> Bật tiếp sóng Mesh ($target_ssid trên $radio, tách biệt uplink $uplink_radio)."
	fi
}

# Thử dò Gateway tầng trên qua DHCP nếu kết nối L2 đã thông nhưng 192.168.1.1 không phản hồi (hỗ trợ Phụ Mesh Phụ)
probe_tier2_gateway() {
	local sta_if="" pfile="/tmp/dd_t2_probe.env" gw="" ip="" oct sub_lan
	if command -v iw >/dev/null 2>&1; then
		sta_if=$(iw dev 2>/dev/null | awk '/Interface/{i=$2} /type managed/{print i; exit}')
	fi
	[ -n "$sta_if" ] && [ -d "/sys/class/net/$sta_if" ] || return 1
	cat <<'EOS' > /tmp/dd_t2_probe.sh
#!/bin/sh
[ "$1" = "bound" ] || [ "$1" = "renew" ] || exit 0
{
  echo "PROBE_IP=$ip"
  echo "PROBE_GW=$router"
} > /tmp/dd_t2_probe.env
exit 0
EOS
	chmod 755 /tmp/dd_t2_probe.sh
	rm -f "$pfile"
	timeout 4 udhcpc -n -q -t 2 -T 1 -i "$sta_if" -s /tmp/dd_t2_probe.sh >/dev/null 2>&1 || true
	rm -f /tmp/dd_t2_probe.sh
	[ -s "$pfile" ] || return 1
	. "$pfile"
	rm -f "$pfile"
	gw="${PROBE_GW%% *}"
	ip="$PROBE_IP"
	[ -n "$gw" ] && [ -n "$ip" ] && [ "$gw" != "$(get_upstream_gateway)" ] || return 1
	oct="${ip##*.}"
	[ "$oct" -ge 10 ] 2>/dev/null || oct=$(( 110 + (oct % 80) ))
	sub_lan="192.168.${oct}.1"
	[ "$sub_lan" = "${gw%.*}.1" ] && sub_lan="192.168.$(( (oct + 50) % 200 + 20 )).1"
	uci set network.mesh_uplink.ipaddr="$ip"
	uci set network.mesh_uplink.gateway="$gw"
	uci -q delete network.mesh_uplink.dns
	uci add_list network.mesh_uplink.dns="$gw"
	uci add_list network.mesh_uplink.dns='1.1.1.1'
	uci set network.lan.ipaddr="$sub_lan"
	uci commit network
	/etc/init.d/network reload >/dev/null 2>&1 || true
	/etc/init.d/dnsmasq restart >/dev/null 2>&1 || true
	log_mesh "Phát hiện nhánh Mesh đa tầng -> Cập nhật Uplink $ip qua Gateway tầng trên $gw (LAN $sub_lan)."
	return 0
}

apply_node_role() {
	get_mesh_cfg
	local target_ssid="${1:-$CFG_SSID}" target_chan="${2:-36}" target_bssid="$3" target_radio="$4" target_tier="${5:-$FOUND_MESH_TIER}"
	[ -n "$target_tier" ] || target_tier="1"
	local radio target_ip cur_up_ip cur_lan_ip oct sub_lan_ip wifi_changed=0 net_changed=0 fw_changed=0 target_key="$CFG_KEY" seed
	[ "$target_ssid" = "$LEGACY_MESH_SSID" ] && target_key="SysMeshKey@2026!Sec"
	if [ -n "$target_radio" ] && radio_supports_channel "$target_radio" "$target_chan"; then
		radio="$target_radio"
	else
		radio=$(get_best_mesh_radio "$target_chan")
	fi
	[ "$(heal_invalid_radio_channels)" = "1" ] && wifi_changed=1

	if [ "$target_tier" = "2" ]; then
		seed=$(get_mac_seed_oct)
		sub_lan_ip="192.168.$((120 + (seed % 70))).1"
		target_ip=""
	else
		target_ip=$(pick_free_node_ip)
		oct="${target_ip##*.}"
		sub_lan_ip="192.168.${oct}.1"
	fi
	cur_up_ip=$(uci -q get network.mesh_uplink.ipaddr)
	cur_lan_ip=$(uci -q get network.lan.ipaddr)
	rm -f "$LOST_TS_FILE"

	if [ -n "$target_chan" ] && radio_supports_channel "$radio" "$target_chan" && [ "$(uci -q get "wireless.${radio}.channel")" != "$target_chan" ]; then
		uci set "wireless.${radio}.channel=${target_chan}"
		wifi_changed=1
	fi

	[ "$(maximize_mesh_radio_perf "$radio")" = "1" ] && wifi_changed=1

	# Khi mới bắt đầu nối STA, tạm tắt relay AP cho tới khi ping thông uplink để chống loop
	if [ -n "$(uci -q get wireless.mesh_backhaul_ap)" ] && ! ping -c 1 -W 1 "$(get_upstream_gateway)" >/dev/null 2>&1; then
		uci -q delete wireless.mesh_backhaul_ap
		wifi_changed=1
	fi
	if [ -n "$(uci -q get wireless.mesh_80211s)" ]; then
		uci -q delete wireless.mesh_80211s
		wifi_changed=1
	fi

	if [ "$(uci -q get wireless.mesh_sta.ssid)" != "$target_ssid" ] || \
	   [ "$(uci -q get wireless.mesh_sta.disabled)" = "1" ] || \
	   [ "$(uci -q get wireless.mesh_sta.network)" != "mesh_uplink" ] || \
	   [ "$(uci -q get wireless.mesh_sta.wds)" != "0" ] || \
	   [ "$(uci -q get wireless.mesh_sta.device)" != "$radio" ] || \
	   { [ -n "$target_bssid" ] && [ "$(uci -q get wireless.mesh_sta.bssid | tr 'a-z' 'A-Z')" != "$target_bssid" ]; }; then
		uci -q delete wireless.mesh_sta
		uci set wireless.mesh_sta=wifi-iface
		uci set wireless.mesh_sta.device="$radio"
		uci set wireless.mesh_sta.mode='sta'
		uci set wireless.mesh_sta.network='mesh_uplink'
		uci set wireless.mesh_sta.ssid="$target_ssid"
		[ -n "$target_bssid" ] && uci set wireless.mesh_sta.bssid="$target_bssid"
		uci set wireless.mesh_sta.encryption='psk2'
		uci set wireless.mesh_sta.key="$target_key"
		uci set wireless.mesh_sta.wds='0'
		uci set wireless.mesh_sta.disabled='0'
		wifi_changed=1
	fi
	[ "$(configure_roaming_on_user_aps)" = "1" ] && wifi_changed=1

	if [ -n "$(uci -q get network.lan_rescue)" ]; then
		uci -q delete network.lan_rescue
		net_changed=1
	fi

	if [ "$target_tier" = "2" ]; then
		if [ "$(uci -q get network.mesh_uplink.proto)" != "dhcp" ] || [ "$cur_lan_ip" != "$sub_lan_ip" ] || [ -n "$(uci -q get network.lan.gateway)" ]; then
			uci -q delete network.mesh_uplink
			uci set network.mesh_uplink=interface
			uci set network.mesh_uplink.proto='dhcp'
			uci set network.mesh_uplink.metric='50'
			uci set network.mesh_uplink.force_link='1'
			uci -q delete network.lan.gateway
			uci -q delete network.lan.dns
			uci -q delete network.lan.metric
			uci set network.lan.ipaddr="$sub_lan_ip"
			uci set network.lan.netmask='255.255.255.0'
			uci set network.lan.force_link='1'
			uci commit network
			net_changed=1
		fi
	elif [ "$cur_up_ip" != "$target_ip" ] || [ "$cur_lan_ip" != "$sub_lan_ip" ] || [ "$(uci -q get network.mesh_uplink.proto)" != "static" ] || [ "$(uci -q get network.mesh_uplink.gateway)" != "192.168.1.1" ] || [ -n "$(uci -q get network.lan.gateway)" ]; then
		uci -q delete network.mesh_uplink
		uci set network.mesh_uplink=interface
		uci set network.mesh_uplink.proto='static'
		uci set network.mesh_uplink.ipaddr="$target_ip"
		uci set network.mesh_uplink.netmask='255.255.255.0'
		uci set network.mesh_uplink.gateway='192.168.1.1'
		uci add_list network.mesh_uplink.dns='192.168.1.1'
		uci add_list network.mesh_uplink.dns='1.1.1.1'
		uci set network.mesh_uplink.metric='50'
		uci set network.mesh_uplink.force_link='1'

		uci -q delete network.lan.gateway
		uci -q delete network.lan.dns
		uci -q delete network.lan.metric
		uci set network.lan.ipaddr="$sub_lan_ip"
		uci set network.lan.netmask='255.255.255.0'
		uci set network.lan.force_link='1'
		uci commit network
		net_changed=1
	fi

	if [ "$(uci -q get dhcp.lan.ignore)" = "1" ] || [ "$(uci -q get dhcp.lan.leasetime)" != "2h" ]; then
		uci set dhcp.lan.ignore='0'
		uci set dhcp.lan.leasetime='2h'
		uci commit dhcp
		net_changed=1
	fi

	if [ "$(uci -q get firewall.mesh_uplink_zone.name)" != "mesh_uplink" ] || \
	   [ "$(uci -q get firewall.mesh_lan_to_uplink.dest)" != "mesh_uplink" ] || \
	   [ "$(uci -q get firewall.mesh_uplink_to_lan.src)" != "mesh_uplink" ]; then
		uci -q delete firewall.mesh_uplink_zone
		uci -q delete firewall.mesh_lan_to_uplink
		uci -q delete firewall.mesh_uplink_to_lan
		uci set firewall.mesh_uplink_zone=zone
		uci set firewall.mesh_uplink_zone.name='mesh_uplink'
		uci add_list firewall.mesh_uplink_zone.network='mesh_uplink'
		uci set firewall.mesh_uplink_zone.input='ACCEPT'
		uci set firewall.mesh_uplink_zone.output='ACCEPT'
		uci set firewall.mesh_uplink_zone.forward='ACCEPT'
		uci set firewall.mesh_uplink_zone.masq='1'
		uci set firewall.mesh_uplink_zone.mtu_fix='1'
		uci set firewall.mesh_lan_to_uplink=forwarding
		uci set firewall.mesh_lan_to_uplink.src='lan'
		uci set firewall.mesh_lan_to_uplink.dest='mesh_uplink'
		uci set firewall.mesh_uplink_to_lan=forwarding
		uci set firewall.mesh_uplink_to_lan.src='mesh_uplink'
		uci set firewall.mesh_uplink_to_lan.dest='lan'
		uci commit firewall
		fw_changed=1
	fi

	uci -q delete dropbear.main.Interface 2>/dev/null || true
	uci -q delete dropbear.main.DirectInterface 2>/dev/null || true
	uci -q commit dropbear 2>/dev/null || true

	if [ "$fw_changed" = "1" ]; then
		/etc/init.d/firewall reload >/dev/null 2>&1 || true
	fi

	if [ "$net_changed" = "1" ]; then
		( sleep 1; /etc/init.d/network reload >/dev/null 2>&1; /etc/init.d/dnsmasq restart >/dev/null 2>&1; /etc/init.d/dropbear restart >/dev/null 2>&1 ) </dev/null >/dev/null 2>&1 &
		log_mesh "Thiết lập ROUTER PHỤ 3-Addr Mesh (Uplink ${target_ip}, LAN ${sub_lan_ip}, kênh $target_chan, ưu tiên ${target_bssid:-auto})."
	fi

	if [ "$wifi_changed" = "1" ]; then
		uci commit wireless
		safe_wifi_reload 1
	fi
}

restore_default_standalone() {
	local mode_after="${1:-auto}" wifi_changed=0 net_changed=0 fw_changed=0
	ensure_mesh_uci
	rm -f "$LOST_TS_FILE" "$NUDGE_DONE_FILE"
	if [ "$mode_after" = "disabled" ]; then
		uci set "${MESH_UCI}.mesh.enabled=0"
		uci set "${MESH_UCI}.mesh.mode=standalone"
	else
		uci set "${MESH_UCI}.mesh.enabled=1"
		uci set "${MESH_UCI}.mesh.mode=auto"
	fi
	uci commit "$MESH_UCI"

	for mi in mesh_sta mesh_backhaul_ap mesh_80211s mesh_backhaul mesh0 mesh1; do
		if [ -n "$(uci -q get "wireless.${mi}")" ]; then
			uci -q delete "wireless.${mi}"
			wifi_changed=1
		fi
	done
	[ "$(heal_invalid_radio_channels)" = "1" ] && wifi_changed=1

	if [ "$mode_after" = "disabled" ]; then
		for mi in $(uci show wireless 2>/dev/null | sed -n 's/^wireless\.\([^.=]*\)=wifi-iface$/\1/p'); do
			if [ "$(uci -q get "wireless.${mi}.mode")" = "ap" ]; then
				uci -q set "wireless.${mi}.wds=0"
				uci -q set "wireless.${mi}.ieee80211r=0"
				wifi_changed=1
			fi
		done
	fi

	if [ -n "$(uci -q get firewall.mesh_uplink_zone)" ] || [ -n "$(uci -q get firewall.mesh_lan_to_uplink)" ] || [ -n "$(uci -q get firewall.mesh_uplink_to_lan)" ]; then
		uci -q delete firewall.mesh_uplink_zone
		uci -q delete firewall.mesh_lan_to_uplink
		uci -q delete firewall.mesh_uplink_to_lan
		uci commit firewall
		fw_changed=1
	fi

	if [ "$(uci -q get network.lan.ipaddr)" != "192.168.1.1" ] || [ -n "$(uci -q get network.lan.gateway)" ] || [ -n "$(uci -q get network.mesh_uplink)" ]; then
		uci -q delete network.mesh_uplink
		uci -q delete network.lan.gateway
		uci -q delete network.lan.dns
		uci -q delete network.lan.metric
		uci set network.lan.ipaddr='192.168.1.1'
		uci set network.lan.netmask='255.255.255.0'
		uci set network.lan.force_link='1'
		uci commit network
		net_changed=1
	fi

	if [ "$(uci -q get dhcp.lan.ignore)" = "1" ]; then
		uci set dhcp.lan.ignore='0'
		uci commit dhcp
		net_changed=1
	fi

	[ "$fw_changed" = "1" ] && /etc/init.d/firewall reload >/dev/null 2>&1 || true

	if [ -f "$WIFI_HELPER" ] && command -v lua >/dev/null 2>&1; then
		lua "$WIFI_HELPER" restore_orig >/dev/null 2>&1
		if [ "$?" -eq 2 ]; then
			wifi_changed=1
			log_mesh "Đã khôi phục cấu hình Wi-Fi mặc định ban đầu của thiết bị!"
		fi
	fi

	if [ "$net_changed" = "1" ]; then
		flush_secondary_node_ips
		ip addr add 192.168.1.1/24 dev br-lan 2>/dev/null || true
		ip addr add "${RESCUE_IP}/24" dev br-lan 2>/dev/null || true
		ip route del default via 192.168.1.1 dev br-lan 2>/dev/null || true
		/etc/init.d/network reload >/dev/null 2>&1 || true
		/etc/init.d/dnsmasq restart >/dev/null 2>&1 || true
		log_mesh "Đã khôi phục IP mặc định 192.168.1.1 và BẬT lại DHCP!"
	fi

	if [ "$wifi_changed" = "1" ]; then
		uci commit wireless
		safe_wifi_reload 1
	fi
}

get_local_mesh_ap_bssid() {
	local w_if bssid=""
	if command -v iw >/dev/null 2>&1; then
		for w_if in $(iw dev 2>/dev/null | awk '/Interface/{print $2}'); do
			if iw dev "$w_if" info 2>/dev/null | grep -qE "ssid (${CFG_SSID}|${CFG_SSID}_R|${LEGACY_MESH_SSID})$"; then
				bssid=$(iw dev "$w_if" info 2>/dev/null | awk '/addr /{print toupper($2); exit}')
				[ -n "$bssid" ] && break
			fi
		done
	fi
	if [ -z "$bssid" ] && command -v iwinfo >/dev/null 2>&1; then
		for w_if in rax1 rax2 rax0 ra1 ra0; do
			[ -d "/sys/class/net/$w_if" ] || continue
			if iwinfo "$w_if" info 2>/dev/null | grep -qE "ESSID: \"(${CFG_SSID}|${CFG_SSID}_R|${LEGACY_MESH_SSID})\""; then
				bssid=$(iwinfo "$w_if" info 2>/dev/null | awk '/Access Point:/{print toupper($3); exit}')
				[ -n "$bssid" ] && break
			fi
		done
	fi
	echo "$bssid"
}

get_local_uplink_info() {
	local sta_if ubssid="" usig="" urate="" link_out=""
	if command -v iw >/dev/null 2>&1; then
		sta_if=$(iw dev 2>/dev/null | awk '/Interface/{i=$2} /type managed/{print i; exit}')
		if [ -n "$sta_if" ]; then
			link_out=$(iw dev "$sta_if" link 2>/dev/null)
			ubssid=$(printf '%s\n' "$link_out" | awk '/Connected to /{print toupper($3); exit}')
			usig=$(printf '%s\n' "$link_out" | awk '/signal:/{print $2; exit}')
			urate=$(printf '%s\n' "$link_out" | awk '/rx bitrate:|tx bitrate:/{if($3+0 > m) m=$3+0} END{if(m > 6) printf "%.0f Mbps", m}')
		fi
	fi
	if [ -z "$ubssid" ] && command -v iwinfo >/dev/null 2>&1; then
		for sta_if in apclii0 apcli0; do
			[ -d "/sys/class/net/$sta_if" ] || continue
			ubssid=$(iwinfo "$sta_if" info 2>/dev/null | awk '/Access Point:/{if($3!="00:00:00:00:00:00") print toupper($3); exit}')
			if [ -n "$ubssid" ]; then
				usig=$(iwinfo "$sta_if" info 2>/dev/null | awk '/Signal:/{for(i=1;i<=NF;i++) if($i=="Signal:") print $(i+1); exit}')
				urate=$(iwinfo "$sta_if" info 2>/dev/null | awk '/Bit Rate:/{for(i=1;i<=NF;i++) if($i=="Rate:") printf "%.0f Mbps", $(i+1)+0; exit}')
				break
			fi
		done
	fi
	echo "${ubssid}|${usig}|${urate}"
}

fetch_http_fast() {
	local url="$1"
	if command -v uclient-fetch >/dev/null 2>&1; then
		uclient-fetch -q -T 1 -O - "$url" 2>/dev/null
	elif command -v wget >/dev/null 2>&1; then
		wget -q -T 1 -O - "$url" 2>/dev/null
	elif command -v curl >/dev/null 2>&1; then
		curl -fsSL --max-time 1 "$url" 2>/dev/null
	fi
}

# Thu thập cây phân tầng đầy đủ của toàn bộ các Router Phụ (.10, .11, .12, .13, .14 ... .99)
# Tự động xác định parent_ip: nối vào Router Chính -> parent_ip = 192.168.1.1 (Tầng 1); nối vào Router Phụ -> parent_ip = IP máy Phụ đó (Tầng 2, 3...)
get_mesh_peers_json() {
	local role="$1" lip="$2" master_bssid="$3" peer_count=0 peer_list="" up_gw
	up_gw=$(get_upstream_gateway)
	if [ "$role" = "node" ]; then
		# Nếu đang xem trên Router Phụ: lưu cache cây phân tầng từ Router Chính để hiển thị đồng nhất!
		if ping -c 1 -W 1 "$up_gw" >/dev/null 2>&1; then
			local mtopo mpeers mcnt
			mtopo=$(fetch_http_fast "http://${up_gw}/mesh_topology.json")
			if [ -n "$mtopo" ]; then
				printf '%s\n' "$mtopo" > /tmp/master_topo_cache.json
				mcnt=$(jsonfilter -i /tmp/master_topo_cache.json -e '@.peer_count' 2>/dev/null | tr -cd '0-9')
				mpeers=$(awk '/"peers": \[/{flag=1; sub(/.*"peers": /, ""); print; if (/\]/) exit; next} flag{print; if (/\]/) exit}' /tmp/master_topo_cache.json 2>/dev/null | tr '\n' ' ')
				if [ -n "$mpeers" ] && [ "${mcnt:-0}" -gt 0 ]; then
					echo "${mcnt}|${mpeers}"
					return 0
				fi
			fi
			local uinfo usig urate sig_txt
			uinfo=$(get_local_uplink_info)
			usig=$(printf '%s' "$uinfo" | cut -d'|' -f2)
			urate=$(printf '%s' "$uinfo" | cut -d'|' -f3)
			sig_txt="${usig:--45} dBm"
			[ -n "$urate" ] && sig_txt="${sig_txt} • ${urate}"
			peer_count=1
			peer_list="{\"ip\":\"$(json_esc "$lip")\",\"parent_ip\":\"$(json_esc "$up_gw")\",\"mac\":\"$(json_esc "$LOCAL_MAC_CACHE")\",\"name\":\"$(json_esc "$LOCAL_NAME_CACHE")\",\"model\":\"$(json_esc "$LOCAL_MODEL_CACHE")\",\"signal\":\"$(json_esc "$sig_txt")\",\"url\":\"http://${lip}\"}"
			echo "${peer_count}|[${peer_list}]"
			return 0
		fi
		echo "0|[]"
		return 0
	fi

	[ "$role" = "controller" ] || { echo "0|[]"; return 0; }

	local mesh_if="" w_if wds_dump="" wds_cnt=0
	if command -v iw >/dev/null 2>&1; then
		for w_if in $(iw dev 2>/dev/null | awk '/Interface/{print $2}'); do
			if iw dev "$w_if" info 2>/dev/null | grep -qE "ssid (${CFG_SSID}|${LEGACY_MESH_SSID})$"; then
				mesh_if="$w_if"
				break
			fi
		done
		if [ -n "$mesh_if" ]; then
			wds_dump=$(iw dev "$mesh_if" station dump 2>/dev/null)
			for w_if in $(iw dev 2>/dev/null | awk '/Interface/{print $2}' | grep "^${mesh_if}\." 2>/dev/null); do
				wds_dump="${wds_dump}
$(iw dev "$w_if" station dump 2>/dev/null)"
			done
			wds_cnt=$(printf '%s\n' "$wds_dump" | awk '/^Station /{c++} END{print c+0}')
		fi
	fi

	# Không xả bão ping khi idle (wds_cnt == 0 và chưa có ARP .10..99). Chỉ quét .10..24 khi có STA mới chưa vào ARP!
	local arp_ips arp_cnt=0 cand_ips="" oct nip
	arp_ips=$(awk '$1 ~ /^192\.168\.1\.[1-9][0-9]$/ && $3!="0x0" {print $1}' /proc/net/arp 2>/dev/null | sort -u)
	for nip in $arp_ips; do arp_cnt=$((arp_cnt + 1)); done

	if [ "${wds_cnt:-0}" -eq 0 ] && [ "$arp_cnt" -eq 0 ]; then
		echo "0|[]"
		return 0
	fi

	if [ "${wds_cnt:-0}" -gt "$arp_cnt" ]; then
		for oct in $(seq 10 24); do
			cand_ips="$cand_ips 192.168.1.${oct}"
		done
	fi
	cand_ips="$cand_ips $arp_ips"

	for nip in $cand_ips; do
		[ "$nip" = "$lip" ] && continue
		ping -c 1 -W 1 "$nip" >/dev/null 2>&1 &
	done
	wait 2>/dev/null || true

	# Sắp xếp danh sách IP ứng viên tăng dần theo số cuối (10, 11, 12, 13, 14...)
	local sorted_ips tmp_nodes="/tmp/doanduy_mesh_nodes.$$"
	rm -f "$tmp_nodes"
	sorted_ips=$(awk '$1 ~ /^192\.168\.1\.[1-9][0-9]$/ && $3!="0x0" {split($1,a,"."); printf "%03d %s\n", a[4], $1}' /proc/net/arp 2>/dev/null | sort -u | awk '{print $2}')

	local pmeta rmodel rhost rmbssid rubssid rusig nmac
	for nip in $sorted_ips; do
		[ "$nip" = "$lip" ] && continue
		if [ -f /tmp/dhcp.leases ] && awk -v ip="$nip" '$3==ip {found=1} END{exit !found}' /tmp/dhcp.leases 2>/dev/null; then
			continue
		fi
		ping -c 1 -W 1 "$nip" >/dev/null 2>&1 || continue
		nmac=$(awk -v ip="$nip" '$1==ip && $3!="0x0" {print toupper($4)}' /proc/net/arp 2>/dev/null | head -n 1)
		pmeta=$(fetch_http_fast "http://${nip}/mesh_node_info.json")
		if [ -z "$pmeta" ] && [ "${wds_cnt:-0}" -eq 0 ]; then
			continue
		fi
		rmodel=$(printf '%s' "$pmeta" | jsonfilter -e '@.model' 2>/dev/null)
		rhost=$(printf '%s' "$pmeta" | jsonfilter -e '@.hostname' 2>/dev/null)
		rmbssid=$(printf '%s' "$pmeta" | jsonfilter -e '@.mesh_bssid' 2>/dev/null | tr 'a-z' 'A-Z')
		rubssid=$(printf '%s' "$pmeta" | jsonfilter -e '@.uplink_bssid' 2>/dev/null | tr 'a-z' 'A-Z')
		rusig=$(printf '%s' "$pmeta" | jsonfilter -e '@.uplink_signal' 2>/dev/null)
		[ -z "$rusig" ] && rusig=$(printf '%s\n' "$wds_dump" | awk '/signal:/{print $2 " dBm"; exit}')
		[ -z "$rusig" ] && rusig="Online"
		echo "${nip}|${nmac:-NODE}|${rhost}|${rmodel}|${rmbssid}|${rubssid}|${rusig}" >> "$tmp_nodes"
	done

	if [ -f "$tmp_nodes" ]; then
		while IFS='|' read -r nip nmac rhost rmodel rmbssid rubssid rusig; do
			[ -n "$nip" ] || continue
			local parent_ip="192.168.1.1"
			if [ -n "$rubssid" ] && [ "$rubssid" != "$master_bssid" ]; then
				local matched_parent
				matched_parent=$(awk -F'|' -v ub="$rubssid" -v self="$nip" '$1!=self && (($5!="" && $5==ub) || ($2!="" && $2==ub)) {print $1; exit}' "$tmp_nodes")
				[ -n "$matched_parent" ] && parent_ip="$matched_parent"
			fi
			peer_count=$((peer_count + 1))
			[ -z "$rmodel" ] && rmodel="Router Phụ #${peer_count}"
			[ -z "$rhost" ] && rhost="DOANDUY"
			local item="{\"ip\":\"$(json_esc "$nip")\",\"parent_ip\":\"$(json_esc "$parent_ip")\",\"mac\":\"$(json_esc "$nmac")\",\"name\":\"$(json_esc "$rhost")\",\"model\":\"$(json_esc "$rmodel")\",\"signal\":\"$(json_esc "$rusig")\",\"url\":\"http://${nip}\"}"
			[ -z "$peer_list" ] && peer_list="$item" || peer_list="${peer_list},${item}"
		done < "$tmp_nodes"
		rm -f "$tmp_nodes"
	fi

	if [ "$peer_count" -eq 0 ] && [ "${wds_cnt:-0}" -gt 0 ]; then
		local wmac wsig
		wmac=$(printf '%s\n' "$wds_dump" | awk '/^Station /{print toupper($2); exit}')
		wsig=$(printf '%s\n' "$wds_dump" | awk '/signal:/{print $2 " dBm"; exit}')
		peer_count=1
		peer_list="{\"ip\":\"192.168.1.10\",\"parent_ip\":\"192.168.1.1\",\"mac\":\"$(json_esc "${wmac:-WDS}")\",\"name\":\"DOANDUY\",\"model\":\"Router Phụ\",\"signal\":\"$(json_esc "${wsig:--45 dBm}")\",\"url\":\"http://192.168.1.10\"}"
	fi
	echo "${peer_count}|[${peer_list}]"
}

refresh_status_cache() {
	get_mesh_cfg
	local role radio chan htmode lip lmac lname has_dir=false pinfo pcnt pjson
	local bmodel pair_rem searching=false mbssid uinfo ubssid usig urate usig_lbl=""
	local up_gw wifi_js wifi_hash=""

	role=$(get_active_role)
	pair_rem=$(get_pairing_remaining)
	radio=$(get_best_mesh_radio)
	chan=$(uci -q get "wireless.${radio}.channel" || echo "36")
	htmode=$(uci -q get "wireless.${radio}.htmode" || echo "HE160")
	lip=$(get_node_ip)
	up_gw=$(get_upstream_gateway)
	lmac=$(tr 'a-z' 'A-Z' < /sys/class/net/br-lan/address 2>/dev/null || echo "00:00:00:00:00:00")
	lname=$(uci -q get system.@system[0].hostname || echo "DOANDUY")
	bmodel=$(cat /tmp/sysinfo/model 2>/dev/null || echo "Router DOANDUY")
	LOCAL_MAC_CACHE="$lmac"
	LOCAL_NAME_CACHE="$lname"
	LOCAL_MODEL_CACHE="$bmodel"

	mbssid=$(get_local_mesh_ap_bssid)
	uinfo=$(get_local_uplink_info)
	ubssid=$(printf '%s' "$uinfo" | cut -d'|' -f1)
	usig=$(printf '%s' "$uinfo" | cut -d'|' -f2)
	urate=$(printf '%s' "$uinfo" | cut -d'|' -f3)
	if [ -n "$usig" ]; then
		usig_lbl="${usig} dBm"
		[ -n "$urate" ] && usig_lbl="${usig_lbl} • ${urate}"
	fi

	if check_direct_internet; then
		has_dir=true
	elif [ "$role" = "node" ] && ping -c 1 -W 1 "$up_gw" >/dev/null 2>&1; then
		has_dir=true
	fi

	cat <<EOF > /tmp/mesh_node_info.json.tmp
{"role":"$(json_esc "$role")","hostname":"$(json_esc "$lname")","model":"$(json_esc "$bmodel")","ip":"$(json_esc "$lip")","mac":"$(json_esc "$lmac")","mesh_bssid":"$(json_esc "$mbssid")","uplink_bssid":"$(json_esc "$ubssid")","uplink_signal":"$(json_esc "$usig_lbl")"}
EOF
	mv -f /tmp/mesh_node_info.json.tmp /tmp/mesh_node_info.json 2>/dev/null || true
	[ -L /www/mesh_node_info.json ] || ln -sf /tmp/mesh_node_info.json /www/mesh_node_info.json 2>/dev/null || true

	pinfo=$(get_mesh_peers_json "$role" "$lip" "$mbssid")
	pcnt="${pinfo%%|*}"
	pjson="${pinfo#*|}"
	[ -z "$pjson" ] && pjson="[]"

	if [ "$role" = "controller" ] && [ "${pcnt:-0}" -eq 0 ]; then
		searching=true
	elif [ "$role" = "searching_node" ]; then
		searching=true
	fi

	wifi_js=$(get_wifi_summary_json)
	if [ "$role" = "controller" ]; then
		wifi_hash=$(cat /tmp/mesh_wifi_pub_hash 2>/dev/null || true)
	else
		wifi_hash=$(cat /tmp/doanduy_mesh_applied_wifi_hash 2>/dev/null || true)
	fi

	local master_model="$bmodel" master_name="$lname"
	if [ "$role" = "node" ] && [ -s /tmp/master_topo_cache.json ]; then
		master_model=$(jsonfilter -i /tmp/master_topo_cache.json -e '@.board_model' 2>/dev/null)
		master_name=$(jsonfilter -i /tmp/master_topo_cache.json -e '@.local_name' 2>/dev/null)
		[ -z "$master_model" ] && master_model="Router Chính"
		[ -z "$master_name" ] && master_name="DOANDUY"
	elif [ "$role" = "node" ]; then
		master_model="Router Chính"
		master_name="DOANDUY"
	fi

	cat <<EOF > "${CACHE_FILE}.tmp"
{
  "success": true,
  "ts": $(date +%s),
  "enabled": $([ "$CFG_ENABLED" = "1" ] && echo true || echo false),
  "role": "$(json_esc "$role")",
  "searching": $searching,
  "search_remaining": ${pair_rem:-0},
  "mesh_ssid": "$(json_esc "$CFG_SSID")",
  "channel": "$(json_esc "$chan")",
  "htmode": "$(json_esc "$htmode")",
  "local_ip": "$(json_esc "$lip")",
  "local_mac": "$(json_esc "$lmac")",
  "local_name": "$(json_esc "$lname")",
  "board_model": "$(json_esc "$bmodel")",
  "master_ip": "$(json_esc "$up_gw")",
  "master_model": "$(json_esc "$master_model")",
  "master_name": "$(json_esc "$master_name")",
  "has_internet": $has_dir,
  "wifi_hash": "$(json_esc "$wifi_hash")",
  "wifi": $wifi_js,
  "peer_count": ${pcnt:-0},
  "peers": $pjson
}
EOF
	mv -f "${CACHE_FILE}.tmp" "$CACHE_FILE" 2>/dev/null
	[ -L /www/mesh_topology.json ] || ln -sf "$CACHE_FILE" /www/mesh_topology.json 2>/dev/null || true
}

reconcile_once() {
	local my_epoch
	my_epoch=$(cat "$ACTION_EPOCH_FILE" 2>/dev/null || echo 0)
	get_mesh_cfg
	rm -f "$IDLE_FLAG_FILE"

	if [ "$CFG_ENABLED" = "0" ] || [ "$CFG_MODE" = "standalone" ]; then
		rm -f "$PAIR_UNTIL_FILE" "$HAD_PEER_FILE" "$SCAN_MISS_FILE" "$DIRECT_OK_STREAK_FILE" "$NUDGE_DONE_FILE" "$LOST_TS_FILE"
		if [ "$(uci -q get network.lan.ipaddr)" != "192.168.1.1" ] || [ -n "$(uci -q get network.mesh_uplink)" ] || [ -n "$(uci -q get wireless.mesh_sta)" ] || [ -n "$(uci -q get wireless.mesh_backhaul_ap)" ] || [ -n "$(uci -q get wireless.mesh_80211s)" ]; then
			is_epoch_current "$my_epoch" || return 0
			restore_default_standalone "disabled"
		fi
		is_epoch_current "$my_epoch" || return 0
		refresh_status_cache
		return 0
	fi

	local cur_role now_s lost_first elapsed up_gw mwhash misses streak uinfo ubssid
	cur_role=$(get_active_role)
	now_s=$(date +%s)

	# 1. Thiết bị CÓ MẠNG gốc (5G hoặc WAN dây) -> Always-Ready ROUTER CHÍNH (192.168.1.1)
	if check_direct_internet; then
		is_epoch_current "$my_epoch" || return 0
		if [ "$cur_role" = "node" ]; then
			streak=$(cat "$DIRECT_OK_STREAK_FILE" 2>/dev/null || echo 0)
			streak=$((streak + 1))
			echo "$streak" > "$DIRECT_OK_STREAK_FILE"
			if [ "$streak" -lt 2 ]; then
				refresh_status_cache
				return 0
			fi
		fi
		rm -f "$SCAN_MISS_FILE" "$NUDGE_DONE_FILE" "$LOST_TS_FILE"
		apply_controller_role
		if [ -f "$WIFI_HELPER" ] && command -v lua >/dev/null 2>&1; then
			lua "$WIFI_HELPER" publish >/dev/null 2>&1 || true
		fi
		is_epoch_current "$my_epoch" || return 0
		refresh_status_cache
		return 0
	fi

	rm -f "$DIRECT_OK_STREAK_FILE"

	# 2. Thiết bị KHÔNG CÓ MẠNG gốc -> Tự động làm ROUTER PHỤ (192.168.1.10, 11, 12...)
	if [ "$cur_role" = "node" ]; then
		up_gw=$(get_upstream_gateway)
		if ping -c 2 -W 1 "$up_gw" >/dev/null 2>&1; then
			is_epoch_current "$my_epoch" || return 0
			rm -f "$LOST_TS_FILE" "$NUDGE_DONE_FILE" "$PAIR_UNTIL_FILE" "$SCAN_MISS_FILE"
			verify_unique_node_ip
			ensure_node_relay_ap
			touch "$HAD_PEER_FILE"
			if [ -f "$WIFI_HELPER" ] && command -v lua >/dev/null 2>&1; then
				mwhash=$(jsonfilter -i /tmp/master_topo_cache.json -e '@.wifi_hash' 2>/dev/null)
				lua "$WIFI_HELPER" sync "$up_gw" "$mwhash" >/dev/null 2>&1
				[ "$?" -eq 2 ] && safe_wifi_reload 1
				lua "$WIFI_HELPER" publish >/dev/null 2>&1 || true
			fi
		else
			is_epoch_current "$my_epoch" || return 0
			[ -f "$LOST_TS_FILE" ] || echo "$now_s" > "$LOST_TS_FILE"
			lost_first=$(cat "$LOST_TS_FILE" 2>/dev/null || echo "$now_s")
			elapsed=$((now_s - lost_first))
			if [ "$elapsed" -ge 60 ]; then
				rm -f "$HAD_PEER_FILE" "$NUDGE_DONE_FILE" "$LOST_TS_FILE" "$SCAN_MISS_FILE"
				restore_default_standalone "auto"
				log_mesh "Mất kết nối Mesh quá 60s -> Khôi phục IP mặc định 192.168.1.1 và tiếp tục tự động dò ghép!"
			elif [ "$elapsed" -ge 20 ] && [ ! -f "$NUDGE_DONE_FILE" ]; then
				touch "$NUDGE_DONE_FILE"
				ifup mesh_uplink >/dev/null 2>&1 || true
				uinfo=$(get_local_uplink_info)
				ubssid=$(printf '%s' "$uinfo" | cut -d'|' -f1)
				[ -n "$ubssid" ] && probe_tier2_gateway >/dev/null 2>&1 || true
				log_mesh "Tạm gián đoạn Uplink (${elapsed}s) -> Thử làm mới kết nối mesh_uplink..."
			fi
		fi
		is_epoch_current "$my_epoch" || return 0
		refresh_status_cache
		return 0
	fi

	# Chưa ghép Mesh -> Luôn sẵn sàng dò sóng Router Chính (Always-Ready)
	if scan_for_master_mesh; then
		is_epoch_current "$my_epoch" || return 0
		log_mesh "Phát hiện sóng tối ưu ($FOUND_MESH_SSID tầng $FOUND_MESH_TIER kênh $FOUND_MESH_CHAN trên ${FOUND_MESH_RADIO:-auto} BSSID $FOUND_MESH_BSSID) -> Tự động ghép làm Router Phụ!"
		rm -f "$PAIR_UNTIL_FILE" "$SCAN_MISS_FILE" "$NUDGE_DONE_FILE" "$LOST_TS_FILE"
		apply_node_role "$FOUND_MESH_SSID" "$FOUND_MESH_CHAN" "$FOUND_MESH_BSSID" "$FOUND_MESH_RADIO" "$FOUND_MESH_TIER"
	else
		is_epoch_current "$my_epoch" || return 0
		misses=$(get_scan_misses)
		echo $((misses + 1)) > "$SCAN_MISS_FILE"
		if [ "$(uci -q get network.lan.ipaddr)" != "192.168.1.1" ] || [ -n "$(uci -q get network.mesh_uplink)" ] || [ "$(uci -q get dhcp.lan.ignore)" = "1" ] || [ -n "$(uci -q get wireless.mesh_backhaul_ap)" ]; then
			restore_default_standalone "auto"
		fi
	fi
	is_epoch_current "$my_epoch" || return 0
	refresh_status_cache
}

handle_pair_cmd() {
	ensure_mesh_uci
	uci set "${MESH_UCI}.mesh.enabled=1"
	uci set "${MESH_UCI}.mesh.mode=auto"
	uci commit "$MESH_UCI"
	rm -f "$IDLE_FLAG_FILE" "$SCAN_MISS_FILE" "$NUDGE_DONE_FILE" "$LOST_TS_FILE"
	start_pairing_window "$PAIR_WINDOW_SEC"
	write_instant_status_cache
	log_mesh "Bật Auto-Mesh Always-Ready -> Phát sóng công suất tối đa & tự động ghép nối!"
	reconcile_once
}

handle_unmesh_cmd() {
	rm -f "$IDLE_FLAG_FILE" "$PAIR_UNTIL_FILE" "$HAD_PEER_FILE" "$SCAN_MISS_FILE" "$DIRECT_OK_STREAK_FILE" "$NUDGE_DONE_FILE"
	restore_default_standalone "disabled"
	refresh_status_cache
}

handle_wifi_applied_cmd() {
	get_mesh_cfg
	local role up_gw
	role=$(get_active_role)
	safe_wifi_reload 1
	if [ "$role" = "node" ] && [ "$CFG_WIFI_SYNC_MODE" = "master" ]; then
		up_gw=$(get_upstream_gateway)
		if [ -f "$WIFI_HELPER" ] && command -v lua >/dev/null 2>&1; then
			lua "$WIFI_HELPER" sync "$up_gw" "" >/dev/null 2>&1
			[ "$?" -eq 2 ] && safe_wifi_reload 1
		fi
	elif [ "$role" = "controller" ]; then
		if [ -f "$WIFI_HELPER" ] && command -v lua >/dev/null 2>&1; then
			lua "$WIFI_HELPER" publish >/dev/null 2>&1 || true
		fi
	fi
	refresh_status_cache
}

run_daemon() {
	mkdir -p /var/lock
	exec 205>"$LOCK_FILE"
	flock -n 205 2>/dev/null || exit 0
	local up_s role misses
	up_s=$(awk '{print int($1)}' /proc/uptime 2>/dev/null || echo 99)
	if [ "${up_s:-99}" -lt 20 ]; then
		sleep $((20 - up_s))
	fi
	get_mesh_cfg
	if [ "$CFG_ENABLED" = "1" ]; then
		uci set "${MESH_UCI}.mesh.mode=auto"
		uci commit "$MESH_UCI"
		rm -f "$IDLE_FLAG_FILE" "$SCAN_MISS_FILE"
		log_mesh "Khởi động Auto-Mesh Always-Ready -> Tự động điều phối Chính/Phụ & công suất sóng tối đa!"
	fi
	while true; do
		run_locked reconcile_once >/dev/null 2>&1 || true
		get_mesh_cfg
		if [ "$CFG_ENABLED" = "0" ] || [ "$CFG_MODE" = "standalone" ]; then
			sleep 30
		else
			role=$(get_active_role)
			if [ "$role" = "searching_node" ]; then
				misses=$(get_scan_misses)
				if [ "$misses" -gt 20 ]; then
					sleep 45
				elif [ "$misses" -gt 10 ]; then
					sleep 20
				else
					sleep 10
				fi
			else
				sleep 12
			fi
		fi
	done
}

case "$1" in
	daemon|watchdog)
		run_daemon
		;;
	auto|pair|on|start|reconcile)
		bump_action_epoch
		run_locked handle_pair_cmd
		cat "$CACHE_FILE" 2>/dev/null || echo '{"success":true,"searching":true}'
		;;
	unmesh|off|stop|reset)
		bump_action_epoch
		run_locked handle_unmesh_cmd
		cat "$CACHE_FILE" 2>/dev/null
		;;
	wifi_applied)
		run_locked handle_wifi_applied_cmd >/dev/null 2>&1 || true
		;;
	status)
		if [ -s "$CACHE_FILE" ]; then
			now_t=$(date +%s)
			m_t=$(jsonfilter -i "$CACHE_FILE" -e '@.ts' 2>/dev/null || echo 0)
			cat "$CACHE_FILE"
			[ $((now_t - ${m_t:-0})) -gt 6 ] && ( /usr/bin/auto_mesh refresh_cache >/dev/null 2>&1 & )
		else
			refresh_status_cache
			cat "$CACHE_FILE" 2>/dev/null || echo '{"success":true,"enabled":false}'
		fi
		;;
	refresh_cache)
		refresh_status_cache
		;;
	*)
		refresh_status_cache
		cat "$CACHE_FILE" 2>/dev/null
		;;
esac
