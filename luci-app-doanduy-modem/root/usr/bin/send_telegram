#!/bin/sh
# [VERIFIED-GOLDEN: part4-send-telegram-posix-safe | 2026-11-26 | DO NOT MODIFY UNLESS TARGETED]
dec_num() {
    local n
    n=$(printf '%s' "$1" | tr -cd '0-9' | sed 's/^0*//')
    printf '%s' "${n:-0}"
}
read_kv() {
    [ -f "$1" ] || return 0
    local v
    v=$(awk -v k="$2" 'BEGIN{FS="="} {k0=$1; gsub(/^[ \t]+|[ \t]+$/,"",k0); if(k0==k){val=substr($0,index($0,"=")+1); gsub(/\r/,"",val)}} END{printf "%s", val}' "$1" 2>/dev/null)
    case "$v" in \"*\") v="${v#\"}"; v="${v%\"}" ;; \'*\') v="${v#\'}"; v="${v%\'}" ;; esac
    printf '%s' "$v"
}
BOT_TOKEN=""
ADMIN_CHAT_ID=""
TG_BOT_TOKEN=""
TG_ADMIN_ID=""
TG_AUTODEL=""
for _cf in /etc/config/router_secrets.conf /etc/config/personal_vault.conf /etc/config/telegram_bot.conf /etc/config/doanduy_vault; do
    if [ -f "$_cf" ]; then
        _v=$(read_kv "$_cf" TG_BOT_TOKEN); [ -n "$_v" ] && TG_BOT_TOKEN="$_v"
        _v=$(read_kv "$_cf" TG_ADMIN_ID); [ -n "$_v" ] && TG_ADMIN_ID="$_v"
        _v=$(read_kv "$_cf" TG_AUTODEL); [ -n "$_v" ] && TG_AUTODEL="$_v"
    fi
done
[ -n "$TG_BOT_TOKEN" ] && BOT_TOKEN="$TG_BOT_TOKEN"
[ -n "$TG_ADMIN_ID" ] && ADMIN_CHAT_ID="$TG_ADMIN_ID"
msg="$1"
markup="$2"
autodel="${3:-$TG_AUTODEL}"
[ -z "$msg" ] || [ -z "$ADMIN_CHAT_ID" ] || [ -z "$BOT_TOKEN" ] && exit 0

# 🌙 CHẾ ĐỘ YÊN TĨNH BAN ĐÊM (23:00 - 06:59): Không gửi báo cáo định kỳ làm phiền giấc ngủ
cur_hour=$(dec_num "$(date +%H 2>/dev/null || echo 12)")
if [ "$cur_hour" -ge 23 ] || [ "$cur_hour" -lt 7 ]; then
    if ! echo "$msg" | grep -qE '(CẢNH BÁO KHẨN|SOS|BÁO ĐỘNG|XÂM NHẬP|CHÁY NỔ|QUÁ NHIỆT|NGUY HIỂM)'; then
        exit 0
    fi
fi

# 🛡️ CHỐNG TRÙNG LẶP TIN NHẮN (DEDUPLICATION HASH FILTER):
text_hash=$(echo -n "$msg" | md5sum 2>/dev/null | awk '{print $1}')
if [ -n "$text_hash" ]; then
    hash_file="/tmp/tg_hash_${text_hash}"
    if [ -f "$hash_file" ]; then
        now_s=$(date +%s)
        file_s=$(date -r "$hash_file" +%s 2>/dev/null || stat -c %Y "$hash_file" 2>/dev/null || echo 0)
        if [ $((now_s - file_s)) -lt 1800 ]; then
            exit 0
        fi
    fi
    touch "$hash_file" 2>/dev/null
    find /tmp -maxdepth 1 -name "tg_hash_*" -mmin +60 -delete 2>/dev/null &
fi

check_rate_limit() {
    local now=$(date +%s)
    local ban_until=$(cat /tmp/tg_rate_limit_until.ts 2>/dev/null || echo 0)
    if [ "$now" -lt "$ban_until" ] 2>/dev/null; then
        return 1
    fi
    return 0
}

record_rate_limit() {
    local resp="$1"
    if echo "$resp" | grep -q '"error_code":429'; then
        local r_sec=$(echo "$resp" | jsonfilter -e '$.parameters.retry_after' 2>/dev/null || echo 15)
        [ -z "$r_sec" ] || [ "$r_sec" -lt 2 ] 2>/dev/null && r_sec=15
        local now=$(date +%s)
        local until=$((now + r_sec + 2))
        echo "$until" > /tmp/tg_rate_limit_until.ts
        return 1
    fi
    return 0
}

if ! check_rate_limit; then
    exit 0
fi

clean_msg=$(printf '%s' "$msg" | awk '{gsub(/\\n/,"\n"); printf "%s", $0}' | cut -c1-4000)
curl_tls="-k"
uf_tls="--no-check-certificate"
if [ -s /etc/ssl/certs/ca-certificates.crt ]; then
    curl_tls=""
    uf_tls=""
fi

url_encode_post() {
    local cid="$1" mode="$2" txt="$3" mk="$4"
    if command -v lua >/dev/null 2>&1; then
        lua - "$cid" "$mode" "$txt" "$mk" << 'LUAENC' 2>/dev/null
local cid, mode, txt, mk = arg[1] or "", arg[2] or "", arg[3] or "", arg[4] or ""
local function enc(s)
    return (tostring(s):gsub("([^%w%-_%.~])", function(c) return string.format("%%%02X", string.byte(c)) end))
end
local out = "chat_id=" .. enc(cid) .. "&text=" .. enc(txt)
if mode ~= "" then out = out .. "&parse_mode=" .. enc(mode) end
if mk ~= "" and mk:find("{", 1, true) then out = out .. "&reply_markup=" .. enc(mk) end
io.write(out)
LUAENC
        return 0
    fi
    printf 'chat_id=%s&text=%s' "$cid" "$(printf '%s' "$txt" | tr '\r\n' '  ' | sed 's/%/%25/g; s/&/%26/g; s/+/%2B/g; s/#/%23/g; s/=/%3D/g; s/ /%20/g')"
}

res=""
if command -v curl >/dev/null 2>&1 && ! curl --version 2>/dev/null | grep -qi 'uclient-fetch'; then
    set -- $curl_tls -s -m 8 -X POST -d "chat_id=${ADMIN_CHAT_ID}" -d "parse_mode=HTML" --data-urlencode "text=${clean_msg}"
    case "$markup" in
        *{*) set -- "$@" --data-urlencode "reply_markup=${markup}" ;;
    esac
    res=$(curl "$@" "https://api.telegram.org/bot${BOT_TOKEN}/sendMessage" 2>/dev/null)
elif command -v uclient-fetch >/dev/null 2>&1; then
    post_body=$(url_encode_post "$ADMIN_CHAT_ID" "HTML" "$clean_msg" "$markup")
    res=$(timeout 10 uclient-fetch -q -O - $uf_tls --timeout=8 --post-data="$post_body" "https://api.telegram.org/bot${BOT_TOKEN}/sendMessage" 2>/dev/null)
elif command -v wget >/dev/null 2>&1; then
    post_body=$(url_encode_post "$ADMIN_CHAT_ID" "HTML" "$clean_msg" "$markup")
    res=$(timeout 10 wget -q -O - $uf_tls -T 8 --post-data="$post_body" "https://api.telegram.org/bot${BOT_TOKEN}/sendMessage" 2>/dev/null)
fi
record_rate_limit "$res"

if ! echo "$res" | grep -q '"ok":true'; then
    check_rate_limit || exit 0
    plain_text=$(printf '%s' "$clean_msg" | sed 's/<[^>]*>/ /g' | tr -s ' ' | cut -c 1-4000)
    if command -v curl >/dev/null 2>&1 && ! curl --version 2>/dev/null | grep -qi 'uclient-fetch'; then
        set -- $curl_tls -s -m 8 -X POST -d "chat_id=${ADMIN_CHAT_ID}" --data-urlencode "text=${plain_text}"
        case "$markup" in
            *{*) set -- "$@" --data-urlencode "reply_markup=${markup}" ;;
        esac
        res=$(curl "$@" "https://api.telegram.org/bot${BOT_TOKEN}/sendMessage" 2>/dev/null)
    elif command -v uclient-fetch >/dev/null 2>&1; then
        post_body=$(url_encode_post "$ADMIN_CHAT_ID" "" "$plain_text" "$markup")
        res=$(timeout 10 uclient-fetch -q -O - $uf_tls --timeout=8 --post-data="$post_body" "https://api.telegram.org/bot${BOT_TOKEN}/sendMessage" 2>/dev/null)
    fi
    record_rate_limit "$res"
fi

msg_id=$(echo "$res" | jsonfilter -e '$.result.message_id' 2>/dev/null)
[ -z "$msg_id" ] && msg_id=$(echo "$res" | sed -n 's/.*"message_id":[ ]*\([0-9]*\).*/\1/p')

if [ -n "$autodel" ] && [ "$autodel" -gt 0 ] 2>/dev/null && [ -n "$msg_id" ]; then
    (
        sleep "$autodel"
        if [ -x /usr/bin/delete_telegram ]; then
            /usr/bin/delete_telegram "$msg_id" "$ADMIN_CHAT_ID" >/dev/null 2>&1
        elif command -v curl >/dev/null 2>&1; then
            curl $curl_tls -s -m 6 -d "chat_id=${ADMIN_CHAT_ID}&message_id=${msg_id}" "https://api.telegram.org/bot${BOT_TOKEN}/deleteMessage" >/dev/null 2>&1
        else
            uclient-fetch -q -O - $uf_tls --timeout=6 --post-data="chat_id=${ADMIN_CHAT_ID}&message_id=${msg_id}" "https://api.telegram.org/bot${BOT_TOKEN}/deleteMessage" >/dev/null 2>&1
        fi
    ) >/dev/null 2>&1 &
fi

echo "$res"
# [/VERIFIED-GOLDEN]
